:root {
  --bg: #070b14;
  --panel: #0e1524;
  --panel-2: #121b2e;
  --text: #f7f9ff;
  --muted: #a7b1c5;
  --line: rgba(255,255,255,.10);
  --accent: #7c5cff;
  --accent-2: #3aa7ff;
  --success: #43d19e;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:radial-gradient(circle at 15% 0%,rgba(124,92,255,.18),transparent 30%),radial-gradient(circle at 90% 20%,rgba(58,167,255,.12),transparent 28%),var(--bg);color:var(--text);font-family:Arial,Helvetica,sans-serif}
a{color:inherit;text-decoration:none}
button,input{font:inherit}
.container{width:min(1160px,calc(100% - 40px));margin:0 auto}
.nav{position:sticky;top:0;z-index:20;background:rgba(7,11,20,.78);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}
.nav-inner{height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{display:flex;align-items:center;gap:10px;font-weight:800;letter-spacing:-.03em;font-size:22px}
.brand-logo{width:42px;height:42px;object-fit:cover;border-radius:12px}
.hero-logo{width:128px;height:128px;object-fit:cover;border-radius:28px;margin:0 auto 20px;box-shadow:0 18px 50px rgba(220,45,225,.18)}
.orb{width:30px;height:30px;border-radius:50%;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 0 28px rgba(124,92,255,.45)}
.nav-links{display:flex;align-items:center;gap:24px;color:var(--muted);font-size:14px}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 18px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.04);color:var(--text);font-weight:700;cursor:pointer}
.btn-primary{border:0;background:linear-gradient(135deg,var(--accent),var(--accent-2));box-shadow:0 12px 28px rgba(58,167,255,.18)}
.hero{padding:112px 0 80px;text-align:center}
.eyebrow{display:inline-flex;padding:8px 12px;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.04);color:#d7dcff;font-size:13px;font-weight:700}
h1{font-size:clamp(48px,8vw,92px);line-height:.95;letter-spacing:-.06em;margin:26px auto 22px;max-width:980px}
h2{font-size:clamp(30px,4vw,48px);letter-spacing:-.04em;margin:0 0 18px}
.lead{font-size:20px;line-height:1.7;color:var(--muted);max-width:760px;margin:0 auto}
.hero-actions{display:flex;justify-content:center;gap:12px;margin-top:34px;flex-wrap:wrap}
.trust-strip{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:36px auto 0;max-width:920px}
.mini{padding:18px;border:1px solid var(--line);background:rgba(255,255,255,.03);border-radius:16px;text-align:left}
.mini strong{display:block;margin-bottom:5px}.mini span{font-size:13px;color:var(--muted)}
.section{padding:88px 0}.section-head{max-width:720px;margin-bottom:32px}.section-head p,.card p,.muted{color:var(--muted);line-height:1.7}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.grid-2{display:grid;grid-template-columns:repeat(2,1fr);gap:18px}
.card{padding:28px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.025));border-radius:22px}
.icon{width:42px;height:42px;border-radius:12px;display:grid;place-items:center;background:rgba(124,92,255,.14);margin-bottom:18px}
.card h3{font-size:20px;margin:0 0 10px}
.callout{padding:40px;border:1px solid rgba(124,92,255,.35);background:linear-gradient(135deg,rgba(124,92,255,.12),rgba(58,167,255,.06));border-radius:28px}
.flow{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.step{padding:20px;border-radius:18px;background:var(--panel);border:1px solid var(--line)}.step b{display:block;color:#c9c1ff;margin-bottom:8px}.step p{color:var(--muted);font-size:14px;line-height:1.5;margin:0}
.page-hero{padding:72px 0 38px}.page-hero h1{font-size:clamp(44px,6vw,72px);margin:14px 0 18px;max-width:850px;text-align:left}.page-hero .lead{margin:0;max-width:760px}
.form{max-width:620px;padding:30px;border:1px solid var(--line);background:var(--panel);border-radius:22px}.field{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}.field label{font-size:14px;font-weight:700}.field input{padding:14px 15px;border-radius:12px;border:1px solid var(--line);background:#0a1020;color:var(--text);outline:none}.field input:focus{border-color:rgba(124,92,255,.8)}
.notice{padding:14px 16px;border-radius:12px;background:rgba(67,209,158,.08);border:1px solid rgba(67,209,158,.25);color:#bff2de;font-size:14px}
.score{font-size:54px;font-weight:800;letter-spacing:-.05em}.meter{height:10px;border-radius:999px;background:rgba(255,255,255,.08);overflow:hidden}.meter span{display:block;height:100%;width:25%;background:linear-gradient(90deg,var(--accent),var(--accent-2))}.checklist{display:grid;gap:10px;margin-top:20px}.check{display:flex;justify-content:space-between;gap:10px;padding:13px 0;border-bottom:1px solid var(--line);color:var(--muted)}.ok{color:var(--success)}
.footer{border-top:1px solid var(--line);padding:30px 0 50px;color:var(--muted);font-size:13px}.footer-inner{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
@media (max-width:800px){.nav-links a:not(.btn){display:none}.grid-3,.grid-2,.trust-strip,.flow{grid-template-columns:1fr}.hero{padding-top:72px}.section{padding:64px 0}.container{width:min(100% - 28px,1160px)}}
.privacy-box{margin:24px 0;padding:18px;border-radius:16px;background:rgba(124,92,255,.08);border:1px solid rgba(124,92,255,.25)}
.privacy-box p{margin-bottom:0}.danger{margin-top:8px;border-color:rgba(255,110,110,.3)}
.form .notice{margin-top:16px}.btn:disabled{opacity:.6;cursor:not-allowed}

/* v0.2.1 Authenticity Centre polish */
.compact-hero{padding-bottom:24px}
.dashboard-section{padding-top:44px}
.dashboard-grid{align-items:start}
.score-card,.security-card{min-width:0}
.score-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.status-pill{display:inline-flex;align-items:center;min-height:32px;padding:7px 10px;border-radius:999px;border:1px solid rgba(124,92,255,.35);background:rgba(124,92,255,.10);color:#d8d2ff;font-size:12px;font-weight:800;letter-spacing:.03em;text-align:center}
.progress-meta{display:flex;justify-content:space-between;gap:16px;margin-top:10px;color:var(--muted);font-size:12px}
.next-step{display:grid;gap:5px;margin:22px 0 4px;padding:16px;border:1px solid rgba(58,167,255,.22);background:rgba(58,167,255,.06);border-radius:16px}
.next-step span:last-child{color:var(--muted);font-size:13px;line-height:1.5}
.next-label,.privacy-kicker{font-size:10px;letter-spacing:.12em;font-weight:800;color:#9fcfff}
.verification-list{display:grid;margin-top:18px}
.verification-item{border-bottom:1px solid var(--line)}
.verification-item summary{list-style:none;display:flex;align-items:center;justify-content:space-between;gap:18px;padding:15px 0;cursor:pointer;color:var(--muted)}
.verification-item summary::-webkit-details-marker{display:none}
.verification-name{display:flex;align-items:flex-start;gap:10px;min-width:0}
.verification-name strong{display:block;color:#dce4f6;font-weight:500}
.verification-name small{display:block;margin-top:4px;color:#7f8ba1;font-size:12px;line-height:1.45}
.verification-mark{flex:0 0 20px;color:#98a6bf;font-weight:800}
.verification-mark.done{color:var(--success)}
.verification-weight{white-space:nowrap;color:#c8d6ef;font-weight:800;font-size:13px}
.verification-item>p{margin:0 30px 12px;color:var(--muted);font-size:13px;line-height:1.6}
.coming-soon{display:inline-flex;margin:0 30px 14px;padding:5px 8px;border-radius:999px;border:1px solid var(--line);color:#9ca8bd;font-size:11px}
.card-title-row{display:flex;align-items:flex-start;justify-content:space-between;gap:16px}
.account-email{margin:4px 0 0!important}
.security-action{margin-top:24px;padding-top:22px;border-top:1px solid var(--line)}
.security-action:first-of-type{margin-top:18px}
.security-action p{margin:6px 0 14px;font-size:14px}
.action-copy{margin-bottom:12px}
.otp-panel{margin-top:16px;padding:16px;border-radius:16px;background:rgba(255,255,255,.025);border:1px solid var(--line)}
.otp-panel .field{margin-bottom:12px}
.status-message{margin-top:18px}
.privacy-kicker{display:block;margin-bottom:8px}
.privacy-note{font-size:13px;color:#8995ab!important}

@media (max-width:800px){
  .compact-hero{padding-top:44px;padding-bottom:14px}
  .compact-hero h1{font-size:46px;line-height:1;letter-spacing:-.055em}
  .compact-hero .lead{font-size:17px;line-height:1.55}
  .dashboard-section{padding-top:28px}
  .score-head{align-items:center}
  .score{font-size:48px}
  .status-pill{max-width:160px}
  .progress-meta{flex-direction:column;gap:4px}
  .verification-item summary{align-items:flex-start;gap:10px}
  .verification-name small{max-width:240px}
  .verification-item>p,.coming-soon{margin-left:30px;margin-right:0}
  .card{padding:22px 18px;border-radius:18px}
  .btn{width:100%}
  .nav-inner{height:62px}
  .brand-logo{width:36px;height:36px;border-radius:10px}
  .brand{font-size:19px}
}

@media (max-width:480px){
  .container{width:min(100% - 22px,1160px)}
  .compact-hero h1{font-size:40px}
  .score-head{display:block}
  .status-pill{margin-top:10px}
  .verification-name small{display:none}
  .verification-weight{font-size:12px}
  .verification-item>p{margin-left:30px}
}

/* v0.3 identity-verification boundary */
.verification-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.75fr);gap:18px;align-items:start}
.provider-card h2{font-size:34px;margin-top:6px}
.data-boundary{display:grid;grid-template-columns:1fr auto 1fr;gap:16px;align-items:center;margin:26px 0;padding:18px;border-radius:18px;background:rgba(255,255,255,.025);border:1px solid var(--line)}
.data-boundary>div:not(.boundary-arrow){display:grid;gap:8px}
.data-boundary b{margin-bottom:4px;color:#fff}
.data-boundary span{color:var(--muted);font-size:13px}
.boundary-arrow{font-size:30px;color:#9fcfff}
.verification-warning{margin:20px 0}
.no-store-list{display:grid;gap:10px;margin:18px 0 22px}
.no-store-list span{padding:11px 12px;border-radius:12px;background:rgba(255,110,110,.05);border:1px solid rgba(255,110,110,.14);color:#e7c5c5;font-size:13px}
.verification-sidecard .btn{margin-top:10px}
.demo-provider-shell{padding-top:70px}
.demo-provider{max-width:820px;margin:0 auto;text-align:center;padding:44px}
.demo-provider h1{font-size:clamp(44px,6vw,68px);margin:24px auto 18px}
.demo-badge{display:inline-flex;padding:8px 12px;border-radius:999px;background:rgba(255,184,77,.10);border:1px solid rgba(255,184,77,.28);color:#ffd49b;font-size:11px;font-weight:900;letter-spacing:.06em}
.demo-checks{display:grid;gap:10px;margin:30px 0;text-align:left}
.demo-checks>div{display:grid;grid-template-columns:34px 1fr auto;gap:12px;align-items:center;padding:15px;border-radius:14px;background:rgba(255,255,255,.025);border:1px solid var(--line)}
.demo-checks>div>span{width:30px;height:30px;display:grid;place-items:center;border-radius:50%;background:rgba(124,92,255,.14);font-weight:800;color:#d8d2ff}
.demo-checks b,.demo-checks small{display:block}
.demo-checks small{color:var(--muted);margin-top:3px}
.demo-checks strong{color:var(--success);font-size:12px}
@media(max-width:800px){.verification-layout{grid-template-columns:1fr}.data-boundary{grid-template-columns:1fr}.boundary-arrow{transform:rotate(90deg);justify-self:center}.demo-provider{padding:28px 20px}.demo-checks>div{grid-template-columns:34px 1fr}.demo-checks strong{grid-column:2}}

/* v0.4 profile foundation */
.profile-section{padding-top:38px}
.profile-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:20px;align-items:start}
.profile-form{padding:32px}
.profile-section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:22px}
.profile-section-head h2{font-size:34px;margin:6px 0 0}
.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 18px}
.field small{color:#7f8ba1;font-size:12px;line-height:1.45}
.field textarea,.field select{padding:14px 15px;border-radius:12px;border:1px solid var(--line);background:#0a1020;color:var(--text);outline:none;font:inherit}
.field textarea{resize:vertical;min-height:130px}
.field textarea:focus,.field select:focus{border-color:rgba(124,92,255,.8)}
.profile-divider{height:1px;background:var(--line);margin:20px 0 24px}
.privacy-copy{margin-top:-2px}
.privacy-controls{display:grid;gap:10px;margin:18px 0 22px}
.toggle-row{display:flex;gap:12px;align-items:flex-start;padding:14px;border-radius:14px;background:rgba(255,255,255,.025);border:1px solid var(--line);cursor:pointer}
.toggle-row input{margin-top:3px;width:17px;height:17px;accent-color:var(--accent)}
.toggle-row span{display:grid;gap:4px}.toggle-row b{font-size:14px}.toggle-row small{color:var(--muted);line-height:1.45}
.profile-actions{display:flex;justify-content:flex-end;margin-top:20px}
.profile-message{margin-top:18px}
.profile-side{display:grid;gap:18px}
.completeness-card p{font-size:13px}.side-note{padding-top:14px;border-top:1px solid var(--line);color:#8995ab!important}
.preview-card h3{font-size:28px;margin:8px 0 6px}.preview-card>p{margin:5px 0}.intent-chip{display:inline-flex;margin:12px 0 8px;padding:7px 10px;border-radius:999px;background:rgba(124,92,255,.12);border:1px solid rgba(124,92,255,.28);color:#d8d2ff;font-size:12px;font-weight:700}
.preview-about{white-space:pre-wrap}.private-banner{margin-top:18px;padding:12px;border-radius:12px;background:rgba(58,167,255,.07);border:1px solid rgba(58,167,255,.18);color:#b9dcff;font-size:12px;line-height:1.45}
.no-store-list.compact{margin-bottom:0}.no-store-list.compact span{padding:9px 10px}
@media(max-width:900px){.profile-layout{grid-template-columns:1fr}.profile-side{grid-template-columns:repeat(2,minmax(0,1fr))}.minimisation-card{grid-column:1/-1}}
@media(max-width:800px){.form-grid{grid-template-columns:1fr}.profile-form{padding:22px 18px}.profile-section-head{display:block}.profile-section-head .status-pill{margin-top:12px}.profile-side{grid-template-columns:1fr}.minimisation-card{grid-column:auto}.profile-actions .btn{width:100%}}

/* v0.5 Atlas relationship profile */
.relationship-section{padding-top:38px}
.relationship-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.62fr);gap:20px;align-items:start}
.relationship-form{padding:32px}
.relationship-questions{display:grid;margin-top:22px;border-top:1px solid var(--line)}
.relationship-question{display:grid;grid-template-columns:44px 1fr;gap:14px;padding:24px 0;border-bottom:1px solid var(--line)}
.question-number{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;background:rgba(124,92,255,.10);border:1px solid rgba(124,92,255,.22);color:#cfc8ff;font-size:11px;font-weight:900;letter-spacing:.06em}
.question-body h3{margin:0;font-size:18px;line-height:1.35}
.question-body p{margin:6px 0 18px;color:var(--muted);font-size:13px;line-height:1.5}
.scale-input{width:100%;accent-color:var(--accent);cursor:pointer}
.scale-meta{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:10px;margin-top:7px;color:#76849b;font-size:11px}
.scale-meta strong{padding:5px 8px;border-radius:999px;background:rgba(58,167,255,.08);border:1px solid rgba(58,167,255,.18);color:#b9dcff;font-size:11px;text-align:center}
.scale-meta span:last-child{text-align:right}
.consent-card{display:flex;gap:12px;align-items:flex-start;margin-top:22px;padding:16px;border-radius:15px;background:rgba(67,209,158,.05);border:1px solid rgba(67,209,158,.18);cursor:pointer}
.consent-card input{margin-top:3px;width:18px;height:18px;accent-color:var(--accent)}
.consent-card span{display:grid;gap:5px}.consent-card b{font-size:14px}.consent-card small{color:var(--muted);line-height:1.5}
.relationship-side{display:grid;gap:18px;position:sticky;top:84px}
.atlas-card{background:linear-gradient(160deg,rgba(124,92,255,.08),rgba(58,167,255,.035))}
.atlas-card h3{font-size:28px;margin:8px 0 12px}.atlas-card>p{line-height:1.65}
.atlas-focus{display:grid;gap:8px;margin:20px 0;padding-top:18px;border-top:1px solid var(--line)}
.atlas-focus small{color:#8f9bb0;margin-bottom:2px}.atlas-focus span{display:inline-flex;width:max-content;max-width:100%;padding:7px 9px;border-radius:999px;background:rgba(124,92,255,.10);border:1px solid rgba(124,92,255,.22);color:#d8d2ff;font-size:12px}
.atlas-disclaimer{padding-top:16px;border-top:1px solid var(--line);color:#8592a8!important;font-size:12px;line-height:1.55!important}
@media(max-width:900px){.relationship-layout{grid-template-columns:1fr}.relationship-side{position:static;grid-template-columns:repeat(2,minmax(0,1fr))}.atlas-card{grid-column:1/-1}}
@media(max-width:800px){.relationship-form{padding:22px 18px}.relationship-side{grid-template-columns:1fr}.relationship-question{grid-template-columns:1fr}.scale-meta{grid-template-columns:1fr auto 1fr}}
@media(max-width:480px){.scale-meta{grid-template-columns:1fr 1fr}.scale-meta strong{grid-column:1/-1;grid-row:1}.scale-meta span:last-child{text-align:right}}

/* v0.6 explainable Compatibility Lab */
.compatibility-section{padding-top:38px}
.compatibility-layout{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(300px,.65fr);gap:20px;align-items:start}
.compatibility-main,.compatibility-side{display:grid;gap:18px}
.compatibility-side{position:sticky;top:84px}
.compatibility-title-row{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.compatibility-title-row h2,.dimension-card h2{font-size:32px;margin:7px 0 8px}.compatibility-title-row p{margin:0;max-width:680px}
.candidate-tabs{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-top:22px}
.candidate-tab{display:grid;gap:4px;text-align:left;padding:14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.025);color:var(--text);cursor:pointer}
.candidate-tab b{font-size:14px}.candidate-tab span{font-size:11px;color:var(--muted)}
.candidate-tab.active{border-color:rgba(124,92,255,.55);background:linear-gradient(135deg,rgba(124,92,255,.13),rgba(58,167,255,.07));box-shadow:0 10px 28px rgba(58,167,255,.07)}
.compatibility-score-card{background:linear-gradient(145deg,rgba(124,92,255,.09),rgba(58,167,255,.035))}
.match-score-head{display:flex;align-items:flex-start;justify-content:space-between;gap:22px}.match-level{display:grid;text-align:right;gap:3px;margin-top:12px}.match-level span{font-size:20px;font-weight:800;color:#d8d2ff}.match-level small{color:var(--muted)}
.compatibility-summary{font-size:16px;line-height:1.65!important;margin:20px 0 0!important}.candidate-note{margin-top:18px;padding:10px 12px;border-radius:11px;border:1px solid rgba(255,184,77,.18);background:rgba(255,184,77,.06);color:#e8ca9d;font-size:11px}
.dimension-list{display:grid;margin-top:20px;border-top:1px solid var(--line)}
.dimension-row{display:grid;grid-template-columns:1fr 58px;gap:18px;padding:18px 0;border-bottom:1px solid var(--line);align-items:center}
.dimension-heading{display:flex;gap:12px;justify-content:space-between;align-items:center}.dimension-heading span{font-size:10px;color:#7f8ba1;white-space:nowrap}.dimension-values{display:flex;gap:8px;flex-wrap:wrap;margin:7px 0}.dimension-values span{padding:5px 7px;border-radius:8px;background:rgba(255,255,255,.035);color:#aeb9cc;font-size:11px}.dimension-copy small{color:#7f8ba1;line-height:1.45}
.dimension-score{width:52px;height:52px;display:grid;place-items:center;border-radius:50%;border:1px solid var(--line);background:rgba(255,255,255,.035);font-weight:900;color:#cbd6e9}.dimension-score.good{color:#8ce4c0;border-color:rgba(67,209,158,.28);background:rgba(67,209,158,.07)}.dimension-score.attention{color:#ffd49b;border-color:rgba(255,184,77,.25);background:rgba(255,184,77,.06)}
.insight-stack{display:grid;gap:10px;margin-top:18px}.insight-stack>div{display:grid;gap:4px;padding:12px;border:1px solid var(--line);background:rgba(255,255,255,.025);border-radius:12px}.insight-stack b{font-size:13px}.insight-stack span{font-size:11px;color:var(--muted);line-height:1.45}.conversation-stack>div{border-color:rgba(255,184,77,.14)}
.methodology-card p{font-size:13px;margin-bottom:10px}.compatibility-blocked{max-width:760px}.compatibility-blocked h2{margin-top:7px}
@media(max-width:960px){.compatibility-layout{grid-template-columns:1fr}.compatibility-side{position:static;grid-template-columns:repeat(2,minmax(0,1fr))}.methodology-card{grid-column:1/-1}}
@media(max-width:800px){.candidate-tabs{grid-template-columns:1fr}.compatibility-title-row{display:block}.compatibility-title-row .status-pill{margin-top:12px}.compatibility-side{grid-template-columns:1fr}.methodology-card{grid-column:auto}.dimension-row{grid-template-columns:1fr 48px}.dimension-score{width:44px;height:44px}.match-score-head{display:block}.match-level{text-align:left;margin:0 0 14px}.dimension-heading{align-items:flex-start}}

/* v0.7 controlled discovery + mutual introductions */
.discovery-section{padding-top:38px}.discovery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.discovery-card{display:flex;flex-direction:column;gap:18px}.candidate-identity{display:flex;align-items:center;gap:14px}.profile-placeholder{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;background:linear-gradient(135deg,rgba(124,92,255,.28),rgba(58,167,255,.18));border:1px solid rgba(124,92,255,.3);font-size:24px;font-weight:900}.candidate-identity h2,.discovery-card>h2{font-size:30px;margin:0}.candidate-identity p{margin:4px 0 0;color:var(--muted);font-size:13px}.trust-pair{display:grid;grid-template-columns:1fr 1fr;gap:10px}.trust-pair span{display:grid;gap:3px;padding:14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.025)}.trust-pair b{font-size:24px}.trust-pair small{color:var(--muted)}.candidate-badges{display:flex;gap:7px;flex-wrap:wrap}.candidate-badges span{padding:6px 8px;border-radius:999px;border:1px solid rgba(124,92,255,.25);background:rgba(124,92,255,.08);font-size:10px;color:#d8d2ff}.candidate-about{color:#c6d0e2!important;line-height:1.6!important;margin:0!important}.discovery-insights{display:grid;gap:10px}.discovery-insights>div{padding:12px;border-radius:12px;background:rgba(255,255,255,.025);border:1px solid var(--line)}.discovery-insights small{color:#8ea0bb;font-size:9px;letter-spacing:.1em;font-weight:800}.discovery-insights p{margin:5px 0 0!important;font-size:12px!important;line-height:1.45!important}.discovery-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:auto}.discovery-empty{max-width:780px}.left-actions{justify-content:flex-start}.discovery-message{margin-top:18px}.discovery-privacy{margin-top:20px;max-width:860px}.discovery-privacy h3{font-size:24px}.discovery-privacy .btn{margin-top:8px}@media(max-width:900px){.discovery-grid{grid-template-columns:1fr}}@media(max-width:800px){.discovery-actions{grid-template-columns:1fr}.trust-pair{grid-template-columns:1fr 1fr}}

/* v0.7.1 development test-profile marker */
.test-profile-pill {
  border-style: dashed;
  letter-spacing: .08em;
}
.intro-pills {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
  align-items: center;
}

/* v0.7.2 signed-in user indicator */
.account-menu{position:relative;margin-left:-4px}
.account-menu>summary{list-style:none}.account-menu>summary::-webkit-details-marker{display:none}
.account-chip{display:flex;align-items:center;gap:9px;min-height:46px;padding:6px 10px 6px 7px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.035);color:var(--text);cursor:pointer;user-select:none;transition:border-color .18s ease,background .18s ease}
.account-chip:hover,.account-menu[open] .account-chip{border-color:rgba(124,92,255,.48);background:rgba(124,92,255,.08)}
.account-avatar{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--accent-2));color:#fff;font-size:13px;font-weight:900;box-shadow:0 8px 18px rgba(58,167,255,.16)}
.account-chip-copy{display:grid;gap:1px;line-height:1.05;min-width:0}.account-chip-copy b{font-size:12px;max-width:92px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.account-chip-copy small{font-size:8px;letter-spacing:.08em;color:#92a1ba;font-weight:800;white-space:nowrap}
.account-test-badge{padding:3px 5px;border-radius:999px;background:rgba(255,184,77,.12);border:1px solid rgba(255,184,77,.28);color:#ffd49b;font-size:8px;font-weight:900;letter-spacing:.08em}
.account-chevron{font-size:14px;color:#8090aa;transform:translateY(-1px)}.account-menu[open] .account-chevron{transform:rotate(180deg) translateY(1px)}
.account-dropdown{position:absolute;right:0;top:calc(100% + 12px);width:286px;padding:18px;border-radius:18px;border:1px solid var(--line);background:#0d1422;box-shadow:0 24px 70px rgba(0,0,0,.42);display:grid;gap:7px;z-index:40}
.account-dropdown:before{content:"";position:absolute;right:25px;top:-6px;width:11px;height:11px;background:#0d1422;border-left:1px solid var(--line);border-top:1px solid var(--line);transform:rotate(45deg)}
.account-dropdown-kicker{font-size:9px;letter-spacing:.12em;color:#6fbfff;font-weight:900}.account-dropdown>strong{font-size:19px}.account-email{font-size:12px;color:#9cabc1;overflow-wrap:anywhere}.account-demo-badge{justify-self:start;margin-top:4px;padding:5px 8px}
.account-trust-row{display:flex;align-items:center;justify-content:space-between;margin:8px 0 2px;padding:12px 13px;border-radius:12px;background:rgba(255,255,255,.03);border:1px solid var(--line);font-size:12px;color:#aab7ca}.account-trust-row b{font-size:17px;color:#fff}
.account-dropdown-links{display:grid;border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:7px 0;margin-top:3px}.account-dropdown-links a{padding:9px 7px;border-radius:9px;color:#d7dfeb;font-size:12px}.account-dropdown-links a:hover{background:rgba(124,92,255,.09);color:#fff}
.account-signout{appearance:none;border:0;background:transparent;color:#ffaaa8;text-align:left;padding:9px 7px;border-radius:9px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}.account-signout:hover{background:rgba(255,108,105,.08)}
@media(max-width:1100px){.nav-links{gap:14px}.account-chip-copy small{display:none}}
@media(max-width:800px){.nav-links>.account-menu{display:block}.account-chip{min-height:40px;padding:4px 7px}.account-avatar{width:30px;height:30px}.account-chip-copy{display:none}.account-test-badge{display:none}.account-dropdown{position:fixed;right:14px;top:68px;width:min(300px,calc(100vw - 28px))}.account-dropdown:before{display:none}}

@media(max-width:800px){.account-dropdown a{display:block!important}}

/* v0.8 Safe Messaging */
.message-section{padding-top:34px}.message-hero-row{display:flex;justify-content:space-between;align-items:flex-end;gap:28px}.message-hero-row>div:first-child{max-width:800px}.message-trust{display:flex;gap:10px;align-items:center;flex-wrap:wrap;justify-content:flex-end}.message-trust>span:not(.status-pill){display:grid;min-width:112px;padding:12px 14px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.03)}.message-trust b{font-size:22px}.message-trust small{font-size:10px;color:var(--muted)}
.message-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(290px,.55fr);gap:20px;align-items:start}.chat-card{padding:0;overflow:hidden}.chat-safety-note{padding:13px 18px;border-bottom:1px solid var(--line);background:rgba(58,167,255,.05);color:#a9c7e8;font-size:12px;line-height:1.5}.message-list{height:min(58vh,620px);min-height:360px;overflow:auto;padding:24px;display:flex;flex-direction:column;gap:11px}.message-empty{margin:auto;text-align:center;max-width:360px}.message-empty h2{margin-bottom:8px}.message-empty p{color:var(--muted)}.message-bubble{max-width:min(78%,620px);padding:12px 14px;border-radius:16px;border:1px solid var(--line)}.message-bubble p{margin:0;color:#e6edf8;white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.5}.message-bubble small{display:block;margin-top:6px;font-size:9px;color:#75849c}.message-bubble.mine{align-self:flex-end;background:linear-gradient(135deg,rgba(124,92,255,.18),rgba(58,167,255,.09));border-bottom-right-radius:5px}.message-bubble.theirs{align-self:flex-start;background:rgba(255,255,255,.035);border-bottom-left-radius:5px}.message-composer{padding:16px 18px;border-top:1px solid var(--line);background:rgba(255,255,255,.018)}.message-composer textarea,.report-panel textarea,.report-panel select{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:#0a1020;color:var(--text);font:inherit;resize:vertical;outline:none}.message-composer textarea:focus,.report-panel textarea:focus,.report-panel select:focus{border-color:rgba(124,92,255,.7)}.composer-footer{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-top:10px}.composer-footer small{color:var(--muted)}.message-side{display:grid;gap:18px;position:sticky;top:84px}.message-side h2{font-size:28px;margin:6px 0 10px}.safety-actions{display:grid;gap:9px;margin-top:18px}.danger-button{border-color:rgba(255,108,105,.28)!important;color:#ffb6b4!important}.report-panel{display:grid;gap:12px;margin-top:16px;padding-top:16px;border-top:1px solid var(--line)}.report-panel label{display:grid;gap:7px;font-size:12px;font-weight:700}.messaging-error{margin:16px}.message-side p{font-size:13px;line-height:1.6}.discovery-card>.btn{margin-top:auto}
@media(max-width:900px){.message-layout{grid-template-columns:1fr}.message-side{position:static}.message-hero-row{display:block}.message-trust{justify-content:flex-start;margin-top:18px}.message-list{height:52vh}}
@media(max-width:600px){.message-bubble{max-width:90%}.message-list{padding:18px 14px}.composer-footer{align-items:flex-end}.composer-footer .btn{width:auto}.message-trust>span:not(.status-pill){min-width:100px}}


/* AutoFace v0.8.1 — clearer sender identity in safe messaging */
.message-date-divider {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0;
  color: var(--muted, #6b7280);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
}
.message-date-divider::before,
.message-date-divider::after {
  content: "";
  flex: 1;
  height: 1px;
  background: rgba(148, 163, 184, .28);
}
.message-date-divider span { white-space: nowrap; }

.message-row {
  display: flex;
  align-items: flex-end;
  gap: 9px;
  margin: 10px 0;
}
.message-row.mine { justify-content: flex-end; }
.message-row.theirs { justify-content: flex-start; }

.message-avatar {
  width: 30px;
  height: 30px;
  flex: 0 0 30px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-size: .76rem;
  font-weight: 800;
  border: 1px solid rgba(148, 163, 184, .35);
  background: rgba(148, 163, 184, .12);
}
.mine-avatar {
  background: rgba(99, 102, 241, .16);
  border-color: rgba(99, 102, 241, .32);
}

.message-row .message-bubble {
  margin: 0;
  max-width: min(76%, 680px);
}
.message-row.mine .message-bubble {
  border-bottom-right-radius: 6px;
  background: rgba(99, 102, 241, .14);
  border-color: rgba(99, 102, 241, .30);
}
.message-row.theirs .message-bubble {
  border-bottom-left-radius: 6px;
  background: rgba(148, 163, 184, .09);
}
.message-sender {
  margin-bottom: 4px;
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .02em;
}
.message-row.mine .message-sender { text-align: right; }
.message-row.mine .message-bubble small {
  display: block;
  text-align: right;
}
.message-row.theirs .message-bubble small {
  display: block;
  text-align: left;
}
@media (max-width: 640px) {
  .message-row .message-bubble { max-width: 82%; }
  .message-avatar { width: 26px; height: 26px; flex-basis: 26px; }
}


/* AutoFace v0.9.1 — simplified application navigation */
.desktop-nav{gap:12px}
.desktop-nav>a,.nav-group>summary{white-space:nowrap}
.nav-priority-link{padding:10px 11px;border-radius:10px;color:#d9e2f0!important;font-weight:700}
.nav-priority-link:hover{background:rgba(124,92,255,.08);color:#fff!important}
.compact-nav-cta{padding:10px 14px!important}

.nav-group{position:relative}
.nav-group>summary{list-style:none;display:flex;align-items:center;gap:6px;padding:10px 11px;border-radius:10px;cursor:pointer;color:#aab6c8;font-weight:650;user-select:none}
.nav-group>summary::-webkit-details-marker{display:none}
.nav-group>summary:hover,.nav-group[open]>summary{background:rgba(255,255,255,.035);color:#fff}
.nav-group>summary span{font-size:12px;color:#71819a;transition:transform .15s ease}
.nav-group[open]>summary span{transform:rotate(180deg)}
.nav-group-menu{position:absolute;top:calc(100% + 10px);right:0;width:310px;padding:10px;border-radius:17px;border:1px solid var(--line);background:#0d1422;box-shadow:0 24px 70px rgba(0,0,0,.42);display:grid;z-index:38}
.nav-group-menu:before{content:"";position:absolute;right:24px;top:-6px;width:11px;height:11px;background:#0d1422;border-left:1px solid var(--line);border-top:1px solid var(--line);transform:rotate(45deg)}
.nav-group-menu a{display:grid!important;gap:3px;padding:11px 12px;border-radius:11px;color:#dbe4f0}
.nav-group-menu a:hover{background:rgba(124,92,255,.09)}
.nav-group-menu b{font-size:12px}.nav-group-menu small{font-size:10px;color:#7f8da3;line-height:1.35}
.trust-menu{width:265px}

.mobile-nav-controls{display:none;align-items:center;gap:8px}
.mobile-nav-controls>.account-menu{display:none}
.mobile-menu-button{width:42px;height:42px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.035);display:grid;place-content:center;gap:4px;cursor:pointer}
.mobile-menu-button span{display:block;width:18px;height:2px;border-radius:2px;background:#d8e1ee;transition:transform .18s ease,opacity .18s ease}
.mobile-menu-button.open span:nth-child(1){transform:translateY(6px) rotate(45deg)}
.mobile-menu-button.open span:nth-child(2){opacity:0}
.mobile-menu-button.open span:nth-child(3){transform:translateY(-6px) rotate(-45deg)}

.mobile-nav-panel{display:none}
.mobile-nav-content{display:grid;gap:22px;padding-top:18px;padding-bottom:26px}
.mobile-nav-section{display:grid;gap:5px}
.mobile-nav-label{font-size:9px;letter-spacing:.14em;font-weight:900;color:#6fbfff;margin-bottom:5px}
.mobile-nav-section>a{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:12px 4px;border-bottom:1px solid rgba(139,153,177,.12);font-size:14px;font-weight:700;color:#e1e8f2}
.mobile-nav-section>a span{font-size:10px;color:#7e8da4;font-weight:500;text-align:right}
.mobile-nav-signout{border:1px solid rgba(255,108,105,.2);background:rgba(255,108,105,.05);color:#ffb1af;padding:12px;border-radius:12px;font:inherit;font-weight:700;text-align:left}

@media(max-width:1050px){
  .desktop-nav{gap:6px}
  .nav-priority-link,.nav-group>summary{padding-left:8px;padding-right:8px}
  .account-chip-copy small{display:none}
}

@media(max-width:850px){
  .desktop-nav{display:none!important}
  .mobile-nav-controls{display:flex}
  .mobile-nav-controls>.account-menu{display:block}
  .mobile-nav-controls .account-chip-copy{display:none}
  .mobile-nav-controls .account-test-badge{display:none}
  .mobile-nav-controls .account-chip{min-height:42px;padding:4px 7px}
  .mobile-nav-controls .account-avatar{width:31px;height:31px}
  .mobile-nav-panel{display:block;max-height:0;overflow:hidden;opacity:0;border-top:1px solid transparent;background:rgba(7,11,20,.98);transition:max-height .25s ease,opacity .2s ease,border-color .2s ease}
  .mobile-nav-panel.open{max-height:calc(100vh - 62px);overflow:auto;opacity:1;border-top-color:var(--line)}
  .mobile-nav-open{overflow:hidden}
  .nav-inner{height:62px}
  .brand-logo{width:36px;height:36px;border-radius:10px}
  .brand{font-size:19px}
}

@media(max-width:480px){
  .mobile-nav-controls{gap:6px}
  .mobile-nav-controls .account-chevron{display:none}
  .mobile-nav-section>a span{display:none}
}


/* AutoFace v0.9.2 — optional Atlas AI explanation layer */
.atlas-ai-card,.atlas-ai-compat-card{background:linear-gradient(150deg,rgba(58,167,255,.065),rgba(124,92,255,.055))}
.atlas-ai-title{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}
.atlas-ai-title h3{margin:6px 0 10px}
.ai-off-pill{color:#9aa7ba!important;border-color:rgba(148,163,184,.2)!important;background:rgba(148,163,184,.05)!important}
.ai-consent-row{margin:18px 0;padding:14px;border:1px solid rgba(58,167,255,.18);background:rgba(58,167,255,.045);border-radius:13px}
.ai-consent-row span{display:grid;gap:4px}
.ai-consent-row b{font-size:12px}.ai-consent-row small{font-size:10px;line-height:1.5;color:#8494aa}
.atlas-ai-output{margin-top:16px;padding:16px;border-radius:14px;border:1px solid rgba(124,92,255,.22);background:rgba(124,92,255,.065)}
.atlas-ai-output p{white-space:pre-wrap;margin:8px 0 0!important;color:#d9e2ef!important;line-height:1.65!important}
.ai-disabled-note{display:grid;gap:5px;margin-top:15px;padding:13px;border-radius:12px;background:rgba(148,163,184,.055);border:1px solid rgba(148,163,184,.15)}
.ai-disabled-note b{font-size:12px}.ai-disabled-note span{font-size:11px;line-height:1.5;color:#8998ad}
.atlas-ai-compat-card{grid-column:1/-1}
.atlas-ai-compat-card .btn{margin-top:2px}
@media(max-width:600px){.atlas-ai-title{display:block}.atlas-ai-title .status-pill{margin:2px 0 10px}}


/* AutoFace v0.9.2.1 — Atlas AI consent layout polish */
.atlas-ai-card{
  min-width:0;
}
.atlas-ai-card .atlas-ai-title{
  align-items:center;
}
.ai-consent-row{
  display:flex!important;
  align-items:flex-start!important;
  gap:12px!important;
  width:100%;
  padding:14px 15px!important;
  margin:16px 0 14px!important;
  box-sizing:border-box;
}
.ai-consent-row>input[type="checkbox"]{
  width:18px!important;
  height:18px!important;
  min-width:18px!important;
  flex:0 0 18px!important;
  margin:2px 0 0!important;
  padding:0!important;
  accent-color:#7c5cff;
}
.ai-consent-row>span{
  min-width:0;
  flex:1 1 auto;
  display:grid!important;
  gap:4px!important;
}
.ai-consent-row b{
  display:block;
  font-size:12px!important;
  line-height:1.35;
}
.ai-consent-row small{
  display:block;
  font-size:10px!important;
  line-height:1.5!important;
  color:#8998ad!important;
  overflow-wrap:anywhere;
}
.atlas-ai-card>.btn,
.atlas-ai-compat-card>.btn{
  width:auto!important;
  min-width:190px;
  margin-top:0!important;
}
.atlas-ai-output{
  overflow:hidden;
}
.atlas-ai-output p{
  overflow-wrap:anywhere;
}
@media(max-width:600px){
  .atlas-ai-card .atlas-ai-title{
    align-items:flex-start;
  }
  .atlas-ai-card>.btn,
  .atlas-ai-compat-card>.btn{
    width:100%!important;
    min-width:0;
  }
}

/* AutoFace v0.10 — Connection Journey */
.connection-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,.75fr);gap:20px;align-items:start}
.connection-main,.connection-side{display:grid;gap:20px}
.connection-summary{display:flex;align-items:center;justify-content:space-between;gap:22px}
.connection-summary h2{margin:6px 0}.connection-summary p{margin:0}
.connection-scores{display:flex;gap:10px;flex-wrap:wrap}
.connection-scores span{min-width:108px;padding:13px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.025);display:grid;gap:2px;text-align:center}
.connection-scores b{font-size:24px}.connection-scores small{font-size:9px;color:#8493a8;text-transform:uppercase;letter-spacing:.08em}
.connection-reasons{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:18px}
.connection-reasons>div{padding:16px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.02)}
.connection-reasons h3{margin:0 0 11px}.connection-reasons p{margin:7px 0;font-size:12px}
.starter-card blockquote{margin:16px 0 20px;padding:18px;border-left:3px solid #7c5cff;background:rgba(124,92,255,.06);border-radius:0 13px 13px 0;font-size:16px;line-height:1.6;color:#dce5f2}
.journey-list{display:grid;gap:7px;margin:18px 0}
.journey-step{width:100%;display:flex;align-items:center;gap:11px;padding:11px;border:1px solid transparent;border-radius:12px;background:transparent;color:#a8b5c8;text-align:left;cursor:pointer}
.journey-step:hover{background:rgba(255,255,255,.03)}
.journey-step>span{display:grid;place-items:center;width:27px;height:27px;border-radius:50%;border:1px solid #354156;font-size:10px;font-weight:900;flex:0 0 auto}
.journey-step>b{display:grid;font-size:12px;color:#cbd5e3}.journey-step small{font-size:9px;color:#728198;font-weight:500;margin-top:2px}
.journey-step.active{border-color:rgba(124,92,255,.35);background:rgba(124,92,255,.08)}.journey-step.active>span{background:#7c5cff;color:white;border-color:#7c5cff}
.journey-step.complete>span{border-color:rgba(44,218,151,.4);color:#2cda97}
.journey-privacy{padding:12px;border-radius:11px;background:rgba(58,167,255,.05);font-size:10px;line-height:1.5;color:#8494aa}
.safety-compact .btn{margin-top:8px}.message-back-link{display:block;width:max-content;margin-bottom:10px;font-size:11px;color:#8fc8ff}
@media(max-width:900px){.connection-layout{grid-template-columns:1fr}.connection-side{grid-row:auto}.connection-summary{align-items:flex-start}.connection-reasons{grid-template-columns:1fr}}
@media(max-width:560px){.connection-summary{display:grid}.connection-scores{width:100%}.connection-scores span{flex:1}.starter-card blockquote{font-size:14px}}


/* AutoFace v0.10.1 — visual refresh */
:root{
  --bg:#080d18;
  --panel:#101827;
  --panel-2:#151f31;
  --text:#f5f3f0;
  --muted:#97a4b8;
  --line:rgba(226,232,240,.11);
  --accent:#7c5cff;
  --accent-2:#55afff;
  --relationship:#ff7163;
  --relationship-2:#ff9b69;
  --success:#35d39a;
  --danger:#ff6966;
}
body{
  background:
    radial-gradient(circle at 12% 0%,rgba(124,92,255,.17),transparent 30%),
    radial-gradient(circle at 88% 12%,rgba(255,113,99,.10),transparent 25%),
    radial-gradient(circle at 70% 85%,rgba(85,175,255,.06),transparent 28%),
    var(--bg);
}
.nav{background:rgba(8,13,24,.84)}
.card{
  background:linear-gradient(180deg,rgba(255,255,255,.042),rgba(255,255,255,.022));
  box-shadow:0 14px 38px rgba(0,0,0,.10);
}
.btn{transition:transform .16s ease,border-color .16s ease,background .16s ease,box-shadow .16s ease}
.btn:hover:not(:disabled){transform:translateY(-1px)}
.btn-primary{background:linear-gradient(135deg,var(--accent),var(--accent-2))}
.btn-relationship{
  border:0;
  background:linear-gradient(135deg,var(--relationship),var(--relationship-2));
  color:#fff;
  box-shadow:0 12px 28px rgba(255,113,99,.18);
}
.btn-relationship:hover:not(:disabled){box-shadow:0 15px 34px rgba(255,113,99,.24)}
.privacy-kicker{color:#88c9ff}
.status-pill{background:rgba(124,92,255,.09)}
.verification-mark.done,.ok{color:var(--success)!important}

.profile-placeholder{
  background:linear-gradient(135deg,rgba(124,92,255,.28),rgba(85,175,255,.18));
}
.warm-avatar{
  background:linear-gradient(135deg,rgba(255,113,99,.34),rgba(124,92,255,.24));
  border-color:rgba(255,113,99,.32);
}
.introduction-identity{padding-top:2px}
.introduction-identity h2{margin:0}
.introduction-identity p{margin:5px 0 0}

.discovery-card{
  border-color:rgba(226,232,240,.09);
}
.discovery-card:hover{
  border-color:rgba(255,113,99,.22);
  box-shadow:0 18px 46px rgba(0,0,0,.16);
}
.trust-pair span:first-child{
  border-color:rgba(53,211,154,.18);
  background:rgba(53,211,154,.045);
}
.trust-pair span:first-child b{color:#8ce4c0}
.trust-pair span:last-child{
  border-color:rgba(255,113,99,.18);
  background:rgba(255,113,99,.045);
}
.trust-pair span:last-child b{color:#ffc0b9}

.connection-hero-card{
  position:relative;
  overflow:hidden;
  border-color:rgba(255,113,99,.22);
  background:
    radial-gradient(circle at 15% 20%,rgba(255,113,99,.12),transparent 30%),
    linear-gradient(135deg,rgba(124,92,255,.09),rgba(255,113,99,.055));
}
.connection-hero-card:after{
  content:"";
  position:absolute;
  width:180px;height:180px;border-radius:50%;
  right:-65px;top:-85px;
  background:radial-gradient(circle,rgba(255,155,105,.10),transparent 68%);
  pointer-events:none;
}
.connection-person{display:flex;align-items:center;gap:16px;min-width:0}
.connection-avatar{
  width:68px;height:68px;flex:0 0 68px;border-radius:22px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,var(--relationship),var(--accent));
  color:#fff;font-size:25px;font-weight:900;
  box-shadow:0 14px 32px rgba(255,113,99,.18);
}
.connection-person h2{margin:5px 0 4px}
.connection-person p{margin:0}
.connection-scores .auth-score{
  border-color:rgba(53,211,154,.22);
  background:rgba(53,211,154,.055)
}
.connection-scores .auth-score b{color:#8ce4c0}
.connection-scores .compat-score{
  border-color:rgba(255,113,99,.23);
  background:rgba(255,113,99,.055)
}
.connection-scores .compat-score b{color:#ffc0b9}
.connection-reasons>div:first-child{
  border-color:rgba(53,211,154,.15);
  background:rgba(53,211,154,.035)
}
.connection-reasons>div:last-child{
  border-color:rgba(255,184,77,.14);
  background:rgba(255,184,77,.032)
}
.starter-card{
  border-color:rgba(124,92,255,.20);
  background:linear-gradient(145deg,rgba(124,92,255,.075),rgba(255,113,99,.035))
}
.starter-card blockquote{
  border-left-color:var(--relationship);
  background:rgba(255,113,99,.045)
}
.journey-step.active{
  border-color:rgba(255,113,99,.30);
  background:rgba(255,113,99,.07)
}
.journey-step.active>span{
  background:linear-gradient(135deg,var(--relationship),var(--accent));
  border-color:transparent
}

.message-row.mine .message-bubble{
  background:linear-gradient(135deg,rgba(124,92,255,.15),rgba(85,175,255,.07));
  border-color:rgba(124,92,255,.26)
}
.message-row.theirs .message-bubble{
  background:rgba(255,113,99,.045);
  border-color:rgba(255,113,99,.15)
}
.message-row.theirs .message-avatar{
  background:rgba(255,113,99,.10);
  border-color:rgba(255,113,99,.24)
}
.chat-safety-note{
  background:rgba(53,211,154,.035);
  color:#a9d9c5
}
.danger-button{border-color:rgba(255,105,102,.28)!important;color:#ffb1af!important}

@media(max-width:640px){
  .connection-avatar{width:56px;height:56px;flex-basis:56px;border-radius:18px;font-size:21px}
  .connection-person{align-items:flex-start}
}

/* AutoFace v0.11 — notifications & activity centre */
.notification-bell{position:relative;width:42px;height:42px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.03);display:grid;place-items:center;color:#dce5f1;font-size:22px}
.notification-bell:hover{border-color:rgba(255,113,99,.35);background:rgba(255,113,99,.06)}
.notification-bell>b{position:absolute;right:-5px;top:-5px;min-width:19px;height:19px;padding:0 5px;border-radius:999px;background:var(--relationship);color:white;font-size:9px;display:grid;place-items:center;border:2px solid var(--bg)}
.notification-head{display:flex;align-items:flex-end;justify-content:space-between;gap:20px}
.notification-head .lead{margin-left:0}
.notification-section{padding-top:32px}.notification-list{display:grid;gap:12px;max-width:920px}
.notification-card{display:grid;grid-template-columns:48px 1fr auto;gap:15px;align-items:center;padding:18px;border:1px solid var(--line);border-radius:18px;background:rgba(255,255,255,.022)}
.notification-card.unread{border-color:rgba(255,113,99,.22);background:linear-gradient(135deg,rgba(255,113,99,.055),rgba(124,92,255,.025))}
.notification-icon{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;font-size:17px;font-weight:900;background:rgba(124,92,255,.10);color:#d7d0ff}
.notification-icon.introduction{background:rgba(255,113,99,.10);color:#ffb6ae}.notification-icon.message{background:rgba(85,175,255,.10);color:#9bd0ff}.notification-icon.verification{background:rgba(53,211,154,.10);color:#8ce4c0}.notification-icon.safety{background:rgba(255,105,102,.10);color:#ffaaa8}
.notification-copy>span{font-size:8px;letter-spacing:.12em;color:#71839e;font-weight:900}.notification-copy h3{margin:4px 0;font-size:16px}.notification-copy p{margin:0;color:var(--muted);font-size:12px;line-height:1.5}.notification-copy small{display:block;margin-top:6px;color:#697991;font-size:9px}
.notification-actions{display:grid;justify-items:end;gap:7px}.notification-actions .btn{padding:9px 12px;font-size:11px}.notification-read{border:0;background:transparent;color:#8999ae;font-size:9px;cursor:pointer}
@media(max-width:760px){.notification-head{display:block}.notification-head>.btn{margin-top:18px;width:auto}.notification-card{grid-template-columns:40px 1fr}.notification-icon{width:38px;height:38px}.notification-actions{grid-column:2;justify-items:start;display:flex;align-items:center}.notification-actions .btn{width:auto}}

/* AutoFace v0.12 — smarter discovery & recommendation engine */
.discovery-toolbar{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:20px;padding:14px 16px;border:1px solid rgba(124,92,255,.15);border-radius:15px;background:rgba(124,92,255,.035)}.discovery-toolbar p{margin:4px 0 0;color:var(--muted);font-size:11px}.recommendation-detail-link{display:block;margin-top:-4px;color:#ffb3aa;font-size:11px;font-weight:800}.recommendation-detail-link:hover{color:#ffd0ca}
.preference-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.6fr);gap:20px;align-items:start}.preference-form{display:grid;gap:18px}.preference-age{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:end}.preference-age label{display:grid;gap:7px;color:#aab6c8;font-size:11px}.preference-age input{width:100%;padding:13px 14px;border-radius:12px;border:1px solid var(--line);background:#0a1020;color:var(--text)}.preference-age>span{padding-bottom:13px;color:#718198}.preference-block{display:grid;gap:7px}.preference-block>label:first-child{font-size:11px;color:#aab6c8;margin-bottom:2px}.preference-relocation{border-top:1px solid var(--line);padding-top:16px}.preference-explainer{position:sticky;top:92px}.recommendation-flow{display:grid;gap:7px;margin:18px 0}.recommendation-flow span{padding:10px 12px;border-radius:11px;background:rgba(255,255,255,.03);font-size:11px;font-weight:800}.recommendation-flow b{text-align:center;color:#718198;font-size:11px}
.recommendation-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(275px,.55fr);gap:20px;align-items:start}.recommendation-main,.recommendation-side{display:grid;gap:20px}.recommendation-person{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;background:linear-gradient(135deg,rgba(255,113,99,.07),rgba(124,92,255,.065));border-color:rgba(255,113,99,.20)}.recommendation-person h2{margin:5px 0}.recommendation-person p{margin:0 0 8px}.recommendation-score{text-align:right}.recommendation-score b{display:block;font-size:42px;color:#ffc0b9;letter-spacing:-.05em}.recommendation-score small{font-size:9px;color:#8695aa;text-transform:uppercase;letter-spacing:.08em}.recommendation-dimensions{display:grid;gap:10px;margin-top:18px}.recommendation-dimensions>div{display:grid;grid-template-columns:1fr auto;gap:6px 12px;padding:14px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.018)}.recommendation-dimensions>div>div{display:grid}.recommendation-dimensions b{font-size:12px}.recommendation-dimensions small{font-size:9px;color:#718198}.recommendation-dimensions strong{font-size:16px}.recommendation-dimensions span{grid-column:1/-1;height:5px;border-radius:999px;background:rgba(255,255,255,.06);overflow:hidden}.recommendation-dimensions span i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--relationship));border-radius:999px}.recommendation-dimensions p{grid-column:1/-1;margin:0;font-size:10px;color:#8998ad}.recommendation-side{position:sticky;top:92px}.recommendation-side>.btn{width:100%}
@media(max-width:900px){.preference-layout,.recommendation-layout{grid-template-columns:1fr}.preference-explainer,.recommendation-side{position:static}.recommendation-person{grid-template-columns:auto 1fr}.recommendation-score{grid-column:1/-1;text-align:left}.recommendation-score b{font-size:34px}}@media(max-width:600px){.discovery-toolbar{display:block}.discovery-toolbar .btn{margin-top:12px;width:100%}.preference-age{grid-template-columns:1fr}.preference-age>span{display:none}}


/* AutoFace v0.12.3 — recommendation explanation polish */
.recommendation-page-hero .lead{max-width:780px}
.recommendation-person-copy{min-width:0}
.recommendation-score.enhanced-score{
  display:grid;
  justify-items:end;
  align-content:center;
  min-width:150px;
}
.recommendation-score.enhanced-score b{
  font-size:42px;
  line-height:1;
}
.recommendation-score.enhanced-score small{
  margin-top:5px;
  font-size:10px;
  font-weight:900;
  letter-spacing:.10em;
  text-transform:uppercase;
  color:#ffb7af;
}
.recommendation-score.enhanced-score span{
  margin-top:4px;
  font-size:9px;
  color:#8695ab;
  text-transform:uppercase;
  letter-spacing:.08em;
}
.recommendation-breakdown-card{
  border-color:rgba(124,92,255,.18);
}
.recommendation-summary{
  max-width:780px;
  line-height:1.65;
}
.recommendation-dimension{
  padding:15px 16px!important;
}
.dimension-heading{
  display:flex!important;
  justify-content:space-between;
  align-items:flex-start;
  gap:16px;
}
.dimension-heading>div:first-child{
  display:grid;
  gap:3px;
}
.dimension-heading b{
  font-size:13px;
}
.dimension-heading small{
  font-size:9px;
  color:#71819a;
}
.dimension-score-wrap{
  display:flex!important;
  align-items:center;
  gap:10px;
  flex:0 0 auto;
}
.dimension-score-wrap strong{
  font-size:16px!important;
  min-width:42px;
  text-align:right;
}
.dimension-band{
  display:inline-flex;
  align-items:center;
  min-height:22px;
  padding:4px 8px;
  border-radius:999px;
  font-size:8px;
  font-weight:900;
  letter-spacing:.05em;
  text-transform:uppercase;
  white-space:nowrap;
}
.dimension-band.strong{
  color:#8ce4c0;
  border:1px solid rgba(53,211,154,.22);
  background:rgba(53,211,154,.06);
}
.dimension-band.explore{
  color:#ffd29d;
  border:1px solid rgba(255,184,77,.22);
  background:rgba(255,184,77,.055);
}
.dimension-band.discuss{
  color:#ffb6ae;
  border:1px solid rgba(255,113,99,.22);
  background:rgba(255,113,99,.055);
}
.dimension-meter{
  display:block!important;
  width:100%;
  height:5px;
  margin:10px 0 9px;
  border-radius:999px;
  overflow:hidden;
  background:rgba(255,255,255,.07);
}
.dimension-meter i{
  display:block;
  height:100%;
  border-radius:inherit;
  background:linear-gradient(90deg,var(--accent),var(--relationship));
}
.recommendation-dimension>p{
  margin:0!important;
  font-size:11px!important;
  line-height:1.55!important;
  color:#9ba9bc!important;
}
.recommendation-trust-card .status-pill{
  width:max-content;
  margin-bottom:10px;
}
.recommendation-preferences-card h3{
  margin:6px 0 14px;
}
.preference-audit{
  display:grid;
  gap:8px;
  margin:12px 0 16px;
}
.preference-audit span{
  display:flex;
  justify-content:space-between;
  gap:14px;
  padding:9px 0;
  border-bottom:1px solid rgba(255,255,255,.07);
  font-size:11px;
  color:#a8b5c8;
}
.preference-audit b{
  color:#e0e7f1;
}
.recommendation-back{
  width:100%;
}
@media(max-width:720px){
  .recommendation-score.enhanced-score{
    justify-items:start;
    min-width:0;
  }
  .dimension-heading{
    display:grid!important;
  }
  .dimension-score-wrap{
    justify-content:space-between;
  }
}


/* AutoFace v0.13 — Account, Privacy & Data Controls */
.account-privacy-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(290px,.72fr);gap:22px;align-items:start}
.account-privacy-main,.account-privacy-side{display:grid;gap:18px}
.account-control-card h2{margin:6px 0 10px}
.account-control-card>p{max-width:760px;line-height:1.6}
.account-control-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}
.account-data-row{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-top:1px solid rgba(255,255,255,.07);font-size:12px}
.account-data-row span{color:#8493a8}.account-data-row code{font-size:10px;color:#aebbd0;overflow-wrap:anywhere;text-align:right}
.privacy-live{color:#8ce4c0!important;border-color:rgba(53,211,154,.22)!important;background:rgba(53,211,154,.06)!important}
.privacy-action-row{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-top:18px;padding:15px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.018)}
.privacy-action-row>div{display:grid;gap:4px}.privacy-action-row b{font-size:12px}.privacy-action-row small{font-size:10px;color:#8090a7}
.data-export-note{display:grid;gap:5px;margin:16px 0;padding:14px;border-radius:13px;border:1px solid rgba(53,211,154,.17);background:rgba(53,211,154,.035)}
.data-export-note b{font-size:12px;color:#9be5c8}.data-export-note span{font-size:10px;line-height:1.55;color:#8c9bb0}
.privacy-status-list{display:grid;margin:14px 0}
.privacy-status-list span{display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.07);font-size:11px;color:#9cabbe}
.privacy-status-list b{color:#e1e8f1}
.privacy-principle-card{background:linear-gradient(145deg,rgba(124,92,255,.07),rgba(85,175,255,.035))}
.danger-zone{border-color:rgba(255,105,102,.23);background:linear-gradient(145deg,rgba(255,105,102,.045),rgba(255,255,255,.018))}
.danger-kicker{color:#ff9d9a!important}
.delete-confirmation{display:grid;gap:12px;margin-top:18px;padding:16px;border-radius:14px;border:1px solid rgba(255,105,102,.22);background:rgba(255,105,102,.035)}
.delete-confirmation label{font-size:11px;color:#c6d0dd}.delete-confirmation input{width:100%;box-sizing:border-box}
.delete-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap}
.destructive-fill{background:rgba(255,105,102,.13)!important}
@media(max-width:900px){.account-privacy-layout{grid-template-columns:1fr}.account-privacy-side{grid-template-columns:repeat(2,minmax(0,1fr))}.privacy-principle-card{grid-column:1/-1}}
@media(max-width:620px){.account-privacy-side{grid-template-columns:1fr}.privacy-principle-card{grid-column:auto}.account-control-head,.privacy-action-row{display:grid}.account-data-row{display:grid;gap:5px}.account-data-row code{text-align:left}.delete-actions{display:grid}.delete-actions .btn{width:100%}}


/* AutoFace v0.14 — Safety Operations */
.admin-hero{background:radial-gradient(circle at 88% 5%,rgba(255,105,102,.08),transparent 28%)}
.admin-summary-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px;margin-bottom:18px}
.admin-stat{display:grid;gap:6px}.admin-stat span{font-size:10px;text-transform:uppercase;letter-spacing:.08em;color:#8190a6}.admin-stat b{font-size:32px}
.admin-privacy-banner{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:28px;border-color:rgba(53,211,154,.18);background:rgba(53,211,154,.035)}
.admin-privacy-banner h3{margin:5px 0}.admin-privacy-banner p{margin:0}
.admin-toolbar{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin:8px 0 14px}.admin-toolbar h2{margin:5px 0 0}
.admin-filter{display:flex;padding:4px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.02)}
.admin-filter button{border:0;background:transparent;color:#8998ad;padding:8px 12px;border-radius:8px;font:inherit;font-size:10px;font-weight:800;text-transform:capitalize;cursor:pointer}
.admin-filter button.active{background:rgba(124,92,255,.13);color:#e0dafe}
.admin-report-list{display:grid;gap:14px}
.admin-report{border-color:rgba(255,113,99,.16)}.admin-report.resolved{border-color:rgba(53,211,154,.13)}
.admin-report-top{display:flex;justify-content:space-between;gap:16px}.admin-report-top h3{margin:5px 0 3px}.admin-report-top p{margin:0;font-size:10px;color:#8291a7}
.admin-report-state{display:flex;align-items:flex-start;gap:7px;flex-wrap:wrap;justify-content:flex-end}.admin-suspended{color:#ffaaa8!important;border-color:rgba(255,105,102,.22)!important;background:rgba(255,105,102,.06)!important}
.admin-report-meta{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:16px 0;padding:12px;border-radius:12px;background:rgba(255,255,255,.022)}
.admin-report-meta span{display:grid;gap:3px;font-size:10px;color:#8d9bb0}.admin-report-meta b{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#65758c}
.admin-report-details,.admin-resolution{padding:13px;border:1px solid var(--line);border-radius:12px;margin-top:10px}.admin-report-details b,.admin-resolution b{font-size:9px;text-transform:uppercase;letter-spacing:.08em;color:#8090a7}.admin-report-details p,.admin-resolution p{margin:6px 0 0;line-height:1.55;font-size:11px}
.admin-resolution{border-color:rgba(53,211,154,.16);background:rgba(53,211,154,.03)}
.admin-report-actions{display:flex;gap:9px;justify-content:flex-end;margin-top:14px;flex-wrap:wrap}
.admin-principles{margin-top:28px;background:linear-gradient(145deg,rgba(124,92,255,.055),rgba(85,175,255,.025))}.admin-principles h2{margin:6px 0 15px}
.admin-principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.admin-principle-grid>div{display:grid;gap:5px;padding:13px;border-radius:12px;border:1px solid var(--line);background:rgba(255,255,255,.018)}.admin-principle-grid b{font-size:11px}.admin-principle-grid span{font-size:10px;line-height:1.5;color:#8494aa}
.admin-empty,.admin-denied{text-align:left}.admin-denied{max-width:620px;margin:60px auto}.admin-denied .btn{margin-top:10px}
@media(max-width:850px){.admin-summary-grid{grid-template-columns:1fr 1fr}.admin-report-meta{grid-template-columns:1fr}.admin-principle-grid{grid-template-columns:1fr}.admin-privacy-banner,.admin-toolbar{display:grid}.admin-filter{width:max-content}}
@media(max-width:500px){.admin-summary-grid{grid-template-columns:1fr 1fr}.admin-report-top{display:grid}.admin-report-state{justify-content:flex-start}.admin-report-actions{display:grid}.admin-report-actions .btn{width:100%}}


/* AutoFace v0.14.1 — member reporting & blocking */
.safety-control-card{border-color:rgba(255,113,99,.15)}
.safety-control-card>p{font-size:12px;line-height:1.55}
.safety-actions{display:grid;gap:8px}
.safety-actions .btn{width:100%;text-align:center}
.report-open{border-color:rgba(255,113,99,.34)!important;background:rgba(255,113,99,.06)!important}
.member-report-panel{
  display:grid;
  gap:14px;
  margin-top:16px;
  padding:16px;
  border-radius:15px;
  border:1px solid rgba(255,113,99,.21);
  background:linear-gradient(145deg,rgba(255,113,99,.055),rgba(124,92,255,.025));
}
.report-panel-head h3{margin:4px 0 6px;font-size:18px}
.report-panel-head p{margin:0;font-size:10px;line-height:1.5}
.member-report-panel>label{display:grid;gap:7px;font-size:11px;font-weight:700}
.member-report-panel select,.member-report-panel textarea{
  width:100%;
  box-sizing:border-box;
  padding:11px 12px;
  border-radius:11px;
  border:1px solid var(--line);
  background:#0a1020;
  color:var(--text);
  font:inherit;
  outline:none;
}
.member-report-panel textarea{resize:vertical;min-height:105px}
.member-report-panel select:focus,.member-report-panel textarea:focus{border-color:rgba(255,113,99,.48)}
.member-report-panel label>small{text-align:right;color:#6f7f96;font-size:9px}
.report-block-choice{
  display:flex!important;
  align-items:flex-start;
  gap:10px!important;
  padding:12px;
  border-radius:11px;
  border:1px solid rgba(255,113,99,.16);
  background:rgba(255,113,99,.035);
  cursor:pointer;
}
.report-block-choice input{width:17px;height:17px;flex:0 0 17px;margin:2px 0 0;accent-color:var(--relationship)}
.report-block-choice>span{display:grid;gap:4px}
.report-block-choice b{font-size:11px}
.report-block-choice small{font-size:9px!important;line-height:1.45;color:#8796aa!important;text-align:left!important}
.report-privacy-note{display:grid;gap:4px;padding:11px;border-radius:11px;background:rgba(85,175,255,.045);border:1px solid rgba(85,175,255,.14)}
.report-privacy-note b{font-size:10px;color:#9fcfff}
.report-privacy-note span{font-size:9px;line-height:1.5;color:#8494aa}
.safety-success{margin-bottom:12px}
@media(max-width:900px){.safety-actions{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:620px){.safety-actions{grid-template-columns:1fr}}


/* AutoFace v0.15 — Beta Readiness & Onboarding */
.beta-hero{background:radial-gradient(circle at 82% 10%,rgba(53,211,154,.08),transparent 28%)}
.beta-readiness-layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(300px,.65fr);gap:20px;align-items:start}
.beta-readiness-main,.beta-readiness-side{display:grid;gap:18px}
.readiness-overview{background:linear-gradient(145deg,rgba(124,92,255,.075),rgba(53,211,154,.035));border-color:rgba(124,92,255,.2)}
.readiness-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px}.readiness-head h2{margin:6px 0 0}.readiness-head>strong{font-size:38px;letter-spacing:-.04em}
.readiness-meter{height:9px;background:rgba(255,255,255,.07);border-radius:999px;overflow:hidden;margin:18px 0 12px}.readiness-meter span{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--success));border-radius:inherit}
.readiness-overview>.btn{margin:12px 8px 0 0}
.setup-card h2{margin:6px 0 18px}.setup-list{display:grid;border-top:1px solid var(--line)}
.setup-step{display:grid;grid-template-columns:38px 1fr auto;gap:13px;align-items:center;padding:15px 0;border-bottom:1px solid var(--line);color:inherit;text-decoration:none}
.setup-step>span{width:30px;height:30px;border-radius:10px;display:grid;place-items:center;background:rgba(124,92,255,.08);border:1px solid rgba(124,92,255,.18);font-size:10px;font-weight:900}
.setup-step>div{display:grid;gap:3px}.setup-step b{font-size:12px}.setup-step small{font-size:10px;color:#8392a8}.setup-step>strong{font-size:9px;color:#8fa0b7}
.setup-step.complete>span{background:rgba(53,211,154,.08);border-color:rgba(53,211,154,.22);color:#8ce4c0}.setup-step.complete>strong{color:#8ce4c0}
.beta-principle-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.beta-principle-grid>div{display:grid;gap:5px;padding:13px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.018)}.beta-principle-grid b{font-size:11px}.beta-principle-grid span{font-size:10px;line-height:1.5;color:#8595aa}
.readiness-side-card{text-align:left}.readiness-auth-score{font-size:44px;font-weight:900;letter-spacing:-.04em;margin:8px 0 0}.readiness-side-card>b{font-size:11px;color:#aab8ca}.readiness-side-card p{font-size:11px}
.beta-feedback-card{display:grid;gap:11px}.beta-feedback-card h3{margin:4px 0 0}.beta-feedback-card>p{margin:0;font-size:11px}.beta-feedback-card label{display:grid;gap:6px;font-size:10px;font-weight:700}.beta-feedback-card select,.beta-feedback-card textarea{width:100%;box-sizing:border-box;padding:11px;border-radius:11px;border:1px solid var(--line);background:#0a1020;color:var(--text);font:inherit}.beta-feedback-card textarea{resize:vertical}.beta-feedback-card label small{text-align:right;color:#718096}.beta-feedback-sent{padding:10px;border-radius:10px;background:rgba(53,211,154,.05);border:1px solid rgba(53,211,154,.16);font-size:10px;color:#9be5c8}
@media(max-width:900px){.beta-readiness-layout{grid-template-columns:1fr}.beta-readiness-side{grid-template-columns:repeat(2,minmax(0,1fr))}.beta-feedback-card{grid-column:1/-1}}
@media(max-width:620px){.beta-readiness-side{grid-template-columns:1fr}.beta-feedback-card{grid-column:auto}.readiness-head{display:grid}.setup-step{grid-template-columns:34px 1fr}.setup-step>strong{grid-column:2}.beta-principle-grid{grid-template-columns:1fr}}


/* AutoFace v0.16 — Atlas Support Assistant */
.support-assistant{position:fixed;right:22px;bottom:22px;z-index:1200;display:grid;justify-items:end;gap:10px;pointer-events:none}
.support-assistant>*{pointer-events:auto}
.support-launcher{display:flex;align-items:center;gap:10px;padding:8px 13px 8px 8px;border-radius:18px;border:1px solid rgba(124,92,255,.28);background:rgba(12,18,31,.96);color:var(--text);box-shadow:0 18px 50px rgba(0,0,0,.28);cursor:pointer}
.support-launcher:hover{border-color:rgba(255,113,99,.35);transform:translateY(-1px)}
.support-launcher-orb,.support-avatar{display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),var(--relationship));color:white;font-weight:900}
.support-launcher-orb{width:38px;height:38px;border-radius:13px;font-size:14px;box-shadow:0 9px 22px rgba(124,92,255,.2)}
.support-launcher-copy{display:grid;text-align:left;gap:1px}.support-launcher-copy b{font-size:11px}.support-launcher-copy small{font-size:9px;color:#8998ad}
.support-panel{width:min(390px,calc(100vw - 28px));height:min(610px,calc(100vh - 105px));display:grid;grid-template-rows:auto auto 1fr auto auto;border:1px solid rgba(124,92,255,.24);border-radius:22px;overflow:hidden;background:rgba(8,13,24,.985);box-shadow:0 28px 80px rgba(0,0,0,.46);backdrop-filter:blur(20px)}
.support-header{display:grid;grid-template-columns:42px 1fr 32px;gap:10px;align-items:center;padding:14px 15px;border-bottom:1px solid var(--line)}
.support-avatar{width:40px;height:40px;border-radius:13px}
.support-header>div:nth-child(2){display:grid;gap:2px}.support-header b{font-size:13px}.support-header span{font-size:9px;color:#8291a7}
.support-header>button{width:30px;height:30px;border:0;border-radius:9px;background:rgba(255,255,255,.04);color:#9cabc0;font-size:20px;cursor:pointer}
.support-boundary{padding:8px 14px;background:rgba(53,211,154,.035);border-bottom:1px solid rgba(53,211,154,.10);font-size:8px;line-height:1.4;color:#82bea6;text-align:center;text-transform:uppercase;letter-spacing:.055em}
.support-messages{min-height:0;overflow-y:auto;padding:15px;display:grid;align-content:start;gap:10px}
.support-message{max-width:88%;padding:10px 12px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.025)}
.support-message>span{display:block;margin-bottom:4px;font-size:8px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;color:#71839c}
.support-message p{margin:0;color:#b8c4d3;font-size:11px;line-height:1.55}
.support-message.assistant{justify-self:start;border-color:rgba(124,92,255,.18);background:linear-gradient(145deg,rgba(124,92,255,.07),rgba(85,175,255,.025))}
.support-message.assistant>span{color:#ada3ff}
.support-message.user{justify-self:end;border-color:rgba(255,113,99,.17);background:rgba(255,113,99,.045)}
.support-message.user>span{color:#ffaaa1}
.support-action{display:inline-block;margin-top:8px;color:#a9cfff;font-size:10px;font-weight:800;text-decoration:none}
.support-thinking{opacity:.7}
.support-quick{display:flex;gap:6px;overflow-x:auto;padding:0 14px 11px;scrollbar-width:none}
.support-quick::-webkit-scrollbar{display:none}.support-quick button{flex:0 0 auto;border:1px solid var(--line);border-radius:999px;padding:7px 9px;background:rgba(255,255,255,.025);color:#9dabbd;font:inherit;font-size:9px;cursor:pointer}.support-quick button:hover{border-color:rgba(124,92,255,.3);color:#d5ddE8}
.support-composer{display:grid;grid-template-columns:1fr auto;gap:7px;padding:11px;border-top:1px solid var(--line);background:rgba(255,255,255,.012)}
.support-composer input{min-width:0;padding:11px 12px;border-radius:11px;border:1px solid var(--line);background:#0a1020;color:var(--text);outline:none;font:inherit;font-size:11px}
.support-composer input:focus{border-color:rgba(124,92,255,.45)}
.support-composer button{border:0;border-radius:11px;padding:0 14px;background:linear-gradient(135deg,var(--accent),var(--relationship));color:white;font:inherit;font-size:10px;font-weight:800;cursor:pointer}
.support-composer button:disabled{opacity:.5;cursor:not-allowed}
@media(max-width:620px){.support-assistant{right:10px;bottom:10px}.support-panel{height:min(620px,calc(100vh - 84px))}.support-launcher-copy{display:none}.support-launcher{padding:7px;border-radius:15px}.support-launcher-orb{width:42px;height:42px}}


/* AutoFace v0.17 — Beta Operations */
.ops-hero{background:radial-gradient(circle at 86% 12%,rgba(85,175,255,.08),transparent 28%)}
.ops-hero-actions{display:flex;gap:9px;margin-top:20px;flex-wrap:wrap}
.ops-section{padding-top:36px}
.ops-environment{display:flex;gap:10px;align-items:center;margin-bottom:14px;padding:10px 13px;border-radius:12px;border:1px solid rgba(53,211,154,.16);background:rgba(53,211,154,.035);font-size:10px;color:#8fae9f}
.ops-environment b{font-size:8px;letter-spacing:.08em;color:#8ce4c0}.ops-environment.demo{border-color:rgba(255,184,77,.17);background:rgba(255,184,77,.04)}.ops-environment.demo b{color:#ffd29d}
.ops-stat-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:10px;margin-bottom:18px}
.ops-stat{display:grid;gap:4px;padding:18px}.ops-stat>span{font-size:8px;text-transform:uppercase;letter-spacing:.08em;color:#76869d}.ops-stat>b{font-size:30px;letter-spacing:-.04em}.ops-stat>small{font-size:9px;color:#6f7f96}
.ops-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.6fr);gap:16px;margin-bottom:16px}
.ops-funnel-card h2,.ops-engagement-card h2{margin:5px 0 7px}.ops-funnel-card>p{font-size:11px;margin:0 0 16px}
.ops-funnel{display:grid;gap:12px}.ops-funnel-row{display:grid;grid-template-columns:160px 1fr 46px;gap:12px;align-items:center}.ops-funnel-row>div:first-child{display:grid;gap:2px}.ops-funnel-row b{font-size:11px}.ops-funnel-row span{font-size:9px;color:#718198}.ops-funnel-row>strong{text-align:right;font-size:12px}
.ops-funnel-meter{height:7px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden}.ops-funnel-meter i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),var(--success))}
.ops-metric-list{display:grid;margin:13px 0}.ops-metric-list span{display:flex;justify-content:space-between;gap:12px;padding:10px 0;border-bottom:1px solid var(--line);font-size:11px}.ops-metric-list b{font-weight:700}.ops-note{font-size:9px!important;line-height:1.5!important;color:#7c8ba0!important}
.ops-section-head,.ops-feedback-heading{display:flex;align-items:flex-end;justify-content:space-between;gap:16px}.ops-section-head h2,.ops-feedback-heading h2{margin:5px 0 0}
.ops-member-table{display:grid;margin-top:15px}.ops-member-row{display:grid;grid-template-columns:1.4fr .6fr .7fr .8fr 1fr;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}.ops-member-row.header{padding-top:0;color:#6f7f96;font-size:8px;text-transform:uppercase;letter-spacing:.07em}.ops-member-row>span{display:grid;gap:2px;font-size:10px}.ops-member-row b{font-size:10px}.ops-member-row small{font-size:8px;color:#708096}.ops-member-row em{display:inline-flex;width:max-content;padding:2px 5px;border-radius:999px;background:rgba(255,184,77,.06);border:1px solid rgba(255,184,77,.15);font-size:7px;color:#ffd29d;font-style:normal}
.feedback-grid{grid-template-columns:1fr 1fr}.ops-feedback-summary{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin:15px 0}.ops-feedback-summary span{display:grid;gap:3px;padding:11px;border-radius:11px;border:1px solid var(--line);background:rgba(255,255,255,.018)}.ops-feedback-summary b{font-size:21px}.ops-feedback-summary small{font-size:8px;color:#78889e}
.ops-feedback-heading{margin:28px 0 12px}
.ops-feedback-list{display:grid;gap:12px}.ops-feedback-item{padding:20px}.ops-feedback-top{display:flex;align-items:flex-start;justify-content:space-between;gap:14px}.ops-feedback-top h3{margin:4px 0 0;font-size:14px}.ops-feedback-item>p{font-size:11px;line-height:1.6;margin:14px 0}.ops-feedback-meta{display:flex;gap:12px;flex-wrap:wrap;color:#718198;font-size:8px}.ops-feedback-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end;margin-top:14px}.ops-feedback-actions .btn{padding:8px 10px;font-size:9px}
.ops-privacy-card{margin-top:25px;border-color:rgba(85,175,255,.16);background:rgba(85,175,255,.025)}.ops-privacy-card h2{margin:5px 0 8px}
@media(max-width:1050px){.ops-stat-grid{grid-template-columns:repeat(3,1fr)}}
@media(max-width:850px){.ops-grid,.feedback-grid{grid-template-columns:1fr}.ops-member-row{grid-template-columns:1fr 1fr}.ops-member-row.header{display:none}.ops-member-row>span:first-child{grid-column:1/-1}.ops-feedback-summary{grid-template-columns:1fr 1fr}}
@media(max-width:620px){.ops-stat-grid{grid-template-columns:1fr 1fr}.ops-funnel-row{grid-template-columns:115px 1fr 38px}.ops-section-head,.ops-feedback-heading{display:grid}.ops-member-row{grid-template-columns:1fr}.ops-member-row>span:first-child{grid-column:auto}.ops-feedback-top{display:grid}.ops-feedback-actions{display:grid;justify-content:stretch}.ops-feedback-actions .btn{width:100%}.ops-environment{display:grid}}


/* AutoFace v0.18 — Beta Launch Readiness */
.launch-register-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.65fr);gap:20px;align-items:start}.launch-register-form{max-width:none}.launch-register-side{display:grid;gap:16px}
.beta-invite-banner{display:grid;gap:4px;margin-bottom:18px;padding:13px;border-radius:13px;border:1px solid rgba(255,184,77,.2);background:rgba(255,184,77,.05)}.beta-invite-banner b{font-size:11px;color:#ffd29d}.beta-invite-banner span{font-size:10px;color:#9d907a}
.launch-consent{display:flex;gap:10px;align-items:flex-start;margin:18px 0;padding:13px;border-radius:13px;border:1px solid var(--line);background:rgba(255,255,255,.018);font-size:10px;line-height:1.5;color:#9aa8ba}.launch-consent input{margin-top:2px;width:17px;height:17px;accent-color:var(--accent)}.launch-consent a{color:#a9cfff}
.launch-step-list{display:grid;gap:9px;margin-top:16px}.launch-step-list span{display:flex;gap:9px;align-items:center;font-size:10px;color:#9cabbf}.launch-step-list b{width:24px;height:24px;display:grid;place-items:center;border-radius:8px;background:rgba(124,92,255,.09);color:#cfc8ff}.launch-trust-note{border-color:rgba(53,211,154,.14)}
.legal-section{padding-top:32px}.legal-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.legal-card h2{font-size:20px;margin-bottom:8px}.legal-card p{font-size:12px}.legal-actions{display:flex;gap:9px;margin-top:20px}
.beta-invite-manager{margin:20px 0}.beta-invite-manager>p{font-size:11px}.beta-invite-form{display:grid;grid-template-columns:1fr 100px 1.2fr auto;gap:8px;align-items:end;margin:16px 0}.beta-invite-form label{display:grid;gap:5px;font-size:9px;font-weight:800;color:#8392a7}.beta-invite-form input{width:100%;box-sizing:border-box;padding:10px;border-radius:10px;border:1px solid var(--line);background:#0a1020;color:var(--text)}.beta-invite-list{display:grid;border-top:1px solid var(--line)}.beta-invite-row{display:grid;grid-template-columns:1fr auto auto;gap:10px;align-items:center;padding:11px 0;border-bottom:1px solid var(--line)}.beta-invite-row>span:first-child{display:grid;gap:3px}.beta-invite-row b{font-size:11px}.beta-invite-row small{font-size:9px;color:#76869c}.beta-invite-row .btn{padding:8px 10px;font-size:9px}
@media(max-width:850px){.launch-register-layout{grid-template-columns:1fr}.legal-grid{grid-template-columns:1fr}.beta-invite-form{grid-template-columns:1fr 100px}.beta-invite-form label:nth-child(3){grid-column:1/-1}.beta-invite-form .btn{grid-column:1/-1}.beta-invite-row{grid-template-columns:1fr auto}.beta-invite-row .btn{grid-column:1/-1;width:100%}}
@media(max-width:520px){.beta-invite-form{grid-template-columns:1fr}.beta-invite-form label:nth-child(3),.beta-invite-form .btn{grid-column:auto}.legal-actions{display:grid}}

/* AutoFace v0.19 — Production & Beta Polish */
.brand-beta{display:inline-flex;align-items:center;min-height:20px;padding:3px 7px;border-radius:999px;border:1px solid rgba(124,92,255,.28);background:rgba(124,92,255,.08);color:#cfc8ff;font-size:8px;letter-spacing:.1em;font-weight:900}
.auth-polish-section{padding-top:36px}.auth-polish-layout{display:grid;grid-template-columns:minmax(0,620px) minmax(280px,360px);gap:18px;align-items:start}.auth-side-note{padding:24px}.auth-side-note h3{margin-top:6px}.field-label-row{display:flex;align-items:center;justify-content:space-between;gap:10px}.field-label-row a{font-size:11px;color:#9fcfff;font-weight:700}.notice-error{background:rgba(255,105,105,.06);border-color:rgba(255,105,105,.2);color:#ffc4c4}.launch-success{display:grid;gap:5px;margin-bottom:16px;padding:15px;border-radius:14px;border:1px solid rgba(67,209,158,.22);background:rgba(67,209,158,.06)}.launch-success b{color:#a8ecd2}.launch-success span{font-size:11px;color:#8da99e}.verify-email-card{max-width:720px}.verify-email-card h2{font-size:28px;margin-top:6px;word-break:break-word}.verify-actions,.error-state-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}.error-state-section{min-height:65vh;display:grid;align-items:center}.error-state-card{text-align:center;padding:48px}.error-state-card h1{font-size:clamp(42px,6vw,68px);text-align:center;margin:20px auto}.error-state-card p{max-width:570px;margin:0 auto}.error-state-actions{justify-content:center}.footer-legal{display:flex;gap:16px}.footer-legal a:hover{color:var(--text)}
@media(max-width:800px){.auth-polish-layout{grid-template-columns:1fr}.brand-beta{font-size:7px}.error-state-card{padding:30px 20px}}


/* AutoFace v0.20 — The AutoFace Experience landing page */
.experience-home{overflow:hidden}
.experience-hero{position:relative;min-height:760px;display:grid;align-items:center;padding:86px 0 100px;background:linear-gradient(180deg,#070b14 0%,#090d18 70%,#070b14 100%)}
.experience-glow{position:absolute;border-radius:999px;filter:blur(90px);pointer-events:none;opacity:.55}
.experience-glow-one{width:470px;height:470px;right:-120px;top:30px;background:rgba(113,81,255,.22)}
.experience-glow-two{width:380px;height:380px;left:-170px;bottom:-110px;background:rgba(255,86,143,.12)}
.experience-hero-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,1.02fr) minmax(420px,.78fr);gap:72px;align-items:center}
.experience-kicker{display:inline-flex;align-items:center;gap:7px;padding:7px 11px;border:1px solid rgba(255,255,255,.10);border-radius:999px;background:rgba(255,255,255,.035);color:#c4baff;font-size:11px;font-weight:800;letter-spacing:.04em}
.experience-hero-copy h1{max-width:700px;margin:24px 0 22px;font-size:clamp(54px,6.7vw,92px);line-height:.96;letter-spacing:-.065em}
.experience-hero-copy h1 em,.experience-statement h2 em{font-style:normal;background:linear-gradient(100deg,#ff8aab,#c993ff 45%,#7cbfff);-webkit-background-clip:text;background-clip:text;color:transparent}
.experience-hero-copy>p{max-width:640px;margin:0;color:#aeb8ca;font-size:18px;line-height:1.7}
.experience-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:30px}
.experience-primary,.experience-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 18px;border-radius:13px;font-size:12px;font-weight:900}
.experience-primary{background:linear-gradient(135deg,#7f5cff,#ff6f9d);color:white;box-shadow:0 13px 35px rgba(126,92,255,.23)}
.experience-secondary{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.035);color:#d6deeb}
.experience-proof{display:flex;gap:16px;flex-wrap:wrap;margin-top:25px;color:#7f8da3;font-size:9px;font-weight:700}.experience-proof span{display:flex;gap:5px;align-items:center}.experience-proof svg{color:#72d5af}
.experience-match-wrap{position:relative;min-height:530px;display:grid;place-items:center}
.experience-card-aura{position:absolute;width:390px;height:390px;border-radius:50%;background:radial-gradient(circle,rgba(129,91,255,.25),rgba(255,98,150,.09) 48%,transparent 70%);filter:blur(18px)}
.experience-match-card{position:relative;z-index:2;width:min(100%,430px);padding:24px;border:1px solid rgba(255,255,255,.13);border-radius:27px;background:linear-gradient(155deg,rgba(23,29,48,.96),rgba(10,15,27,.98));box-shadow:0 35px 90px rgba(0,0,0,.48),inset 0 1px rgba(255,255,255,.04);transform:rotate(1.3deg)}
.experience-card-top{display:flex;justify-content:space-between;gap:16px;align-items:flex-start}.experience-card-label{font-size:8px;letter-spacing:.13em;font-weight:900;color:#9d91ff}.experience-card-top h2{font-size:28px;margin:6px 0 2px}.experience-card-top p{margin:0;font-size:10px;color:#7f8da3}
.experience-auth-chip{display:inline-flex;align-items:center;gap:5px;padding:7px 9px;border-radius:999px;border:1px solid rgba(65,205,156,.18);background:rgba(65,205,156,.06);color:#91dfc0;font-size:8px;font-weight:800;white-space:nowrap}
.experience-score{display:grid;justify-items:center;padding:27px 0 24px;margin:19px 0;border-top:1px solid rgba(255,255,255,.07);border-bottom:1px solid rgba(255,255,255,.07)}.experience-score strong{font-size:64px;line-height:1;letter-spacing:-.06em;background:linear-gradient(130deg,#fff,#c6bdff 55%,#ff9aba);-webkit-background-clip:text;background-clip:text;color:transparent}.experience-score span{margin-top:7px;font-size:8px;font-weight:900;letter-spacing:.15em;color:#8b9ab0}.experience-score small{margin-top:4px;color:#b6c1d1;font-size:10px}
.experience-alignments{display:grid;gap:13px}.experience-alignment>div:first-child{display:flex;justify-content:space-between;gap:10px;margin-bottom:7px}.experience-alignment b{font-size:9px}.experience-alignment span{font-size:8px;color:#8493a8}.experience-alignment-meter{height:4px;border-radius:999px;background:rgba(255,255,255,.07);overflow:hidden}.experience-alignment-meter i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#7d62ff,#ff769f)}
.experience-card-footer{display:flex;justify-content:space-between;align-items:center;margin-top:21px;padding:13px 14px;border-radius:12px;background:rgba(127,92,255,.07);border:1px solid rgba(127,92,255,.13);color:#bdb5ff;font-size:9px;font-weight:800}
.experience-floating-note{position:absolute;z-index:3;display:grid;gap:2px;padding:10px 12px;border:1px solid rgba(255,255,255,.11);border-radius:13px;background:rgba(13,19,31,.92);box-shadow:0 15px 40px rgba(0,0,0,.28);backdrop-filter:blur(12px)}.experience-floating-note span{font-size:7px;letter-spacing:.1em;color:#7f8da3}.experience-floating-note b{font-size:9px}.note-one{left:-22px;bottom:105px}.note-two{right:-13px;top:95px}
.experience-statement{padding:120px 0;text-align:center;background:#070b14}.experience-section-label{font-size:9px;letter-spacing:.16em;font-weight:900;color:#8d80f7}.experience-statement h2{max-width:1020px;margin:18px auto 20px;font-size:clamp(40px,5vw,68px);line-height:1.05}.experience-statement p{max-width:700px;margin:0 auto;color:#8f9db1;font-size:15px;line-height:1.7}
.experience-journey{padding:110px 0;background:linear-gradient(180deg,#090e18,#070b14)}.experience-section-head{display:grid;grid-template-columns:1fr 430px;gap:50px;align-items:end;margin-bottom:42px}.experience-section-head h2{margin:10px 0 0}.experience-section-head>p{margin:0;color:#8e9cb1;line-height:1.65}
.experience-three{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.experience-three article{position:relative;min-height:305px;padding:25px;border-radius:22px;border:1px solid rgba(255,255,255,.09);background:linear-gradient(160deg,rgba(255,255,255,.04),rgba(255,255,255,.018));overflow:hidden}.experience-three article>span{position:absolute;right:20px;top:15px;font-size:56px;font-weight:900;color:rgba(255,255,255,.035)}.experience-stage-icon{width:45px;height:45px;display:grid;place-items:center;margin-bottom:44px;border-radius:14px;background:linear-gradient(140deg,rgba(128,92,255,.16),rgba(255,108,156,.08));color:#c4baff}.experience-three h3{font-size:26px;margin:0 0 10px}.experience-three p{margin:0;color:#8a98ac;font-size:12px;line-height:1.7}
.experience-dual{padding:120px 0;background:#070b14}.experience-dual-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(460px,1fr);gap:80px;align-items:center}.experience-dual-copy h2{margin:15px 0 15px;font-size:clamp(39px,4.5vw,62px);line-height:1.02}.experience-dual-copy>p{max-width:570px;color:#929fb2;line-height:1.7}.experience-inline-link{display:inline-flex;align-items:center;gap:6px;margin-top:13px;color:#bdb4ff;font-size:11px;font-weight:900}
.experience-dual-visual{min-height:440px;display:grid;place-items:center}.experience-orbit{position:relative;width:440px;height:340px}.experience-orbit:before{content:"";position:absolute;inset:25px 55px;border:1px solid rgba(130,102,255,.16);border-radius:50%;transform:rotate(-8deg)}.experience-orbit:after{content:"";position:absolute;inset:60px 25px;border:1px solid rgba(255,110,156,.10);border-radius:50%;transform:rotate(12deg)}.experience-orbit-centre{position:absolute;z-index:3;left:50%;top:50%;transform:translate(-50%,-50%);width:105px;height:105px;display:grid;place-items:center;border-radius:50%;background:linear-gradient(145deg,#171e30,#0c111e);border:1px solid rgba(255,255,255,.13);box-shadow:0 0 60px rgba(124,92,255,.15);font-size:10px;font-weight:900;letter-spacing:.12em}.experience-orbit-card{position:absolute;z-index:4;width:185px;padding:17px;border-radius:18px;border:1px solid rgba(255,255,255,.11);background:rgba(15,21,35,.94);box-shadow:0 18px 45px rgba(0,0,0,.32);display:grid;gap:4px}.experience-orbit-card span{font-size:7px;font-weight:900;letter-spacing:.13em}.experience-orbit-card b{font-size:18px}.experience-orbit-card small{font-size:9px;color:#7e8ca0}.orbit-atlas{left:5px;top:36px}.orbit-atlas span{color:#a798ff}.orbit-auth{right:0;bottom:35px}.orbit-auth span{color:#81d7b5}
.experience-principle{padding:70px 0 115px;background:#070b14}.experience-quote{max-width:1000px;margin:0 auto;padding:60px 30px;text-align:center;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}.experience-quote blockquote{margin:18px auto;font-size:clamp(38px,5vw,62px);line-height:1.07;letter-spacing:-.05em;font-weight:800}.experience-quote p{margin:0;color:#8d9aae}
.experience-final{padding:110px 0;background:radial-gradient(circle at 50% 100%,rgba(124,92,255,.16),transparent 45%),#090d17}.experience-final-inner{text-align:center}.experience-final h2{margin:15px auto 10px;font-size:clamp(42px,5vw,66px)}.experience-final p{color:#8d9aae}.final-actions{justify-content:center}
@media(max-width:950px){.experience-hero-grid,.experience-dual-grid{grid-template-columns:1fr}.experience-hero-grid{gap:35px}.experience-match-wrap{min-height:500px}.experience-section-head{grid-template-columns:1fr}.experience-three{grid-template-columns:1fr 1fr}.experience-dual-grid{gap:35px}.experience-dual-copy{text-align:center}.experience-dual-copy>p{margin-left:auto;margin-right:auto}.experience-dual-visual{min-height:380px}}
@media(max-width:650px){.experience-hero{padding:65px 0 70px}.experience-hero-copy{text-align:center}.experience-hero-copy h1{font-size:52px}.experience-hero-copy>p{font-size:15px}.experience-actions,.experience-proof{justify-content:center}.experience-match-wrap{min-height:455px}.experience-match-card{width:94%;padding:18px;transform:none}.experience-floating-note{display:none}.experience-card-top{display:grid}.experience-auth-chip{width:max-content}.experience-score strong{font-size:55px}.experience-statement,.experience-journey,.experience-dual{padding:82px 0}.experience-three{grid-template-columns:1fr}.experience-three article{min-height:245px}.experience-stage-icon{margin-bottom:28px}.experience-orbit{width:320px;height:300px}.experience-orbit-card{width:150px}.orbit-atlas{left:0}.orbit-auth{right:0}.experience-orbit-centre{width:88px;height:88px}.experience-quote{padding:45px 5px}.experience-final{padding:80px 0}}


/* AutoFace v0.20.1 — hero Atlas card polish */
.experience-match-wrap{
  min-height:470px;
  align-items:center;
}
.experience-card-aura{
  width:420px;
  height:340px;
  background:radial-gradient(circle,rgba(129,91,255,.24),rgba(255,98,150,.08) 46%,transparent 72%);
  filter:blur(24px);
}
.experience-match-card{
  width:min(100%,455px);
  padding:25px 26px 24px;
  border-radius:26px;
  transform:none;
  background:
    linear-gradient(160deg,rgba(25,31,50,.985),rgba(10,15,27,.99));
  box-shadow:
    0 34px 85px rgba(0,0,0,.42),
    0 0 70px rgba(124,92,255,.065),
    inset 0 1px rgba(255,255,255,.045);
}
.experience-card-top{
  align-items:center;
}
.experience-card-top h2{
  font-size:30px;
  margin:6px 0 3px;
}
.experience-card-top p{
  font-size:10px;
}
.experience-auth-chip{
  padding:8px 10px;
  font-size:8px;
  color:#99e2c5;
  background:rgba(65,205,156,.065);
  border-color:rgba(65,205,156,.20);
}
.experience-score{
  padding:22px 0 20px;
  margin:18px 0 19px;
}
.experience-score strong{
  font-size:68px;
}
.experience-score span{
  margin-top:6px;
}
.experience-score small{
  font-size:10px;
}
.experience-alignments{
  gap:16px;
}
.experience-alignment>div:first-child{
  align-items:flex-end;
  margin-bottom:8px;
}
.experience-alignment>div:first-child>span{
  display:grid;
  gap:2px;
}
.experience-alignment b{
  font-size:10px;
}
.experience-alignment small{
  color:#78879c;
  font-size:8px;
}
.experience-alignment strong{
  color:#d9e0eb;
  font-size:11px;
}
.experience-alignment-meter{
  height:5px;
}
.experience-card-footer{
  margin-top:24px;
  padding:14px 15px;
  font-size:10px;
  background:linear-gradient(90deg,rgba(127,92,255,.085),rgba(255,105,157,.045));
  border-color:rgba(127,92,255,.16);
}
.experience-floating-note{
  display:none!important;
}
@media(max-width:950px){
  .experience-match-wrap{min-height:455px}
}
@media(max-width:650px){
  .experience-match-wrap{min-height:430px}
  .experience-match-card{width:96%;padding:20px}
  .experience-card-top{display:flex}
  .experience-card-top h2{font-size:26px}
  .experience-auth-chip{font-size:7px}
  .experience-score strong{font-size:58px}
}
@media(max-width:470px){
  .experience-card-top{display:grid}
  .experience-auth-chip{width:max-content}
}


/* AutoFace v0.21 — Atlas AI Discovery */
.ai-discovery-consent{margin-top:12px;border-color:rgba(168,132,255,.22);background:linear-gradient(145deg,rgba(124,92,255,.065),rgba(255,105,157,.025))}
.ai-discovery-card{border-color:rgba(160,118,255,.22);background:radial-gradient(circle at 100% 0%,rgba(124,92,255,.10),transparent 28%),linear-gradient(155deg,rgba(20,25,43,.96),rgba(12,17,29,.97))}
.ai-discovery-title-row{display:flex;justify-content:space-between;align-items:flex-start;gap:18px}.ai-discovery-title-row h2{margin:6px 0 0}.ai-discovery-live{color:#c8b9ff!important;border-color:rgba(149,112,255,.30)!important;background:rgba(124,92,255,.09)!important}
.ai-discovery-intro{max-width:790px;font-size:12px!important;line-height:1.65!important}
.ai-discovery-unavailable{display:grid;gap:6px;margin:18px 0;padding:15px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.018)}.ai-discovery-unavailable b{font-size:12px}.ai-discovery-unavailable span{font-size:10px;line-height:1.5;color:#8190a5}.ai-discovery-unavailable .btn{width:max-content;margin-top:6px}
.ai-discovery-request-consent{margin:18px 0}
.ai-discovery-generate{margin-bottom:4px}
.ai-discovery-output{display:grid;gap:18px;margin-top:20px}
.ai-discovery-headline{display:grid;grid-template-columns:42px 1fr;gap:12px;padding:17px;border-radius:16px;border:1px solid rgba(124,92,255,.20);background:linear-gradient(135deg,rgba(124,92,255,.09),rgba(255,105,157,.035))}
.ai-spark{width:40px;height:40px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,#7558ff,#ff6e9c);font-size:18px;box-shadow:0 10px 24px rgba(124,92,255,.22)}
.ai-discovery-headline small{font-size:8px;letter-spacing:.11em;font-weight:900;color:#a79bff}.ai-discovery-headline h3{font-size:20px;margin:4px 0 6px}.ai-discovery-headline p{margin:0;font-size:11px;line-height:1.55}
.ai-theme-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.ai-theme-card{display:grid;align-content:start;gap:7px;padding:15px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.02)}.ai-theme-card>b{font-size:12px}.ai-theme-card p{margin:0;font-size:10px!important;line-height:1.55!important}.ai-theme-strength{width:max-content;padding:4px 7px;border-radius:999px;font-size:7px;font-weight:900;letter-spacing:.08em}.ai-theme-strength.strong{color:#9be4c7;border:1px solid rgba(67,209,158,.18);background:rgba(67,209,158,.055)}.ai-theme-strength.moderate{color:#d8c4ff;border:1px solid rgba(155,117,255,.20);background:rgba(124,92,255,.06)}
.ai-discussion{display:grid;gap:8px;padding:15px;border:1px solid rgba(255,181,79,.14);border-radius:14px;background:rgba(255,181,79,.025)}.ai-discussion>small{font-size:8px;letter-spacing:.1em;font-weight:900;color:#cba86f}.ai-discussion>div{display:grid;grid-template-columns:150px 1fr;gap:12px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06)}.ai-discussion b{font-size:10px}.ai-discussion span{font-size:10px;line-height:1.5;color:#8997aa}
@media(max-width:800px){.ai-theme-grid{grid-template-columns:1fr}.ai-discovery-title-row{display:grid}.ai-discussion>div{grid-template-columns:1fr}.ai-discovery-headline{grid-template-columns:36px 1fr}.ai-spark{width:34px;height:34px}}


/* AutoFace v0.21.1 — reviewed recommendations & demo reset */
.discovery-toolbar-actions{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
.discovery-empty-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:15px}
.demo-reset-button{border-color:rgba(255,184,77,.20);color:#ffd29d;background:rgba(255,184,77,.035)}
.demo-reset-note{max-width:720px;margin:14px 0 0!important;padding-top:12px;border-top:1px solid var(--line);font-size:9px!important;line-height:1.5!important;color:#7d899a!important}
.reviewed-section{padding-top:36px}.reviewed-toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:14px;color:#7f8da1;font-size:10px}.reviewed-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.reviewed-card{display:grid;gap:15px}.reviewed-card-top{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.reviewed-decision{display:inline-flex;padding:6px 8px;border-radius:999px;font-size:7px;font-weight:900;letter-spacing:.07em;border:1px solid var(--line);white-space:nowrap}.reviewed-decision.interested{color:#9de2c7;border-color:rgba(67,209,158,.18);background:rgba(67,209,158,.05)}.reviewed-decision.pass{color:#a3afc0;background:rgba(255,255,255,.025)}.reviewed-summary{display:grid;grid-template-columns:1fr 1fr;gap:9px}.reviewed-summary>div{padding:12px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.018)}.reviewed-summary small{font-size:8px;font-weight:900;letter-spacing:.08em;color:#78bfff}.reviewed-summary p{margin:5px 0 0;font-size:10px;line-height:1.5;color:#9ba9ba}.reviewed-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:2px}.reviewed-footer>span{font-size:8px;color:#718097}
@media(max-width:850px){.reviewed-grid{grid-template-columns:1fr}.discovery-toolbar{align-items:flex-start}.discovery-toolbar-actions{justify-content:flex-start}.reviewed-summary{grid-template-columns:1fr}}
@media(max-width:620px){.reviewed-toolbar,.reviewed-card-top,.reviewed-footer{display:grid}.discovery-toolbar-actions,.discovery-empty-actions{display:grid}.discovery-toolbar-actions .btn,.discovery-empty-actions .btn{width:100%}}


/* AutoFace v0.21.2 — Atlas AI Discovery teaser patch */
.ai-discovery-teaser{
  display:grid;grid-template-columns:38px 1fr auto;gap:11px;align-items:center;
  margin-top:13px;padding:13px 14px;border-radius:14px;
  border:1px solid rgba(152,114,255,.24);
  background:linear-gradient(135deg,rgba(124,92,255,.085),rgba(255,105,157,.035));
  color:inherit;text-decoration:none;transition:.18s ease;
}
.ai-discovery-teaser:hover{transform:translateY(-1px);border-color:rgba(170,135,255,.38);box-shadow:0 12px 30px rgba(80,55,180,.10)}
.ai-teaser-orb{width:36px;height:36px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,#765aff,#ff6f9e);color:#fff;font-size:15px;box-shadow:0 8px 20px rgba(124,92,255,.20)}
.ai-discovery-teaser>span:nth-child(2){display:grid;gap:2px}.ai-discovery-teaser small{font-size:7px;letter-spacing:.10em;font-style:normal;font-weight:900;color:#a99cff}.ai-discovery-teaser b{font-size:11px}.ai-discovery-teaser em{font-style:normal;font-size:9px;line-height:1.4;color:#7f8da2}.ai-discovery-teaser>strong{font-size:9px;color:#c7bfff;white-space:nowrap}
.ai-discovery-teaser.muted-teaser{border-color:var(--line);background:rgba(255,255,255,.018);opacity:.72}.ai-discovery-teaser.muted-teaser .ai-teaser-orb{background:#20283a;box-shadow:none;color:#8b99ad}.ai-discovery-teaser.muted-teaser small{color:#8290a4}
.ai-history-teaser{display:grid;grid-template-columns:30px 1fr auto;gap:9px;align-items:center;padding:11px 12px;border-radius:12px;border:1px solid rgba(147,110,255,.18);background:rgba(124,92,255,.045);color:inherit;text-decoration:none}.ai-history-teaser>span{width:28px;height:28px;display:grid;place-items:center;border-radius:9px;background:linear-gradient(135deg,#7559ff,#ff6e9d);font-size:11px}.ai-history-teaser>div{display:grid;gap:2px}.ai-history-teaser small{font-size:7px;letter-spacing:.09em;color:#a99cff;font-weight:900}.ai-history-teaser b{font-size:9px}.ai-history-teaser>strong{font-size:8px;color:#b9afff}
.ai-discovery-card{position:relative;overflow:hidden}.ai-discovery-card:before{content:"";position:absolute;right:-90px;top:-90px;width:240px;height:240px;border-radius:50%;background:radial-gradient(circle,rgba(137,91,255,.14),transparent 68%);pointer-events:none}
@media(max-width:620px){.ai-discovery-teaser{grid-template-columns:36px 1fr}.ai-discovery-teaser>strong{grid-column:2}.ai-history-teaser{grid-template-columns:28px 1fr}.ai-history-teaser>strong{grid-column:2}}


/* AutoFace v0.22 — Atlas Introduction Coach */
.atlas-coach{margin-bottom:18px;padding:18px;border:1px solid rgba(151,112,255,.22);border-radius:18px;background:radial-gradient(circle at 100% 0%,rgba(124,92,255,.11),transparent 34%),rgba(124,92,255,.025)}
.atlas-coach-head{display:grid;grid-template-columns:42px 1fr;gap:12px;align-items:start}.atlas-coach-orb{width:40px;height:40px;display:grid;place-items:center;border-radius:13px;background:linear-gradient(135deg,#765aff,#ff6f9e);box-shadow:0 9px 24px rgba(124,92,255,.20)}.atlas-coach-head small{font-size:8px;letter-spacing:.11em;font-weight:900;color:#a99cff}.atlas-coach-head h2{margin:3px 0 4px;font-size:18px}.atlas-coach-head p{margin:0;font-size:10px;line-height:1.5;color:#8391a5}.coach-note{margin-top:14px;padding:12px;border:1px solid var(--line);border-radius:12px;color:#8795a8;font-size:10px}.coach-ready{display:grid;gap:10px;margin-top:14px}.coach-ready .btn{width:max-content}.coach-results{display:grid;gap:12px;margin-top:15px}.coach-results>p{margin:0;color:#9ca9ba;font-size:10px}.coach-starters{display:grid;gap:9px}.coach-starter{padding:14px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.018)}.coach-starter>div{display:flex;align-items:center;gap:8px}.coach-starter small{font-size:7px;letter-spacing:.09em;font-weight:900;color:#9c8fff}.coach-starter b{font-size:10px}.coach-starter blockquote{margin:10px 0 11px;padding:0;border:0;color:#d8dfeb;font-size:12px;line-height:1.55;font-style:normal}.coach-starter .btn{font-size:8px;min-height:31px;padding:0 10px}.coach-regenerate{width:max-content;border:0;background:none;color:#aaa0ff;font-size:9px;font-weight:800;cursor:pointer}.coach-regenerate:disabled{opacity:.5}.atlas-coach .atlas-disclaimer{margin:13px 0 0;padding-top:11px;border-top:1px solid var(--line);font-size:8px!important;line-height:1.45!important;color:#6f7d91!important}
@media(max-width:620px){.atlas-coach{padding:14px}.atlas-coach-head{grid-template-columns:35px 1fr}.atlas-coach-orb{width:34px;height:34px}.coach-ready .btn{width:100%}}


/* AutoFace v0.22.1 — demo mutual introduction harness */
.demo-mutual-card{border-color:rgba(255,184,77,.20);background:linear-gradient(150deg,rgba(255,184,77,.045),rgba(124,92,255,.035))}
.demo-mutual-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start}.demo-mutual-head h3{margin:5px 0 0}.demo-mutual-card>p{font-size:10px;line-height:1.55}
.demo-mutual-select{display:grid;gap:6px;margin:15px 0}.demo-mutual-select>span{font-size:8px;font-weight:900;letter-spacing:.06em;color:#8291a6}.demo-mutual-select select{width:100%;padding:11px;border:1px solid var(--line);border-radius:11px;background:#0a1020;color:var(--text)}
.demo-mutual-preview{display:grid;grid-template-columns:1.4fr .65fr .75fr;gap:8px;margin:12px 0}.demo-mutual-preview>span{display:grid;gap:3px;padding:10px;border:1px solid var(--line);border-radius:11px;background:rgba(255,255,255,.02)}.demo-mutual-preview b{font-size:10px}.demo-mutual-preview small{font-size:7px;color:#718097}
.demo-ai-toggle{margin:13px 0}.demo-mutual-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}.demo-mutual-actions .btn{font-size:9px}
@media(max-width:620px){.demo-mutual-head{display:grid}.demo-mutual-preview{grid-template-columns:1fr}.demo-mutual-actions{display:grid}.demo-mutual-actions .btn{width:100%}}


/* AutoFace v0.22.2 — demo block recovery */
.demo-mutual-preview{grid-template-columns:1.25fr .65fr .72fr .58fr}
.demo-state-ready{color:#91dfc0}.demo-state-blocked{color:#ffc783}.demo-state-mutual{color:#c3b8ff}
.demo-block-panel{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center;margin:13px 0;padding:14px;border-radius:13px;border:1px solid rgba(255,184,77,.24);background:rgba(255,184,77,.045)}
.demo-block-panel>div{display:grid;gap:4px}.demo-block-panel b{font-size:11px;color:#ffd19a}.demo-block-panel span{font-size:9px;line-height:1.5;color:#9c8c75}.demo-clear-block{border-color:rgba(255,184,77,.28);color:#ffd19a;background:rgba(255,184,77,.055);white-space:nowrap}
@media(max-width:760px){.demo-mutual-preview{grid-template-columns:1fr 1fr}.demo-block-panel{grid-template-columns:1fr}.demo-clear-block{width:100%}}
@media(max-width:520px){.demo-mutual-preview{grid-template-columns:1fr}}


/* AutoFace v0.23 — Profile Experience */
.readiness-card{background:linear-gradient(150deg,rgba(124,92,255,.07),rgba(39,209,178,.025))}
.readiness-card .score{margin:10px 0 7px}.readiness-breakdown{display:grid;gap:7px;margin:13px 0}.readiness-breakdown span{display:flex;justify-content:space-between;gap:10px;padding:9px 10px;border:1px solid var(--line);border-radius:10px;background:rgba(255,255,255,.018);font-size:9px}.readiness-breakdown em{font-style:normal;font-weight:900;color:#bcb1ff}.readiness-strong{color:#8de0bd}.readiness-good{color:#c7bbff}.readiness-building{color:#ffd19a}
.facial-coming-soon{border-color:rgba(124,92,255,.2);background:linear-gradient(120deg,rgba(124,92,255,.05),rgba(255,255,255,.01))}.facial-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.facial-principle{display:inline-flex;margin-top:8px;padding:6px 9px;border-radius:999px;border:1px solid rgba(39,209,178,.2);color:#8bd9c2;background:rgba(39,209,178,.035);font-size:8px;font-weight:850;letter-spacing:.03em}


/* AutoFace v0.24 — Atlas Daily Discovery */
.daily-discovery-intro{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;margin:0 0 18px;padding:18px 20px;border:1px solid rgba(124,92,255,.18);border-radius:18px;background:linear-gradient(135deg,rgba(124,92,255,.06),rgba(255,105,157,.02))}
.daily-discovery-intro h2{margin:5px 0 6px;font-size:22px}.daily-discovery-intro p{margin:0;max-width:760px;font-size:10px;line-height:1.6;color:#8f9caf}.daily-count{min-width:92px;display:grid;place-items:center;padding:13px;border-radius:15px;border:1px solid rgba(124,92,255,.17);background:rgba(9,14,26,.5)}.daily-count b{font-size:28px}.daily-count span{font-size:8px;color:#8f9caf;text-transform:uppercase;letter-spacing:.08em}
.daily-discovery-grid{grid-template-columns:repeat(3,minmax(0,1fr));align-items:start}.daily-discovery-card{position:relative;overflow:hidden}.daily-discovery-card:before{content:"";position:absolute;right:-60px;top:-65px;width:170px;height:170px;border-radius:50%;background:radial-gradient(circle,rgba(124,92,255,.08),transparent 70%);pointer-events:none}.daily-rank{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid var(--line)}.daily-rank span{font-size:7px;font-weight:900;letter-spacing:.12em;color:#a79aff}.daily-rank b{font-size:8px;color:#76869a}
.why-atlas-card{display:grid;grid-template-columns:32px 1fr;gap:9px;align-items:start;padding:11px 12px;border:1px solid rgba(124,92,255,.16);border-radius:12px;background:rgba(124,92,255,.035)}.why-atlas-icon{width:30px;height:30px;display:grid;place-items:center;border-radius:10px;background:linear-gradient(135deg,#765aff,#ff6e9d);font-size:11px}.why-atlas-card small{font-size:7px;font-weight:900;letter-spacing:.08em;color:#a99cff}.why-atlas-card p{margin:4px 0 0;font-size:9px!important;line-height:1.45!important;color:#93a0b2}
.daily-discovery-footer{margin-top:16px;text-align:center;padding:16px;border-top:1px solid var(--line)}.daily-discovery-footer span{font-size:10px;font-weight:800}.daily-discovery-footer p{margin:4px 0 0;font-size:9px;color:#77869a}
@media(max-width:1050px){.daily-discovery-grid{grid-template-columns:1fr 1fr}}
@media(max-width:760px){.daily-discovery-intro{grid-template-columns:1fr}.daily-count{width:100%}.daily-discovery-grid{grid-template-columns:1fr}}


/* AutoFace v0.25 — Thoughtful Decisions */
.thoughtful-actions{grid-template-columns:1fr 1.15fr 1fr!important}.save-later-button{border-color:rgba(124,92,255,.28)!important;background:rgba(124,92,255,.045)!important;color:#c8beff!important}.decision-reassurance{margin:8px 0 0!important;font-size:7.5px!important;line-height:1.45!important;text-align:center;color:#6f7d91!important}
.history-filters{display:flex;gap:7px;flex-wrap:wrap;margin:0 0 16px}.history-filters button{appearance:none;border:1px solid var(--line);border-radius:999px;background:rgba(255,255,255,.015);color:#8e9bae;padding:8px 11px;font:inherit;font-size:8px;font-weight:800;cursor:pointer}.history-filters button b{margin-left:5px;color:#c1b7ff}.history-filters button.active{border-color:rgba(124,92,255,.35);background:rgba(124,92,255,.09);color:#ddd7ff}
.reviewed-decision.saved{border-color:rgba(124,92,255,.28);color:#bcb1ff;background:rgba(124,92,255,.06)}.history-decision-actions{display:flex;gap:7px;flex-wrap:wrap;padding-top:10px;border-top:1px solid var(--line)}.history-decision-actions .btn{font-size:8px;padding:7px 10px}.history-filter-empty{text-align:center;padding:28px}.history-filter-empty p{color:#7f8da0;font-size:9px}
@media(max-width:620px){.thoughtful-actions{grid-template-columns:1fr!important}}


/* AutoFace v0.26 — Privacy & Control */
.privacy-control-stack{display:grid;gap:9px;margin:16px 0}.privacy-control-stack .toggle-row{margin:0}
.visibility-never-shared{display:flex;gap:7px;flex-wrap:wrap;margin:14px 0;padding:12px;border:1px solid rgba(69,202,169,.14);border-radius:12px;background:rgba(69,202,169,.025)}.visibility-never-shared small{width:100%;font-size:7px;letter-spacing:.09em;font-weight:900;color:#7dd0b8}.visibility-never-shared span{padding:5px 7px;border-radius:999px;border:1px solid var(--line);font-size:8px;color:#8290a4}
.locked-toggle{opacity:.78}.locked-toggle input{accent-color:#5acba5}.locked-toggle small{color:#7da999!important}


/* AutoFace v0.26.2 — Pricing */
.pricing-hero{padding:88px 0 46px;background:
radial-gradient(circle at 76% 20%,rgba(255,105,157,.10),transparent 30%),
radial-gradient(circle at 20% 10%,rgba(124,92,255,.12),transparent 32%)}
.pricing-hero-inner{max-width:950px}.pricing-hero h1{max-width:850px;margin:16px 0 20px;font-size:clamp(58px,7.5vw,94px);line-height:.94;letter-spacing:-.065em}.pricing-hero h1 span{background:linear-gradient(90deg,#ff78ad,#ae81ff,#65aaff);-webkit-background-clip:text;background-clip:text;color:transparent}.pricing-hero .lead{max-width:760px;font-size:18px;line-height:1.65}
.pricing-beta-banner{display:grid;grid-template-columns:auto 1fr;gap:4px 16px;align-items:center;margin-top:28px;padding:15px 17px;border:1px solid rgba(88,210,174,.22);border-radius:15px;background:rgba(88,210,174,.045)}.pricing-beta-banner span{grid-row:1/3;padding:7px 9px;border-radius:999px;background:rgba(88,210,174,.09);border:1px solid rgba(88,210,174,.20);font-size:8px;font-weight:900;letter-spacing:.09em;color:#8ee1c3}.pricing-beta-banner b{font-size:12px}.pricing-beta-banner small{font-size:9px;color:#8090a4}
.pricing-section{padding-top:30px}.pricing-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;align-items:stretch}.pricing-card{position:relative;display:flex;flex-direction:column;min-height:590px;padding:28px;border-radius:22px;border:1px solid var(--line);background:rgba(255,255,255,.018)}.pricing-card.featured{border-color:rgba(124,92,255,.42);background:linear-gradient(160deg,rgba(124,92,255,.10),rgba(255,105,157,.035));box-shadow:0 24px 70px rgba(56,36,126,.15)}.pricing-popular{position:absolute;right:18px;top:18px;padding:5px 8px;border:1px solid rgba(124,92,255,.25);border-radius:999px;background:rgba(124,92,255,.09);font-size:7px;font-weight:900;letter-spacing:.08em;color:#c7bcff}.pricing-card h2{font-size:30px;margin:6px 0 8px}.pricing-description{min-height:76px;font-size:11px!important;line-height:1.55!important;color:#8c9aaf!important}.pricing-price{display:flex;align-items:baseline;gap:8px;margin:17px 0 19px}.pricing-price strong{font-size:40px;letter-spacing:-.04em}.pricing-price span{font-size:9px;color:#7d8ba0}.pricing-card>.btn{width:100%;justify-content:center;margin-bottom:21px}.pricing-feature-list{display:grid;gap:10px;padding-top:18px;border-top:1px solid var(--line)}.pricing-feature-list span{display:flex;gap:9px;align-items:flex-start;font-size:10px;line-height:1.4;color:#a8b4c6}.pricing-feature-list i{font-style:normal;color:#67d1ad;font-weight:900}
.pricing-principles{display:grid;grid-template-columns:.8fr 1.2fr;gap:28px;margin-top:54px;padding:34px;border-radius:24px;border:1px solid rgba(124,92,255,.16);background:linear-gradient(135deg,rgba(124,92,255,.05),rgba(255,255,255,.012))}.pricing-principles-head h2{font-size:34px;margin:7px 0 10px}.pricing-principles-head p{font-size:11px;line-height:1.6;color:#8896aa}.pricing-principle-grid{display:grid;gap:10px}.pricing-principle{display:grid;grid-template-columns:34px 1fr;gap:11px;padding:14px;border:1px solid var(--line);border-radius:14px;background:rgba(255,255,255,.018)}.pricing-principle>span{width:32px;height:32px;display:grid;place-items:center;border-radius:10px;background:rgba(124,92,255,.09);color:#b6aaff}.pricing-principle h3{margin:0 0 4px;font-size:13px}.pricing-principle p{margin:0!important;font-size:9px!important;line-height:1.5!important}
.pricing-verification{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-top:18px}.pricing-verification h2{font-size:25px;margin:5px 0 7px}.pricing-verification p{max-width:760px;font-size:10px;line-height:1.6}.pricing-faq{max-width:760px;margin:60px auto 20px;text-align:center}.pricing-faq h2{font-size:42px;margin:8px 0 10px}.pricing-faq p{font-size:11px;line-height:1.65;color:#8997aa}.pricing-faq .hero-actions{justify-content:center;margin-top:20px}
@media(max-width:960px){.pricing-grid{grid-template-columns:1fr}.pricing-card{min-height:auto}.pricing-description{min-height:0}.pricing-principles{grid-template-columns:1fr}.pricing-hero{padding-top:62px}}
@media(max-width:620px){.pricing-hero h1{font-size:50px}.pricing-beta-banner{grid-template-columns:1fr}.pricing-beta-banner span{grid-row:auto;justify-self:start}.pricing-card{padding:22px 18px}.pricing-principles{padding:22px 18px}.pricing-verification{display:grid}.pricing-faq h2{font-size:34px}}


/* AutoFace v0.28 — Profile Photo Experience */
.profile-photo-image{display:block;object-fit:cover;background:#101827;border:1px solid rgba(124,92,255,.22)}
.discovery-profile-photo{width:58px;height:58px;border-radius:18px;flex:0 0 58px}
.recommendation-profile-photo{width:82px;height:82px;border-radius:24px;flex:0 0 82px}
.profile-photo-card{background:linear-gradient(155deg,rgba(124,92,255,.055),rgba(255,255,255,.012))}
.photo-manager{display:grid;grid-template-columns:132px 1fr;gap:17px;align-items:start}.photo-manager-preview{width:132px;height:154px;border-radius:20px!important;font-size:34px!important}.photo-manager-copy p{font-size:11px;line-height:1.55;margin:0 0 12px}.photo-manager-copy{display:grid;gap:8px}.photo-upload-button{position:relative;overflow:hidden;justify-content:center}.photo-upload-button input{position:absolute;inset:0;opacity:0;cursor:pointer}.photo-safety-note{display:grid;gap:4px;margin-top:16px;padding:11px 12px;border:1px solid rgba(63,204,169,.16);border-radius:12px;background:rgba(63,204,169,.025)}.photo-safety-note b{font-size:9px;color:#8ad8c0}.photo-safety-note span,.photo-rules{font-size:8px;line-height:1.5;color:#7e8da1}.photo-rules{display:block;margin-top:9px}.profile-preview-photo{width:100%;height:220px;border-radius:18px!important;margin:11px 0 15px;font-size:42px!important}
@media(max-width:560px){.photo-manager{grid-template-columns:1fr}.photo-manager-preview{width:100%;height:260px}}


/* AutoFace v0.28.2 — Profile Visual Refresh */
.profile-hero-gradient{background:linear-gradient(90deg,#ff79ad,#b889ff,#67abff);-webkit-background-clip:text;background-clip:text;color:transparent}
.profile-identity-banner{position:relative;display:grid;grid-template-columns:108px 1fr auto;gap:22px;align-items:center;margin-bottom:22px;padding:22px;border:1px solid rgba(124,92,255,.22);border-radius:22px;background:linear-gradient(120deg,rgba(124,92,255,.10),rgba(255,105,157,.045) 48%,rgba(58,167,255,.035));overflow:hidden}
.profile-identity-banner:after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;right:-75px;top:-110px;background:radial-gradient(circle,rgba(255,105,157,.12),transparent 68%);pointer-events:none}
.profile-identity-photo{width:108px;height:108px;border-radius:24px!important;font-size:34px!important;box-shadow:0 18px 40px rgba(0,0,0,.2)}
.profile-identity-copy h2{margin:4px 0 4px;font-size:32px}.profile-identity-copy p{margin:0;color:#92a0b3;font-size:11px}.profile-identity-badges{display:flex;gap:7px;flex-wrap:wrap;margin-top:13px}.profile-identity-badges span{padding:6px 9px;border-radius:999px;border:1px solid rgba(124,92,255,.22);background:rgba(124,92,255,.065);font-size:8px;color:#c9c1ff;font-weight:800}
.profile-identity-score{position:relative;z-index:1;min-width:118px;padding:15px;border:1px solid rgba(255,105,157,.18);border-radius:17px;background:rgba(9,14,26,.42);text-align:center}.profile-identity-score strong{display:block;font-size:32px;letter-spacing:-.04em;background:linear-gradient(90deg,#ff7eae,#a988ff);-webkit-background-clip:text;background-clip:text;color:transparent}.profile-identity-score span{font-size:8px;color:#8796aa;text-transform:uppercase;letter-spacing:.08em}
.profile-layout-refreshed{grid-template-columns:minmax(0,1.5fr) minmax(330px,.68fr);gap:22px}.profile-form-refreshed{padding:26px;background:linear-gradient(155deg,rgba(255,255,255,.018),rgba(124,92,255,.025))}
.profile-form-heading{display:flex;justify-content:space-between;gap:20px;align-items:flex-start;margin-bottom:18px}.profile-form-heading h2{font-size:32px;margin:5px 0 5px}.profile-form-heading p{margin:0;font-size:10px;color:#8290a4}
.profile-edit-panel{position:relative;margin-top:14px;padding:20px;border:1px solid var(--line);border-radius:17px;overflow:hidden}.profile-edit-panel:before{content:"";position:absolute;inset:0 0 auto 0;height:2px;opacity:.9}.profile-edit-panel-blue{background:linear-gradient(135deg,rgba(58,167,255,.045),rgba(255,255,255,.012))}.profile-edit-panel-blue:before{background:linear-gradient(90deg,#50a8ff,transparent)}.profile-edit-panel-pink{background:linear-gradient(135deg,rgba(255,105,157,.045),rgba(255,255,255,.012))}.profile-edit-panel-pink:before{background:linear-gradient(90deg,#ff6c9e,transparent)}.profile-edit-panel-purple{background:linear-gradient(135deg,rgba(124,92,255,.055),rgba(255,255,255,.012))}.profile-edit-panel-purple:before{background:linear-gradient(90deg,#8065ff,transparent)}
.profile-edit-panel-title{display:flex;gap:11px;align-items:center;margin-bottom:16px}.profile-edit-panel-title>span{width:34px;height:34px;display:grid;place-items:center;border-radius:11px;background:rgba(255,255,255,.045);border:1px solid var(--line);font-size:9px;font-weight:900;color:#c9c2ff}.profile-edit-panel-title small{display:block;font-size:7px;letter-spacing:.11em;color:#7595bd;font-weight:900}.profile-edit-panel-title h3{margin:3px 0 0;font-size:17px}
.profile-actions-sticky{display:flex!important;justify-content:space-between!important;align-items:center;gap:18px;margin-top:20px;padding:16px 18px;border:1px solid rgba(124,92,255,.18);border-radius:15px;background:rgba(124,92,255,.035)}.profile-actions-sticky>div{display:grid;gap:3px}.profile-actions-sticky small{font-size:8px;color:#77869a}.profile-actions-sticky b{font-size:10px}

/* premium photo manager */
.profile-photo-card-premium{position:relative;overflow:hidden;padding:24px;background:linear-gradient(150deg,rgba(102,77,255,.13),rgba(255,88,153,.065) 52%,rgba(32,169,255,.045));border-color:rgba(132,106,255,.28);box-shadow:0 22px 55px rgba(41,26,91,.14)}
.photo-card-glow{position:absolute;right:-80px;top:-90px;width:230px;height:230px;border-radius:50%;background:radial-gradient(circle,rgba(255,102,170,.17),transparent 68%);pointer-events:none}.profile-photo-card-premium .profile-section-head{position:relative;z-index:1}.profile-photo-card-premium h3{font-size:23px!important;line-height:1.05;margin:5px 0 7px}.photo-card-intro{margin:0!important;max-width:340px;font-size:9px!important;line-height:1.55!important;color:#8d9bae!important}.photo-status-pill{border-color:rgba(255,111,166,.25)!important;color:#ffc2d8!important;background:rgba(255,111,166,.06)!important}
.photo-stage{display:grid;grid-template-columns:152px 1fr;gap:16px;align-items:stretch;margin-top:18px}.photo-stage-preview{position:relative}.premium-photo-preview{width:152px;height:188px;border-radius:22px!important;font-size:38px!important;box-shadow:0 18px 38px rgba(0,0,0,.26)}.photo-stage-badge{position:absolute;left:9px;right:9px;bottom:9px;padding:7px;border-radius:999px;background:rgba(4,8,17,.78);backdrop-filter:blur(8px);font-size:6.5px;font-weight:900;letter-spacing:.09em;color:#d7d0ff;text-align:center;border:1px solid rgba(255,255,255,.09)}
.premium-photo-copy{display:grid!important;gap:9px!important}.photo-tip-grid{display:grid;grid-template-columns:1fr;gap:6px}.photo-tip-grid span{display:grid;gap:2px;padding:8px 9px;border:1px solid rgba(255,255,255,.07);border-radius:10px;background:rgba(8,12,24,.35)}.photo-tip-grid b{font-size:8px;color:#dce4f4}.photo-tip-grid small{font-size:7px;color:#77869b}
.photo-dropzone{position:relative;display:grid;grid-template-columns:32px 1fr;column-gap:9px;align-items:center;padding:12px;border:1px dashed rgba(126,111,255,.48);border-radius:13px;background:linear-gradient(120deg,rgba(124,92,255,.10),rgba(58,167,255,.045));cursor:pointer;transition:transform .18s ease,border-color .18s ease,background .18s ease}.photo-dropzone:hover{transform:translateY(-1px);border-color:rgba(255,111,166,.55);background:linear-gradient(120deg,rgba(124,92,255,.15),rgba(255,105,157,.06))}.photo-dropzone input{position:absolute;inset:0;opacity:0;cursor:pointer}.photo-upload-icon{grid-row:1/3;width:31px;height:31px;display:grid;place-items:center;border-radius:10px;background:linear-gradient(135deg,#715cff,#ff6b9f);font-size:17px;font-weight:300}.photo-dropzone b{font-size:9px}.photo-dropzone small{font-size:7px;color:#8492a6}.photo-remove-button{font-size:8px!important;padding:8px 10px!important;color:#9da9ba!important}.photo-message{margin-top:12px!important}
.photo-trust-strip{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:center;margin-top:16px;padding:11px 12px;border:1px solid rgba(69,203,168,.16);border-radius:13px;background:rgba(69,203,168,.028)}.photo-trust-icon{width:32px;height:32px;display:grid;place-items:center;border-radius:10px;background:rgba(69,203,168,.08);color:#75d7ba;font-size:15px}.photo-trust-strip b,.photo-trust-strip small{display:block}.photo-trust-strip b{font-size:8px;color:#9ee1ce}.photo-trust-strip small{margin-top:2px;font-size:7px;line-height:1.45;color:#77899a}
.readiness-card-premium{border-color:rgba(85,189,255,.18)!important;background:linear-gradient(155deg,rgba(58,167,255,.055),rgba(124,92,255,.03))!important}.preview-card-discover{border-color:rgba(255,105,157,.17)!important;background:linear-gradient(160deg,rgba(255,105,157,.04),rgba(124,92,255,.035))!important}.preview-topline{display:flex;justify-content:space-between;gap:10px;align-items:center}.preview-live-dot{font-size:6.5px;font-weight:900;letter-spacing:.08em;color:#79d9ba}.preview-privacy-banner{background:rgba(124,92,255,.06)!important;border-color:rgba(124,92,255,.18)!important}
@media(max-width:980px){.profile-layout-refreshed{grid-template-columns:1fr}.profile-side{grid-template-columns:repeat(2,minmax(0,1fr))}.profile-photo-card-premium{grid-column:1/-1}}
@media(max-width:760px){.profile-identity-banner{grid-template-columns:82px 1fr}.profile-identity-photo{width:82px;height:82px}.profile-identity-score{grid-column:1/-1}.profile-form-heading{display:block}.profile-form-heading .status-pill{margin-top:12px}.profile-actions-sticky{display:grid!important}.photo-stage{grid-template-columns:1fr}.premium-photo-preview{width:100%;height:300px}.profile-side{grid-template-columns:1fr}.profile-photo-card-premium{grid-column:auto}}

/* AutoFace v0.29 — Atlas Introduction Intelligence */
.atlas-intelligence-overview{position:relative;overflow:hidden;padding:24px;border-color:rgba(132,104,255,.27);background:linear-gradient(145deg,rgba(124,92,255,.10),rgba(255,105,157,.045) 48%,rgba(55,174,255,.035));box-shadow:0 22px 55px rgba(35,24,80,.12)}
.atlas-intelligence-overview:after{content:"";position:absolute;right:-90px;top:-120px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(255,102,170,.13),transparent 68%);pointer-events:none}
.atlas-intelligence-heading{position:relative;z-index:1;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:start}.atlas-intelligence-heading h2{margin:6px 0 7px;font-size:27px}.atlas-intelligence-heading p{max-width:650px;margin:0;color:#94a2b5;font-size:11px;line-height:1.65}
.atlas-confidence{min-width:150px;padding:15px;border-radius:16px;border:1px solid rgba(255,255,255,.10);background:rgba(7,11,22,.48);text-align:center}.atlas-confidence small,.atlas-confidence span{display:block}.atlas-confidence small{font-size:7px;letter-spacing:.11em;color:#7e8ca1;font-weight:900}.atlas-confidence strong{display:block;margin:4px 0;font-size:23px}.atlas-confidence span{font-size:7px;color:#8090a5}.atlas-confidence.high strong{color:#77dfbd}.atlas-confidence.good strong{color:#9ecbff}.atlas-confidence.limited strong{color:#ffd094}
.atlas-reason-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px}.atlas-reason-card{min-height:150px;padding:15px;border:1px solid rgba(255,255,255,.075);border-radius:14px;background:rgba(7,11,22,.38)}.atlas-reason-card>span{display:block;margin-bottom:10px;font-size:7px;font-weight:900;letter-spacing:.1em;color:#a98dff}.atlas-reason-card b{font-size:13px}.atlas-reason-card p{margin:7px 0 11px;color:#91a0b4;font-size:9px;line-height:1.55}.atlas-reason-card small{font-size:7px;color:#ff9fbd}
.atlas-confidence-note{position:relative;z-index:1;display:grid;grid-template-columns:32px 1fr;gap:10px;align-items:center;margin-top:12px;padding:11px 13px;border:1px solid rgba(80,201,164,.16);border-radius:13px;background:rgba(80,201,164,.03)}.atlas-confidence-note>span{width:30px;height:30px;display:grid;place-items:center;border-radius:9px;background:rgba(80,201,164,.08);color:#75d8b9}.atlas-confidence-note p{margin:0;font-size:8px;line-height:1.55;color:#8192a6}.atlas-confidence-note b{color:#a5e4d1}
.atlas-intelligence-flow{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:15px;padding-top:15px;border-top:1px solid rgba(255,255,255,.07)}.atlas-intelligence-flow>span{display:grid;grid-template-columns:24px 1fr;column-gap:7px;align-items:center;flex:1}.atlas-intelligence-flow>span>b{grid-row:1/3;width:23px;height:23px;display:grid;place-items:center;border-radius:8px;background:rgba(124,92,255,.12);color:#b9aaff;font-size:8px}.atlas-intelligence-flow small{font-size:6px;letter-spacing:.1em;color:#738399;font-weight:900}.atlas-intelligence-flow strong{font-size:8px;color:#cbd4e1}.atlas-intelligence-flow>i{font-style:normal;color:#5f6d83;font-size:11px}
@media(max-width:760px){.atlas-intelligence-heading{grid-template-columns:1fr}.atlas-confidence{text-align:left}.atlas-reason-grid{grid-template-columns:1fr}.atlas-intelligence-flow{display:grid;grid-template-columns:1fr}.atlas-intelligence-flow>i{display:none}}


/* AutoFace v0.29.1 — Discover Card Layout Patch */
.discovery-grid-wide{
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:20px!important;
  align-items:stretch!important;
}
.discovery-grid-wide .discovery-card-wide{
  min-width:0;
  width:100%;
  padding:22px!important;
  border-radius:20px!important;
}
.discovery-grid-wide .candidate-identity{
  grid-template-columns:74px minmax(0,1fr)!important;
  gap:15px!important;
  align-items:center!important;
}
.discovery-grid-wide .discovery-profile-photo,
.discovery-grid-wide .profile-placeholder{
  width:74px!important;
  height:74px!important;
  min-width:74px!important;
  border-radius:20px!important;
  font-size:24px!important;
}
.discovery-grid-wide .candidate-identity h2{
  font-size:27px!important;
  line-height:1.05!important;
  margin-bottom:4px!important;
}
.discovery-grid-wide .candidate-identity p{
  font-size:10px!important;
  line-height:1.45!important;
}
.discovery-grid-wide .trust-pair{
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:10px!important;
}
.discovery-grid-wide .trust-pair span{
  padding:14px!important;
  min-height:78px!important;
}
.discovery-grid-wide .trust-pair b{
  font-size:25px!important;
}
.discovery-grid-wide .candidate-badges{
  gap:7px!important;
  margin:13px 0!important;
}
.discovery-grid-wide .candidate-badges span{
  font-size:8px!important;
  padding:6px 8px!important;
}
.discovery-grid-wide .candidate-about{
  font-size:11px!important;
  line-height:1.7!important;
  margin:14px 0 16px!important;
}
.discovery-grid-wide .discovery-insights{
  grid-template-columns:1fr 1fr!important;
  gap:10px!important;
}
.discovery-grid-wide .discovery-insights>div{
  padding:14px!important;
  min-height:108px!important;
}
.discovery-grid-wide .discovery-insights small{
  font-size:7px!important;
}
.discovery-grid-wide .discovery-insights p{
  font-size:9px!important;
  line-height:1.55!important;
}
.discovery-grid-wide .why-atlas-card{
  grid-template-columns:38px minmax(0,1fr)!important;
  gap:11px!important;
  padding:14px!important;
}
.discovery-grid-wide .why-atlas-icon{
  width:36px!important;
  height:36px!important;
  border-radius:11px!important;
}
.discovery-grid-wide .why-atlas-card small{
  font-size:7px!important;
}
.discovery-grid-wide .why-atlas-card p{
  font-size:9px!important;
  line-height:1.55!important;
}
.discovery-grid-wide .atlas-ai-discovery-teaser{
  padding:14px!important;
}
.discovery-grid-wide .recommendation-detail-link{
  display:inline-flex!important;
  margin-top:13px!important;
  font-size:9px!important;
}
.discovery-grid-wide .thoughtful-actions{
  grid-template-columns:1fr 1.15fr 1fr!important;
  gap:9px!important;
  margin-top:14px!important;
}
.discovery-grid-wide .thoughtful-actions .btn{
  min-height:48px!important;
  padding:10px 12px!important;
  font-size:10px!important;
  line-height:1.2!important;
}
.discovery-grid-wide .decision-reassurance{
  max-width:92%!important;
  margin:10px auto 0!important;
  font-size:7.5px!important;
  line-height:1.5!important;
}
.discovery-grid-wide .daily-rank{
  margin-bottom:13px!important;
  padding-bottom:11px!important;
}
.discovery-grid-wide .test-profile-pill{
  margin-bottom:13px!important;
}

/* One recommendation should still look intentional rather than compressed. */
.discovery-grid-wide:has(.discovery-card-wide:only-child){
  grid-template-columns:minmax(0,760px)!important;
}

/* Give Discover more usable width on large desktop screens. */
@media(min-width:1200px){
  .discovery-section .container,
  .discover-section .container{
    max-width:1280px!important;
  }
}

@media(max-width:980px){
  .discovery-grid-wide{
    grid-template-columns:1fr!important;
  }
  .discovery-grid-wide .discovery-card-wide{
    max-width:760px;
  }
}

@media(max-width:620px){
  .discovery-grid-wide .candidate-identity{
    grid-template-columns:62px minmax(0,1fr)!important;
  }
  .discovery-grid-wide .discovery-profile-photo,
  .discovery-grid-wide .profile-placeholder{
    width:62px!important;
    height:62px!important;
    min-width:62px!important;
  }
  .discovery-grid-wide .candidate-identity h2{
    font-size:23px!important;
  }
  .discovery-grid-wide .discovery-insights{
    grid-template-columns:1fr!important;
  }
  .discovery-grid-wide .thoughtful-actions{
    grid-template-columns:1fr!important;
  }
}


/* AutoFace v0.29.2 — Discover CTA + Readability */
.discovery-grid-wide .recommendation-detail-button{
  display:grid!important;
  grid-template-columns:38px minmax(0,1fr) 24px;
  align-items:center;
  gap:11px;
  width:100%;
  margin:15px 0 0!important;
  padding:13px 14px!important;
  border:1px solid rgba(128,99,255,.34)!important;
  border-radius:13px;
  background:linear-gradient(115deg,rgba(124,92,255,.12),rgba(255,105,157,.055));
  color:#eef1ff!important;
  text-decoration:none!important;
  box-shadow:0 10px 26px rgba(46,29,103,.10);
  transition:transform .16s ease,border-color .16s ease,background .16s ease;
}
.discovery-grid-wide .recommendation-detail-button:hover{
  transform:translateY(-1px);
  border-color:rgba(255,108,162,.46)!important;
  background:linear-gradient(115deg,rgba(124,92,255,.17),rgba(255,105,157,.08));
}
.recommendation-detail-icon{
  width:36px;
  height:36px;
  display:grid;
  place-items:center;
  border-radius:11px;
  background:linear-gradient(135deg,#745dff,#ff6fa4);
  color:white;
  font-size:14px;
}
.recommendation-detail-copy{
  display:grid;
  gap:2px;
  min-width:0;
}
.recommendation-detail-copy small{
  font-size:7px!important;
  letter-spacing:.10em;
  font-weight:900;
  color:#a99dff;
}
.recommendation-detail-copy b{
  font-size:11px!important;
  line-height:1.25;
  color:#f4f6ff;
}
.recommendation-detail-arrow{
  justify-self:end;
  font-size:17px;
  color:#bcb3ff;
}

/* General Discover readability uplift */
.discovery-grid-wide .daily-rank span,
.discovery-grid-wide .daily-rank b{
  font-size:8px!important;
}
.discovery-grid-wide .candidate-about{
  font-size:12px!important;
  line-height:1.7!important;
}
.discovery-grid-wide .discovery-insights small,
.discovery-grid-wide .why-atlas-card small{
  font-size:8px!important;
}
.discovery-grid-wide .discovery-insights p,
.discovery-grid-wide .why-atlas-card p{
  font-size:10px!important;
  line-height:1.55!important;
}
.discovery-grid-wide .atlas-ai-discovery-teaser small{
  font-size:8px!important;
}
.discovery-grid-wide .atlas-ai-discovery-teaser b,
.discovery-grid-wide .atlas-ai-discovery-teaser p{
  font-size:9px!important;
  line-height:1.45!important;
}
.discovery-grid-wide .decision-reassurance{
  font-size:8px!important;
}

@media(max-width:620px){
  .discovery-grid-wide .recommendation-detail-button{
    grid-template-columns:34px minmax(0,1fr) 20px;
    padding:12px!important;
  }
  .recommendation-detail-icon{
    width:32px;
    height:32px;
  }
}

/* AutoFace v0.30 — Sikh Community launch direction */
.sikh-world-section{padding:76px 0 82px;position:relative;overflow:hidden}.sikh-world-head em{font-style:normal;background:linear-gradient(90deg,#ff779d,#8e79ff,#55b9ff);-webkit-background-clip:text;color:transparent}.sikh-world-card{margin-top:28px;border:1px solid rgba(126,102,255,.23);border-radius:24px;background:radial-gradient(circle at 48% 42%,rgba(103,76,220,.10),transparent 35%),linear-gradient(145deg,rgba(14,18,34,.92),rgba(8,12,24,.96));overflow:hidden;box-shadow:0 30px 80px rgba(0,0,0,.18)}.sikh-map{padding:16px 30px 0}.sikh-map svg{display:block;width:100%;height:auto;max-height:430px}.map-land{fill:rgba(108,124,164,.12);stroke:rgba(135,150,188,.18);stroke-width:2}.map-link{fill:none;stroke:url(#none);stroke:#7765dc;stroke-width:1.5;stroke-dasharray:5 8;opacity:.38}.map-point circle{fill:#ff719d;stroke:#11172a;stroke-width:4}.map-point .pulse{fill:none;stroke:#806cff;stroke-width:2;opacity:.45}.map-point text{fill:#e8eafa;font-size:15px;font-weight:800}.map-point text.sub{fill:#8795ad;font-size:9px;font-weight:600}.map-point.uk circle:first-child{fill:#8d72ff}.sikh-world-footer{display:flex;justify-content:center;flex-wrap:wrap;gap:13px;padding:0 20px 13px;color:#d9dced;font-size:11px;font-weight:800}.sikh-world-footer i{color:#ff719d;font-style:normal}.sikh-world-note{max-width:620px;margin:0 auto;padding:0 24px 23px;text-align:center;color:#6f7d94;font-size:8px;line-height:1.5}
@media(max-width:700px){.sikh-world-section{padding:52px 0}.sikh-map{padding:10px 4px 0}.map-point text{font-size:20px}.map-point text.sub{display:none}}

/* AutoFace v0.30.1 — Sikh identity & lifestyle profile */
.profile-edit-panel-sikh{background:linear-gradient(135deg,rgba(255,139,49,.055),rgba(124,92,255,.035),rgba(255,255,255,.012));border-color:rgba(255,144,66,.18)}
.profile-edit-panel-sikh:before{background:linear-gradient(90deg,#ff944e,#8a72ff,transparent)}
.profile-edit-panel-sikh .profile-edit-panel-title>span{color:#ffd0ac;border-color:rgba(255,148,78,.18);background:rgba(255,148,78,.07)}
.sikh-profile-note{display:grid;grid-template-columns:34px 1fr;gap:10px;align-items:center;margin-top:14px;padding:12px 13px;border:1px solid rgba(113,204,174,.15);border-radius:13px;background:rgba(113,204,174,.028)}
.sikh-profile-note>span{width:32px;height:32px;display:grid;place-items:center;border-radius:10px;background:rgba(113,204,174,.08);color:#7ad7bb}
.sikh-profile-note b,.sikh-profile-note small{display:block}.sikh-profile-note b{font-size:9px;color:#a8e4d2}.sikh-profile-note small{margin-top:3px;font-size:7.5px;line-height:1.5;color:#7f8ea2}


/* AutoFace v0.30.2 — Homepage statement typography consistency */
.experience-principle{
  padding:64px 0 68px!important;
}
.experience-quote{
  max-width:1000px!important;
  margin:0 auto!important;
  padding:52px 30px!important;
  text-align:center!important;
}
.experience-quote blockquote,
.experience-final h2{
  max-width:960px!important;
  margin:18px auto 12px!important;
  font-size:clamp(44px,5vw,62px)!important;
  line-height:1.06!important;
  letter-spacing:-.045em!important;
  font-weight:800!important;
  text-align:center!important;
}
.experience-quote p,
.experience-final p{
  max-width:760px!important;
  margin:0 auto!important;
  color:#8d9aae!important;
  font-size:14px!important;
  line-height:1.6!important;
  text-align:center!important;
}
.experience-quote .experience-section-label,
.experience-final .experience-section-label{
  display:block!important;
  margin-bottom:16px!important;
  font-size:9px!important;
  letter-spacing:.16em!important;
  font-weight:900!important;
  text-align:center!important;
}
.experience-final{
  padding:72px 0 88px!important;
}
.experience-final-inner{
  max-width:1000px!important;
  margin:0 auto!important;
  text-align:center!important;
}
.experience-final .experience-actions{
  justify-content:center!important;
  margin-top:26px!important;
}
@media(max-width:700px){
  .experience-principle{padding:48px 0 52px!important}
  .experience-quote{padding:38px 14px!important}
  .experience-quote blockquote,
  .experience-final h2{
    font-size:clamp(34px,10vw,46px)!important;
    line-height:1.08!important;
  }
  .experience-quote p,
  .experience-final p{
    font-size:13px!important;
  }
  .experience-final{padding:56px 0 68px!important}
}

/* AutoFace v0.30.3 — Development Reset & Sikh Test Data */
.dev-tools-layout{display:grid;grid-template-columns:1fr 1fr;gap:18px}.dev-tools-card{padding:24px}.dev-tools-card h2{margin:6px 0 8px;font-size:27px}.dev-tools-card>p{color:#8c9aae;font-size:10px;line-height:1.6}.dev-reset-card{border-color:rgba(255,112,151,.18);background:linear-gradient(145deg,rgba(255,105,157,.045),rgba(255,255,255,.012))}.dev-seed-card{border-color:rgba(124,92,255,.22);background:linear-gradient(145deg,rgba(124,92,255,.055),rgba(61,169,255,.025))}
.dev-reset-flow{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:18px 0}.dev-reset-flow span{display:grid;grid-template-columns:45px 1fr;gap:7px;align-items:center;padding:9px;border:1px solid rgba(255,255,255,.065);border-radius:10px;font-size:8px;color:#9aa7b8}.dev-reset-flow b{font-size:6px;letter-spacing:.08em;color:#7bd6ba}.dev-reset-flow span:nth-child(n+3) b{color:#ff9db9}
.dev-seed-people{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin:17px 0}.dev-seed-people span{padding:9px 10px;border:1px solid rgba(124,92,255,.12);border-radius:10px;background:rgba(124,92,255,.035);font-size:8px;color:#aeb7ca}.dev-action-row{display:flex;gap:9px;flex-wrap:wrap}.dev-action{margin-top:4px}.dev-warning{grid-column:1/-1;display:grid;grid-template-columns:36px 1fr;gap:11px;align-items:center;padding:14px 16px;border-color:rgba(255,186,99,.17);background:rgba(255,186,99,.025)}.dev-warning>span{width:34px;height:34px;display:grid;place-items:center;border-radius:10px;background:rgba(255,186,99,.07)}.dev-warning b{font-size:9px;color:#ffd19a}.dev-warning p{margin:3px 0 0;font-size:8px;line-height:1.5;color:#7f8da1}.dev-tools-message{grid-column:1/-1}.dev-denied{padding:28px}
@media(max-width:800px){.dev-tools-layout{grid-template-columns:1fr}.dev-reset-flow,.dev-seed-people{grid-template-columns:1fr}}

/* AutoFace v0.30.5 — Richer profiles + career preferences */
.candidate-person-card{margin:14px 0;padding:15px;border:1px solid rgba(86,164,255,.13);border-radius:14px;background:linear-gradient(135deg,rgba(66,157,255,.035),rgba(124,92,255,.03))}
.candidate-person-heading{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:8px}.candidate-person-heading small{font-size:7px;letter-spacing:.1em;font-weight:900;color:#73b9ff}.candidate-person-heading b{font-size:8px;color:#9eacc0}
.candidate-person-card .candidate-about{margin:0 0 12px!important;font-size:11px!important;line-height:1.65!important}.candidate-life-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.candidate-life-grid>span{display:grid;gap:2px;padding:10px;border:1px solid rgba(255,255,255,.06);border-radius:10px;background:rgba(5,9,19,.28)}.candidate-life-grid small{font-size:6.5px;letter-spacing:.09em;color:#7c8ba0;font-weight:900}.candidate-life-grid b{font-size:9px;color:#dce4f2}.candidate-life-grid em{font-size:7px;color:#8190a3;font-style:normal;text-transform:capitalize}
.candidate-community-pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}.candidate-community-pills span{padding:6px 8px;border-radius:999px;border:1px solid rgba(124,92,255,.16);background:rgba(124,92,255,.045);font-size:7px;color:#b7b1df;font-weight:800}.candidate-community-pills .career-fit-pill{border-color:rgba(74,202,167,.20);background:rgba(74,202,167,.055);color:#93dcc8}
.preference-career{margin:18px 0;padding:17px;border:1px solid rgba(91,157,255,.14);border-radius:14px;background:linear-gradient(135deg,rgba(66,157,255,.035),rgba(124,92,255,.025))}.preference-career h3{margin:5px 0 6px}.preference-career>p{font-size:9px;line-height:1.5}.preference-profession-grid{display:grid;grid-template-columns:1fr 1fr;gap:6px;margin:10px 0 14px}.compact-toggle{padding:8px!important;min-height:auto!important}.compact-toggle span b{font-size:8px!important}
@media(max-width:620px){.candidate-life-grid,.preference-profession-grid{grid-template-columns:1fr}.candidate-person-heading{display:block}.candidate-person-heading b{display:block;margin-top:4px}}


/* AutoFace v0.30.6 — Engaging Discover profile traits */
.candidate-person-card-vivid{
  position:relative;
  overflow:hidden;
  border-color:rgba(128,98,255,.22)!important;
  background:linear-gradient(145deg,rgba(92,67,199,.08),rgba(20,27,47,.80) 44%,rgba(53,132,209,.045))!important;
}
.candidate-person-card-vivid:before{
  content:"";
  position:absolute;
  inset:0 auto 0 0;
  width:3px;
  background:linear-gradient(#885fff,#ff6eaa,#55b9ff);
  opacity:.85;
}
.candidate-about-highlight{
  display:grid;
  grid-template-columns:28px minmax(0,1fr);
  gap:10px;
  align-items:start;
  margin:8px 0 15px;
  padding:14px 15px;
  border:1px solid rgba(255,103,169,.18);
  border-radius:13px;
  background:linear-gradient(110deg,rgba(255,98,164,.08),rgba(124,92,255,.07),rgba(52,176,255,.045));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.025);
}
.candidate-about-highlight>svg{
  margin-top:2px;
  padding:6px;
  width:28px;height:28px;
  color:#ff8ab6;
  border-radius:9px;
  background:rgba(255,105,157,.09);
}
.candidate-about-highlight .candidate-about{
  margin:0!important;
  color:#f0f3fb!important;
  font-size:11.5px!important;
  line-height:1.7!important;
  font-weight:600;
}
.candidate-trait-title{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin:2px 0 9px;
}
.candidate-trait-title small{
  font-size:7px;
  letter-spacing:.11em;
  font-weight:900;
  color:#8f7cff;
}
.candidate-trait-title span{
  font-size:7px;
  color:#718096;
}
.candidate-trait-icons{
  display:grid;
  grid-template-columns:repeat(5,minmax(0,1fr));
  gap:7px;
  margin-bottom:12px;
}
.trait-icon-card{
  min-width:0;
  min-height:96px;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  padding:9px 6px;
  text-align:center;
  border:1px solid rgba(255,255,255,.07);
  border-radius:12px;
  background:rgba(7,12,24,.38);
}
.trait-icon-card>span{
  width:35px;height:35px;
  display:grid;
  place-items:center;
  margin-bottom:2px;
  border-radius:11px;
}
.trait-icon-card b{
  max-width:100%;
  font-size:8px;
  line-height:1.2;
  color:#e5eaf4;
  overflow-wrap:anywhere;
}
.trait-icon-card small{
  max-width:100%;
  font-size:6.5px;
  line-height:1.25;
  color:#7f8da2;
  text-transform:capitalize;
  overflow-wrap:anywhere;
}
.trait-education{border-color:rgba(144,107,255,.19)}.trait-education>span{background:rgba(135,99,255,.10);color:#a48cff}
.trait-profession{border-color:rgba(63,161,255,.19)}.trait-profession>span{background:rgba(63,161,255,.10);color:#67b8ff}
.trait-appearance{border-color:rgba(49,211,197,.17)}.trait-appearance>span{background:rgba(49,211,197,.09);color:#61d7cc}
.trait-diet{border-color:rgba(105,202,107,.17)}.trait-diet>span{background:rgba(105,202,107,.09);color:#83d77d}
.trait-practice{border-color:rgba(255,182,64,.18)}.trait-practice>span{background:rgba(255,182,64,.09);color:#ffc15c}
@media(max-width:900px){
  .candidate-trait-icons{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media(max-width:520px){
  .candidate-trait-icons{grid-template-columns:repeat(2,minmax(0,1fr))}
}

/* AutoFace v0.30.7 — Lifestyle & Introduction Preferences */
.profile-hobbies{margin-top:18px;padding-top:16px;border-top:1px solid rgba(255,255,255,.06)}.profile-hobbies-title{display:flex;justify-content:space-between;align-items:end;margin-bottom:10px}.profile-hobbies-title small{font-size:7px;letter-spacing:.11em;color:#ff9b58;font-weight:900}.profile-hobbies-title h4{margin:3px 0 0;font-size:14px}.profile-hobbies-title>span{font-size:7px;color:#718096}.hobby-chip-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}.hobby-chip{border:1px solid rgba(255,255,255,.07);border-radius:11px;background:rgba(7,12,24,.35);color:#9ca9bc;padding:9px 5px;display:flex;min-height:64px;flex-direction:column;align-items:center;justify-content:center;gap:4px;cursor:pointer}.hobby-chip span{font-size:18px}.hobby-chip b{font-size:7.5px}.hobby-chip.selected,.preference-interest-chip.selected{border-color:rgba(130,98,255,.48);background:linear-gradient(135deg,rgba(124,92,255,.17),rgba(62,168,255,.09));color:#eeeaff}.preference-lifestyle{margin:18px 0;padding:17px;border:1px solid rgba(255,145,73,.15);border-radius:14px;background:linear-gradient(135deg,rgba(255,139,49,.035),rgba(124,92,255,.025))}.preference-lifestyle h3{margin:5px 0 6px}.preference-lifestyle>p{font-size:9px}.preference-two-col{display:grid;grid-template-columns:1fr 1fr;gap:10px}.preference-interest-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;margin:8px 0 14px}.preference-interest-chip{border:1px solid rgba(255,255,255,.07);border-radius:10px;background:rgba(7,12,24,.35);color:#9ca9bc;padding:9px 6px;font-size:7.5px;cursor:pointer}.preference-interest-chip span{font-size:13px;margin-right:5px}@media(max-width:700px){.hobby-chip-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.preference-interest-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.preference-two-col{grid-template-columns:1fr}}


/* AutoFace v0.30.8 — Atlas Profile Intelligence */
.atlas-profile-intelligence{padding:24px;border-color:rgba(71,180,255,.19);background:linear-gradient(145deg,rgba(52,162,255,.055),rgba(124,92,255,.055) 48%,rgba(255,101,157,.025));overflow:hidden}
.profile-intelligence-heading{display:flex;justify-content:space-between;align-items:start;gap:20px}.profile-intelligence-heading h2{margin:6px 0 7px;font-size:25px}.profile-intelligence-heading p{max-width:650px;margin:0;color:#93a2b6;font-size:10px;line-height:1.6}.profile-context-pill{flex:0 0 auto;padding:7px 9px;border:1px solid rgba(86,174,255,.16);border-radius:999px;background:rgba(70,164,255,.05);font-size:6.5px;letter-spacing:.08em;font-weight:900;color:#81bded}
.profile-alignment-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:17px}.profile-alignment-card{min-width:0;padding:13px 11px;border:1px solid rgba(255,255,255,.07);border-radius:13px;background:rgba(6,11,22,.37)}.profile-alignment-top{display:flex;align-items:center;justify-content:space-between;gap:5px;margin-bottom:11px}.profile-alignment-top>small{font-size:6px;letter-spacing:.08em;font-weight:900;color:#8290a4}.profile-alignment-dots{display:flex;gap:3px}.profile-alignment-dots i{width:6px;height:6px;border-radius:50%;background:#283248}.profile-alignment-dots i.filled{background:#8070ff;box-shadow:0 0 8px rgba(128,112,255,.25)}.profile-alignment-card.strong .profile-alignment-dots i.filled{background:#65d7b4}.profile-alignment-card.explore .profile-alignment-dots i.filled{background:#ff9b75}.profile-alignment-card>b{display:block;font-size:10px;color:#e7eaf3;margin-bottom:6px}.profile-alignment-card>p{min-height:58px;margin:0 0 8px;font-size:7.7px;line-height:1.5;color:#8c9bae}.profile-evidence{display:block;padding-top:7px;border-top:1px solid rgba(255,255,255,.05);font-size:6.5px;line-height:1.4;color:#6f8097}
.profile-intelligence-details{display:grid;grid-template-columns:1fr auto;gap:14px;margin-top:14px;padding:14px;border:1px solid rgba(255,255,255,.06);border-radius:13px;background:rgba(6,11,22,.25)}.profile-intelligence-details small{font-size:6.5px;letter-spacing:.09em;font-weight:900;color:#75869e}.profile-context-chips{display:flex;flex-wrap:wrap;gap:5px;margin-top:7px}.profile-context-chips span{padding:5px 7px;border-radius:999px;border:1px solid rgba(128,97,255,.14);background:rgba(128,97,255,.045);font-size:6.5px;color:#aca5d3;text-transform:capitalize}.profile-height-context{max-width:240px;padding-left:14px;border-left:1px solid rgba(255,255,255,.07)}.profile-height-context p{margin:5px 0 0;font-size:7.5px;line-height:1.45;color:#92a0b2}.profile-intelligence-notice{margin-top:13px!important}
@media(max-width:950px){.profile-alignment-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.profile-alignment-grid .profile-alignment-card:last-child{grid-column:1/-1}.profile-intelligence-details{grid-template-columns:1fr}.profile-height-context{max-width:none;padding-left:0;padding-top:11px;border-left:0;border-top:1px solid rgba(255,255,255,.07)}}
@media(max-width:620px){.profile-intelligence-heading{display:block}.profile-context-pill{display:inline-block;margin-top:10px}.profile-alignment-grid{grid-template-columns:1fr}.profile-alignment-grid .profile-alignment-card:last-child{grid-column:auto}.profile-alignment-card>p{min-height:0}}

/* AutoFace v0.30.8.3 — Profile Identity & Test Readiness */
.dev-readiness-card{grid-column:1/-1;padding:21px;border-color:rgba(73,190,160,.17);background:linear-gradient(135deg,rgba(73,190,160,.035),rgba(70,143,255,.025),rgba(124,92,255,.025))}
.dev-readiness-heading{display:flex;justify-content:space-between;gap:16px;align-items:start}.dev-readiness-heading h2{margin:5px 0 0;font-size:23px}.dev-readiness-card>p{font-size:9px;line-height:1.55;color:#8391a5}.ready-pill{color:#82d9bd!important;border-color:rgba(73,190,160,.22)!important}.attention-pill{color:#ffc27d!important;border-color:rgba(255,176,85,.20)!important}.dev-readiness-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px;margin:14px 0}.dev-readiness-grid>span{display:grid;grid-template-columns:24px 1fr;gap:6px;align-items:center;padding:10px;border:1px solid rgba(255,255,255,.06);border-radius:10px;background:rgba(6,11,22,.28)}.dev-readiness-grid b{width:22px;height:22px;display:grid;place-items:center;border-radius:7px;font-size:9px}.dev-readiness-grid em{font-style:normal;font-size:7.5px;line-height:1.3;color:#97a5b7}.dev-readiness-grid .ok b{background:rgba(73,190,160,.09);color:#76d7ba}.dev-readiness-grid .bad b{background:rgba(255,146,103,.09);color:#ff9b76}.dev-readiness-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.dev-readiness-note{display:block;margin-top:11px;font-size:7px;line-height:1.45;color:#6f7f94}
@media(max-width:900px){.dev-readiness-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:540px){.dev-readiness-grid{grid-template-columns:1fr}.dev-readiness-heading{display:block}.dev-readiness-heading>.status-pill{display:inline-block;margin-top:8px}}


/* AutoFace v0.30.8.5 — Homepage profile-to-introduction flow */
.autoface-how-flow{padding:82px 0;position:relative;overflow:hidden;background:linear-gradient(180deg,transparent,rgba(75,62,155,.025),transparent)}
.autoface-how-head em{font-style:normal;background:linear-gradient(90deg,#ff779d,#8e79ff,#55b9ff);-webkit-background-clip:text;color:transparent}
.autoface-flow-line{display:grid;grid-template-columns:1fr 34px 1fr 34px 1fr 34px 1fr;gap:0;align-items:stretch;margin-top:34px}
.autoface-flow-step{position:relative;min-width:0;padding:20px 17px 18px;border:1px solid rgba(255,255,255,.075);border-radius:17px;background:linear-gradient(145deg,rgba(15,21,38,.82),rgba(8,13,25,.88));box-shadow:inset 0 1px 0 rgba(255,255,255,.02)}
.flow-number{display:inline-flex;align-items:center;justify-content:center;min-width:27px;height:20px;padding:0 6px;border-radius:999px;border:1px solid rgba(132,105,255,.18);background:rgba(132,105,255,.055);font-size:6.5px;letter-spacing:.09em;font-weight:900;color:#9b8bff}
.flow-icon{width:44px;height:44px;display:grid;place-items:center;margin:17px 0 12px;border-radius:14px;border:1px solid rgba(255,255,255,.07)}
.flow-profile{color:#61b9ff;background:rgba(61,185,255,.07)}.flow-atlas{color:#a988ff;background:rgba(140,102,255,.08)}.flow-discover{color:#61d6c3;background:rgba(73,199,179,.07)}.flow-interest{color:#ff80a8;background:rgba(255,103,155,.07)}
.autoface-flow-step h3{margin:0 0 3px;font-size:17px}.autoface-flow-step b{display:block;font-size:8px;color:#b6c0d1}.autoface-flow-step p{margin:8px 0 0;font-size:8px;line-height:1.55;color:#77879d}
.flow-connector{display:grid;place-items:center;color:#4f5c76}.flow-connector svg{opacity:.7}
.autoface-mutual-stage{display:grid;grid-template-columns:150px 1fr 250px 1fr 150px;gap:0;align-items:center;margin:34px 0 0;padding:24px 28px;border:1px solid rgba(255,102,158,.14);border-radius:20px;background:radial-gradient(circle at 50% 50%,rgba(132,92,255,.10),transparent 37%),linear-gradient(145deg,rgba(255,94,150,.025),rgba(11,16,31,.84))}
.mutual-side{display:grid;grid-template-columns:auto 20px;grid-template-rows:auto auto;column-gap:6px;align-items:center;padding:12px 13px;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(7,12,23,.45)}
.mutual-side span{grid-column:1/-1;font-size:6px;letter-spacing:.10em;color:#74849a;font-weight:900}.mutual-side svg{color:#ff7aa5}.mutual-side b{font-size:8px;color:#dfe5f0}
.mutual-path{position:relative;height:52px}.mutual-path i{position:absolute;right:0;width:82%;height:1px;background:linear-gradient(90deg,rgba(255,112,159,.15),rgba(135,99,255,.85));transform-origin:right}.mutual-path i:first-child{top:19px;transform:rotate(9deg)}.mutual-path i:last-child{bottom:19px;transform:rotate(-9deg)}
.mutual-path-right i{left:0;right:auto;background:linear-gradient(90deg,rgba(135,99,255,.85),rgba(255,112,159,.15));transform-origin:left}.mutual-path-right i:first-child{transform:rotate(-9deg)}.mutual-path-right i:last-child{transform:rotate(9deg)}
.mutual-centre{text-align:center}.mutual-centre .flow-icon{margin:10px auto 8px}.flow-mutual{color:#ff9bba;background:linear-gradient(135deg,rgba(255,91,151,.11),rgba(132,95,255,.10));box-shadow:0 0 28px rgba(132,95,255,.09)}.mutual-centre h3{margin:0;font-size:18px}.mutual-centre p{max-width:230px;margin:6px auto 0;font-size:8px;line-height:1.55;color:#8593a8}
.autoface-introduction-finish{position:relative;padding-top:30px}.finish-line{position:absolute;left:50%;top:0;width:1px;height:30px;background:linear-gradient(rgba(132,95,255,.9),rgba(255,107,154,.55))}
.autoface-introduction-finish article{max-width:720px;margin:0 auto;display:grid;grid-template-columns:40px 50px 1fr;gap:13px;align-items:center;padding:17px 20px;border:1px solid rgba(255,127,169,.20);border-radius:17px;background:linear-gradient(110deg,rgba(255,102,157,.07),rgba(129,93,255,.08),rgba(52,164,255,.045));box-shadow:0 20px 55px rgba(0,0,0,.12)}
.autoface-introduction-finish .flow-icon{margin:0}.flow-message{color:#ff9bbc;background:rgba(255,101,157,.09)}.autoface-introduction-finish h3{margin:0 0 2px;font-size:17px}.autoface-introduction-finish b{font-size:9px;color:#c5ccda}.autoface-introduction-finish p{margin:5px 0 0;font-size:8px;line-height:1.5;color:#7d8da3}
.autoface-flow-principle{max-width:760px;margin:22px auto 0;display:flex;justify-content:center;gap:9px;align-items:center;padding:11px 14px;text-align:center;color:#8998aa;font-size:8px}.autoface-flow-principle svg{flex:0 0 auto;color:#6dd5b5}.autoface-flow-principle b{color:#cbd2df}
@media(max-width:980px){.autoface-flow-line{grid-template-columns:1fr 22px 1fr;row-gap:18px}.autoface-flow-step:nth-of-type(3){grid-column:1}.autoface-flow-step:nth-of-type(4){grid-column:3}.flow-connector:nth-of-type(3){display:none}.autoface-mutual-stage{grid-template-columns:120px 1fr 220px 1fr 120px}}
@media(max-width:760px){.autoface-how-flow{padding:58px 0}.autoface-flow-line{grid-template-columns:1fr;gap:10px}.flow-connector{height:20px;transform:rotate(90deg)}.autoface-flow-step{padding:17px}.autoface-mutual-stage{grid-template-columns:1fr;gap:10px;padding:18px}.mutual-path{height:24px}.mutual-path i{left:50%;right:auto;width:1px;height:24px;background:linear-gradient(rgba(255,112,159,.2),rgba(135,99,255,.8));transform:none!important}.mutual-path i:last-child{display:none}.mutual-path-right i{left:50%}.mutual-side{max-width:220px;width:100%;margin:auto}.autoface-introduction-finish article{grid-template-columns:32px 46px 1fr;padding:15px}.autoface-flow-principle{align-items:flex-start;text-align:left}}


/* AutoFace v0.31 — My Introductions */
.introductions-hero{padding-bottom:34px}.intro-summary-strip{display:flex;gap:9px;flex-wrap:wrap;margin-top:24px}.intro-summary-strip>span{display:grid;grid-template-columns:22px 28px 1fr;align-items:center;gap:5px;min-width:165px;padding:10px 13px;border:1px solid rgba(255,255,255,.07);border-radius:12px;background:rgba(9,14,27,.4)}.intro-summary-strip svg{color:#9a82ff}.intro-summary-strip b{font-size:17px}.intro-summary-strip small{font-size:7px;color:#8392a6}
.introductions-section{padding-top:28px}.intro-tabs{display:flex;gap:7px;padding:5px;width:max-content;max-width:100%;border:1px solid rgba(255,255,255,.07);border-radius:13px;background:rgba(7,12,23,.42);margin-bottom:18px}.intro-tabs button{display:flex;align-items:center;gap:7px;padding:9px 12px;border:0;border-radius:9px;background:transparent;color:#8493a8;font:inherit;font-size:8px;font-weight:800;cursor:pointer}.intro-tabs button span{min-width:18px;padding:2px 5px;border-radius:999px;background:rgba(255,255,255,.05);font-size:6.5px}.intro-tabs button.active{color:#e9eaf2;background:linear-gradient(135deg,rgba(121,92,255,.13),rgba(57,150,255,.08));box-shadow:inset 0 0 0 1px rgba(130,103,255,.14)}
.intro-journey-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.intro-journey-card{padding:19px;overflow:hidden}.intro-card-top{display:flex;justify-content:space-between;align-items:start}.intro-profile-photo{width:58px!important;height:58px!important}.intro-card-status{display:flex;align-items:center;gap:9px;margin:14px 0 10px;padding:10px 11px;border:1px solid rgba(128,96,255,.10);border-radius:10px;background:rgba(128,96,255,.035);color:#9b84ff}.intro-card-status div{display:grid}.intro-card-status small{font-size:6px;letter-spacing:.08em;color:#74849a;font-weight:900}.intro-card-status b{margin-top:2px;font-size:8px;color:#c7cede}.intro-mini-signals{display:grid;grid-template-columns:1fr 1fr;gap:6px}.intro-mini-signals span{display:grid;padding:8px 10px;border:1px solid rgba(255,255,255,.055);border-radius:9px;background:rgba(5,10,20,.24)}.intro-mini-signals b{font-size:13px}.intro-mini-signals small{font-size:6.5px;color:#75859b}
.intro-progress{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin:17px 0 15px}.intro-progress span{position:relative;text-align:center}.intro-progress span:before{content:"";position:absolute;top:5px;left:-50%;width:100%;height:1px;background:#273148}.intro-progress span:first-child:before{display:none}.intro-progress i{position:relative;z-index:1;display:block;width:10px;height:10px;margin:0 auto 6px;border-radius:50%;background:#273148;border:2px solid #101727}.intro-progress small{display:block;font-size:5.6px;line-height:1.2;color:#65758b}.intro-progress span.complete:before{background:linear-gradient(90deg,#7c68ff,#55b9ff)}.intro-progress span.complete i{background:#806cff;box-shadow:0 0 9px rgba(128,108,255,.35)}.intro-progress span.complete small{color:#a5b1c2}.intro-open-button{width:100%;display:flex!important;align-items:center;justify-content:center;gap:8px}.intro-reassurance{display:flex;gap:7px;align-items:flex-start;margin:13px 0 0;padding:10px;border-radius:9px;background:rgba(71,188,158,.04);font-size:7.5px;line-height:1.5;color:#7e8fa4}.intro-reassurance svg{flex:0 0 auto;color:#65cfb0}.intro-review-button{width:100%;margin-top:13px;text-align:center}.intro-empty-state{text-align:center;padding:40px 24px}.intro-empty-icon{width:52px;height:52px;display:grid;place-items:center;margin:0 auto 12px;border-radius:16px;background:rgba(126,96,255,.07);color:#9b83ff}.intro-empty-state h2{margin:6px 0}.intro-empty-state p{max-width:570px;margin:0 auto 17px;color:#8392a6;font-size:9px;line-height:1.55}.intro-principle{display:flex;align-items:flex-start;gap:13px;margin-top:20px;padding:18px;border-color:rgba(94,201,172,.13);background:linear-gradient(130deg,rgba(73,190,160,.035),rgba(112,82,255,.025))}.intro-principle>svg{color:#68d2b4;flex:0 0 auto}.intro-principle small{font-size:6px;letter-spacing:.09em;color:#6d7e94;font-weight:900}.intro-principle h3{margin:3px 0 4px;font-size:13px}.intro-principle p{margin:0;font-size:8px;line-height:1.5;color:#7e8da1}
@media(max-width:800px){.intro-journey-grid{grid-template-columns:1fr}.intro-summary-strip>span{flex:1}.intro-tabs{width:100%;overflow-x:auto}.intro-tabs button{flex:1;justify-content:center;white-space:nowrap}}
@media(max-width:520px){.intro-summary-strip{display:grid;grid-template-columns:1fr}.intro-progress small{font-size:5px}.intro-journey-card{padding:15px}}


/* AutoFace v0.32 — Guided Onboarding & Readiness */
.onboarding-hero{padding-bottom:44px}.onboarding-hero-grid{display:grid;grid-template-columns:1fr 180px;gap:32px;align-items:center}.onboarding-next-cta{display:inline-flex!important;align-items:center;gap:8px;margin-top:18px}.onboarding-progress-orb{position:relative;width:152px;height:152px;display:flex;flex-direction:column;align-items:center;justify-content:center;margin-left:auto;border-radius:50%;background:radial-gradient(circle,rgba(18,24,43,.98) 60%,transparent 61%);text-align:center}.onboarding-progress-orb strong{position:relative;z-index:2;font-size:31px}.onboarding-progress-orb>span{position:relative;z-index:2;font-size:7px;color:#7e8fa5}.onboarding-orb-ring{position:absolute;inset:0;border-radius:50%;background:conic-gradient(#816cff var(--progress),rgba(255,255,255,.07) 0);mask:radial-gradient(circle,transparent 64%,#000 65%);-webkit-mask:radial-gradient(circle,transparent 64%,#000 65%);box-shadow:0 0 35px rgba(128,105,255,.12)}
.onboarding-section{padding-top:30px}.onboarding-layout{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:18px}.onboarding-main,.onboarding-side{display:grid;gap:14px;align-content:start}.onboarding-roadmap{padding:22px}.onboarding-card-head{display:flex;justify-content:space-between;gap:14px;align-items:start}.onboarding-card-head h2{margin:5px 0 0;font-size:22px}.onboarding-rail{margin-top:18px}.onboarding-rail-step{position:relative;display:grid;grid-template-columns:42px 1fr 45px;gap:11px;align-items:center;padding:10px 5px;color:inherit;text-decoration:none}.onboarding-step-marker{position:relative;z-index:2;width:38px;height:38px;display:grid;place-items:center;border-radius:12px;border:1px solid rgba(255,255,255,.08);background:#0c1323;color:#667990}.onboarding-step-line{position:absolute;left:23px;top:-17px;width:1px;height:25px;background:#273047}.onboarding-rail-step:first-child .onboarding-step-line{display:none}.onboarding-step-copy{display:grid;gap:2px}.onboarding-step-copy small{font-size:6px;letter-spacing:.08em;color:#63758b;font-weight:900}.onboarding-step-copy b{font-size:10px;color:#d7dde8}.onboarding-step-copy p{margin:1px 0 0;font-size:7.5px;line-height:1.45;color:#7f8fa4}.onboarding-rail-step>strong{justify-self:end;font-size:6px;letter-spacing:.07em;color:#68798f}.onboarding-rail-step.complete .onboarding-step-marker{border-color:rgba(70,198,164,.22);background:rgba(70,198,164,.07);color:#73d5b8}.onboarding-rail-step.complete .onboarding-step-line{background:#55bfa0}.onboarding-rail-step.complete>strong{color:#6dccae}.onboarding-rail-step.current{margin:4px 0;padding:12px;border:1px solid rgba(129,101,255,.16);border-radius:12px;background:linear-gradient(130deg,rgba(129,101,255,.06),rgba(49,158,255,.03))}.onboarding-rail-step.current .onboarding-step-marker{border-color:rgba(129,101,255,.28);background:rgba(129,101,255,.10);color:#a38fff;box-shadow:0 0 24px rgba(129,101,255,.10)}.onboarding-rail-step.current>strong{color:#a48fff}
.onboarding-detail-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.onboarding-detail-card{display:grid;grid-template-columns:30px 1fr;gap:7px;padding:15px}.onboarding-detail-card>svg{margin-top:2px}.onboarding-detail-card small{font-size:6px;letter-spacing:.08em;font-weight:900;color:#697b92}.onboarding-detail-card b{display:block;margin-top:2px;font-size:10px}.onboarding-detail-card p{min-height:55px;margin:5px 0 8px;font-size:7px;line-height:1.45;color:#74859a}.onboarding-detail-card>a{grid-column:2;font-size:7px;text-decoration:none;color:#8f82da}.profile-detail>svg{color:#5db8ff}.atlas-detail>svg{color:#9e84ff}.trust-detail>svg{color:#69d0b3}
.onboarding-after-ready{padding:20px}.onboarding-after-ready h2{margin:5px 0 14px}.after-ready-flow{display:grid;grid-template-columns:1fr 25px 1fr 25px 1fr;align-items:center;margin-bottom:14px}.after-ready-flow>span{display:grid;grid-template-columns:24px 1fr;gap:3px 6px;padding:11px;border:1px solid rgba(255,255,255,.06);border-radius:11px}.after-ready-flow svg{grid-row:1/3;color:#8d77ff}.after-ready-flow b{font-size:8px}.after-ready-flow small{font-size:6.5px;line-height:1.35;color:#728399}.after-ready-flow>i{text-align:center;color:#47546a;font-style:normal}
.onboarding-next-card,.onboarding-control-card{padding:19px}.onboarding-next-icon{width:47px;height:47px;display:grid;place-items:center;margin:12px 0;border-radius:14px;background:linear-gradient(135deg,rgba(128,96,255,.11),rgba(52,165,255,.07));color:#9b83ff}.onboarding-next-card h3,.onboarding-control-card h3{margin:0 0 6px;font-size:16px}.onboarding-next-card p,.onboarding-control-card p{font-size:8px;line-height:1.55;color:#8190a4}.onboarding-next-card .btn{display:flex!important;justify-content:center;align-items:center;gap:7px;margin-top:12px}.onboarding-intro-count{display:grid;grid-template-columns:32px 1fr auto;gap:8px;align-items:center;padding:14px}.onboarding-intro-count>svg{color:#ff88ae}.onboarding-intro-count div{display:grid}.onboarding-intro-count strong{font-size:18px}.onboarding-intro-count span{font-size:7px;color:#7e8da1}.onboarding-intro-count>a{font-size:7px;color:#a58ef4;text-decoration:none}
@media(max-width:950px){.onboarding-layout{grid-template-columns:1fr}.onboarding-side{grid-template-columns:repeat(2,1fr)}.onboarding-side .beta-feedback-card{grid-column:1/-1}}
@media(max-width:760px){.onboarding-hero-grid{grid-template-columns:1fr}.onboarding-progress-orb{margin:10px auto 0}.onboarding-detail-grid{grid-template-columns:1fr}.after-ready-flow{grid-template-columns:1fr;gap:7px}.after-ready-flow>i{transform:rotate(90deg)}.onboarding-side{grid-template-columns:1fr}.onboarding-side .beta-feedback-card{grid-column:auto}}
@media(max-width:520px){.onboarding-roadmap{padding:15px}.onboarding-rail-step{grid-template-columns:38px 1fr}.onboarding-rail-step>strong{grid-column:2;justify-self:start}.onboarding-step-line{left:19px}.onboarding-card-head{display:block}.onboarding-card-head>.status-pill{display:inline-block;margin-top:8px}}


/* AutoFace v0.33 — Guided profile-to-discovery journey */
.member-journey-shell{border-top:1px solid rgba(255,255,255,.035);border-bottom:1px solid rgba(255,255,255,.045);background:rgba(7,11,22,.28)}
.member-journey{display:grid;grid-template-columns:repeat(4,1fr);gap:0;padding:13px 0}
.member-journey-step{position:relative;display:grid;grid-template-columns:36px 1fr;gap:9px;align-items:center;padding:8px 16px}.member-journey-step>i{position:absolute;right:-1px;top:50%;width:24px;height:1px;background:#283149;transform:translateX(50%)}.member-journey-step:last-child>i{display:none}.member-journey-marker{width:34px;height:34px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.07);border-radius:11px;background:#0c1221;color:#65758a}.member-journey-step>div:nth-child(2){display:grid}.member-journey-step small{font-size:5.5px;letter-spacing:.08em;font-weight:900;color:#56677e}.member-journey-step b{font-size:8.5px;color:#aab5c5}.member-journey-step span{font-size:6.5px;color:#66788e}.member-journey-step.complete .member-journey-marker{color:#70d2b5;border-color:rgba(72,195,162,.18);background:rgba(72,195,162,.055)}.member-journey-step.complete b{color:#b9c5d4}.member-journey-step.complete>i{background:#52b99b}.member-journey-step.active{border-radius:11px;background:linear-gradient(135deg,rgba(124,92,255,.07),rgba(53,160,255,.035))}.member-journey-step.active .member-journey-marker{color:#a08aff;border-color:rgba(132,100,255,.25);background:rgba(132,100,255,.10);box-shadow:0 0 22px rgba(132,100,255,.08)}.member-journey-step.active b{color:#eceaf8}
.journey-complete-card{display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center;margin:14px 0;padding:16px;border:1px solid rgba(76,202,169,.17);border-radius:13px;background:linear-gradient(120deg,rgba(76,202,169,.045),rgba(127,92,255,.045))}.journey-complete-card h3{margin:4px 0 4px;font-size:15px}.journey-complete-card p{margin:0;max-width:620px;font-size:8px;line-height:1.5;color:#8090a5}.journey-next-button{white-space:nowrap}
.discovery-guided-lock{padding:28px!important}.discover-readiness-list{max-width:700px;display:grid;gap:6px;margin:18px 0}.discover-readiness-list a{display:grid;grid-template-columns:26px 1fr auto;align-items:center;gap:8px;padding:9px 11px;border:1px solid rgba(255,255,255,.06);border-radius:9px;text-decoration:none;color:#b4bdca;background:rgba(7,12,23,.28)}.discover-readiness-list a>span{width:22px;height:22px;display:grid;place-items:center;border-radius:7px;background:rgba(255,145,95,.06);color:#ff9e78}.discover-readiness-list a.complete>span{background:rgba(72,195,162,.07);color:#72d2b5}.discover-readiness-list b{font-size:8px}.discover-readiness-list small{font-size:6.5px;color:#75859a}.discover-readiness-list a.complete{opacity:.68}
.simple-journey-card{padding:21px}.simple-journey-card h2{margin:5px 0 16px}.simple-journey-grid{display:grid;grid-template-columns:1fr 28px 1fr 28px 1fr;align-items:center}.simple-journey-grid>div{position:relative;min-height:120px;padding:16px;border:1px solid rgba(255,255,255,.065);border-radius:12px;background:rgba(7,12,23,.3)}.simple-journey-grid>div>span{position:absolute;right:10px;top:9px;font-size:7px;color:#58687f}.simple-journey-grid svg{color:#987fff;margin-bottom:9px}.simple-journey-grid b{display:block;font-size:10px}.simple-journey-grid p{margin:5px 0 0;font-size:7px;line-height:1.5;color:#78899f}.simple-journey-grid>i{text-align:center;font-style:normal;color:#445269}
@media(max-width:780px){.member-journey{grid-template-columns:1fr 1fr}.member-journey-step>i{display:none}.journey-complete-card{grid-template-columns:1fr}.simple-journey-grid{grid-template-columns:1fr;gap:7px}.simple-journey-grid>i{transform:rotate(90deg)}}
@media(max-width:520px){.member-journey{grid-template-columns:1fr}.member-journey-step{padding:7px 10px}.member-journey-step span{display:none}}


/* AutoFace v0.33.2 — My Journey readability polish */
.onboarding-roadmap{padding:26px}
.onboarding-rail-step{padding:14px 8px;grid-template-columns:46px 1fr 58px;gap:13px}
.onboarding-step-marker{width:42px;height:42px;border-radius:13px}
.onboarding-step-line{left:28px;top:-20px;height:31px}

.onboarding-step-copy small{
  font-size:8px;
  line-height:1.3;
  letter-spacing:.09em;
}
.onboarding-step-copy b{
  font-size:12px;
  line-height:1.35;
}
.onboarding-step-copy p{
  margin-top:3px;
  font-size:10px;
  line-height:1.55;
  max-width:680px;
}
.onboarding-rail-step>strong{
  font-size:8px;
  line-height:1.2;
}

.onboarding-detail-card{
  padding:18px;
  grid-template-columns:34px 1fr;
  gap:10px;
}
.onboarding-detail-card small{
  font-size:8px;
  line-height:1.3;
}
.onboarding-detail-card b{
  font-size:12px;
  line-height:1.35;
}
.onboarding-detail-card p{
  min-height:68px;
  font-size:9.5px;
  line-height:1.58;
}
.onboarding-detail-card>a{
  font-size:8.5px;
}

.simple-journey-card{padding:24px}
.simple-journey-grid>div{min-height:145px;padding:19px}
.simple-journey-grid>div>span{font-size:8px}
.simple-journey-grid b{
  font-size:12px;
  line-height:1.35;
}
.simple-journey-grid p{
  font-size:9.5px;
  line-height:1.58;
}

.onboarding-next-card p,
.onboarding-control-card p{
  font-size:9.5px;
  line-height:1.58;
}
.onboarding-intro-count span{
  font-size:8.5px;
}
.beta-feedback-card p,
.beta-feedback-card label,
.beta-feedback-card textarea,
.beta-feedback-card select{
  font-size:9.5px;
  line-height:1.5;
}

@media(max-width:760px){
  .onboarding-rail-step{padding:12px 6px}
  .onboarding-step-copy p{font-size:9.5px}
  .onboarding-detail-card p{min-height:0}
}


/* AutoFace v0.33.3 — Discovery resilience */
.discovery-account-error{padding:30px!important;border-color:rgba(255,158,103,.18)!important;background:linear-gradient(135deg,rgba(255,134,91,.035),rgba(126,91,255,.03))!important}
.discovery-account-error h2{max-width:720px}
.discovery-account-error p{max-width:760px;font-size:10px;line-height:1.6}
.account-error-note{margin-top:14px!important;color:#718198!important;font-size:8px!important}
.stale-profile-notice{margin-bottom:14px}


/* AutoFace v0.33.4 — My Introductions readability polish */
.introductions-stats .stat-card,
.introduction-stats .stat-card,
.introductions-summary-card{
  min-height:54px;
  padding:13px 16px;
}
.introductions-stats .stat-card strong,
.introduction-stats .stat-card strong,
.introductions-summary-card strong{
  font-size:15px;
  line-height:1.2;
}
.introductions-stats .stat-card span,
.introduction-stats .stat-card span,
.introductions-summary-card span{
  font-size:9px;
  line-height:1.4;
}

.introductions-tabs,
.introduction-tabs{
  min-height:48px;
  padding:5px;
}
.introductions-tabs button,
.introductions-tabs a,
.introduction-tabs button,
.introduction-tabs a{
  min-height:38px;
  padding:9px 14px;
  font-size:10px;
  line-height:1.25;
  gap:7px;
}
.introductions-tabs button span,
.introductions-tabs a span,
.introduction-tabs button span,
.introduction-tabs a span{
  font-size:8px;
}

@media(max-width:700px){
  .introductions-stats .stat-card span,
  .introduction-stats .stat-card span,
  .introductions-summary-card span{font-size:8.5px}
  .introductions-tabs button,
  .introductions-tabs a,
  .introduction-tabs button,
  .introduction-tabs a{font-size:9.5px;padding:9px 11px}
}


/* AutoFace v0.33.5 — Development Tools readability + reviewed-profile reset */
.dev-tools-card{
  padding:24px;
}
.dev-tools-card h2,
.dev-readiness-card h2{
  font-size:24px;
  line-height:1.25;
}
.dev-tools-card>p,
.dev-readiness-card>p,
.dev-denied p{
  font-size:11px;
  line-height:1.6;
  color:#91a0b4;
}
.dev-reset-flow,
.dev-seed-people,
.dev-review-reset-summary{
  gap:9px;
  margin:17px 0;
}
.dev-reset-flow span,
.dev-seed-people span,
.dev-review-reset-summary span{
  min-height:40px;
  padding:10px 13px;
  font-size:9.5px;
  line-height:1.35;
}
.dev-reset-flow span b,
.dev-review-reset-summary span b{
  min-width:46px;
  font-size:7.5px;
  letter-spacing:.08em;
}
.dev-action{
  min-height:44px;
  padding:11px 17px;
  font-size:11px;
}
.dev-readiness-grid{
  gap:9px;
}
.dev-readiness-grid>span{
  min-height:48px;
  padding:11px 12px;
}
.dev-readiness-grid em{
  font-size:9px;
  line-height:1.35;
}
.dev-readiness-grid b{
  font-size:10px;
}
.dev-readiness-note{
  font-size:8.5px;
  line-height:1.55;
}
.dev-discovery-reset-card{
  border-color:rgba(96,180,255,.16);
  background:linear-gradient(135deg,rgba(63,155,255,.035),rgba(126,90,255,.035));
}
.dev-review-reset-summary{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
}
.dev-review-reset-summary span{
  display:flex;
  align-items:center;
  gap:9px;
  border:1px solid rgba(255,255,255,.06);
  border-radius:10px;
  background:rgba(7,12,23,.30);
}
.dev-review-reset-summary span b{
  color:#ff9e7c;
}
.dev-review-reset-summary span:nth-child(n+4) b{
  color:#72d2b5;
}

@media(max-width:700px){
  .dev-tools-card{padding:18px}
  .dev-tools-card h2,.dev-readiness-card h2{font-size:21px}
  .dev-tools-card>p,.dev-readiness-card>p{font-size:10.5px}
  .dev-review-reset-summary{grid-template-columns:1fr}
}


/* AutoFace v0.34.0 — deterministic test environment */
.dev-factory-card{grid-column:1/-1;border-color:rgba(255,116,116,.20)!important;background:linear-gradient(135deg,rgba(255,92,92,.045),rgba(126,90,255,.025))!important}
.dev-factory-card>p{max-width:930px}
.dev-factory-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:18px 0}
.dev-factory-grid span{display:flex;align-items:center;gap:9px;min-height:43px;padding:10px 12px;border:1px solid rgba(255,255,255,.06);border-radius:10px;background:rgba(7,12,23,.28);font-size:9.5px;color:#9eabba}
.dev-factory-grid b{min-width:45px;font-size:7px;letter-spacing:.08em;color:#ff8d8d}
.dev-factory-grid span:first-child b{color:#72d2b5}
.dev-factory-warning{margin:12px 0 15px;padding:11px 13px;border:1px solid rgba(255,174,99,.14);border-radius:10px;background:rgba(255,151,79,.035);font-size:9px;line-height:1.5;color:#9d8e82}
.dev-factory-warning b{color:#ffb172}
.dev-factory-button{min-width:230px}

.dev-seed-health{margin-top:16px;padding-top:15px;border-top:1px solid rgba(255,255,255,.06)}
.dev-seed-health-summary{display:grid;grid-template-columns:48px 1fr auto;gap:8px;align-items:center;margin-bottom:9px}
.dev-seed-health-summary>b{font-size:19px;color:#e5e8ef}
.dev-seed-health-summary>span{font-size:9px;color:#8796a9}
.dev-seed-health-summary>em{font-style:normal;font-size:7px;font-weight:900;letter-spacing:.08em;color:#72d2b5}
.dev-seed-health-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px}
.dev-seed-health-list>div{display:grid;grid-template-columns:24px 88px 1fr;gap:5px;align-items:center;padding:9px 10px;border:1px solid rgba(255,255,255,.055);border-radius:9px;background:rgba(7,12,23,.24)}
.dev-seed-health-list>div>span{width:20px;height:20px;display:grid;place-items:center;border-radius:6px;background:rgba(72,195,162,.07);color:#72d2b5;font-size:8px}
.dev-seed-health-list>div.unhealthy>span{background:rgba(255,111,111,.07);color:#ff8a8a}
.dev-seed-health-list b{font-size:9px}.dev-seed-health-list small{font-size:8px;color:#75869b}
.dev-seed-health-list em{grid-column:2/-1;font-style:normal;font-size:7px;color:#65778e}
.dev-seed-health-list .unhealthy em{color:#e18b8b}

@media(max-width:800px){
  .dev-factory-grid{grid-template-columns:1fr 1fr}
  .dev-seed-health-list{grid-template-columns:1fr}
}
@media(max-width:520px){
  .dev-factory-grid{grid-template-columns:1fr}
  .dev-seed-health-list>div{grid-template-columns:24px 80px 1fr}
}


/* AutoFace v0.34.1 — structured Atlas relationship choices */
.relationship-tiles-intro{max-width:760px;margin:8px 0 18px;font-size:10px;line-height:1.6;color:#8796aa}
.relationship-tile-question{margin:20px 0 24px;padding:18px;border:1px solid rgba(255,255,255,.065);border-radius:14px;background:linear-gradient(135deg,rgba(9,15,28,.50),rgba(122,92,255,.018))}
.relationship-tile-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;margin-bottom:12px}
.relationship-tile-head>div{display:grid;gap:3px}.relationship-tile-head label{font-size:12px;font-weight:800;color:#f1f1f5}.relationship-tile-head small{font-size:8px;color:#718299}.relationship-tile-head>strong{min-width:36px;padding:5px 8px;text-align:center;border:1px solid rgba(132,99,255,.16);border-radius:999px;background:rgba(132,99,255,.06);font-size:8px;color:#a792ff}
.relationship-choice-grid{display:flex;flex-wrap:wrap;gap:8px}
.relationship-choice{display:flex;align-items:center;gap:7px;min-height:39px;padding:9px 13px;border:1px solid rgba(255,255,255,.075);border-radius:11px;background:#0b1221;color:#aeb9c9;font:inherit;font-size:9.5px;font-weight:700;cursor:pointer;transition:border-color .16s ease,background .16s ease,color .16s ease,transform .16s ease}
.relationship-choice:hover{border-color:rgba(128,104,255,.28);color:#e5e4ee;transform:translateY(-1px)}
.relationship-choice>span{width:19px;height:19px;display:grid;place-items:center;border-radius:6px;background:rgba(255,255,255,.045);font-size:8px;color:#71839b}
.relationship-choice.selected{border-color:rgba(126,99,255,.34);background:linear-gradient(135deg,rgba(126,99,255,.13),rgba(67,161,255,.065));color:#f2f0fa;box-shadow:0 8px 25px rgba(65,56,144,.10)}
.relationship-choice.selected>span{background:rgba(126,99,255,.18);color:#b9a9ff}
.relationship-context-field{margin-top:22px;padding-top:18px;border-top:1px solid rgba(255,255,255,.055)}
.relationship-context-field label{font-size:11px}
@media(max-width:620px){.relationship-tile-question{padding:14px}.relationship-choice{font-size:9px;padding:8px 10px}.relationship-tile-head{display:grid}.relationship-tile-head>strong{justify-self:start}}


/* AutoFace v0.34.2 — Discover readiness readability */
.discover-readiness-list{
  gap:9px;
  margin:20px 0;
}
.discover-readiness-list a{
  min-height:52px;
  padding:12px 14px;
  grid-template-columns:30px 1fr auto;
  gap:11px;
}
.discover-readiness-list a>span{
  width:26px;
  height:26px;
  border-radius:8px;
  font-size:10px;
}
.discover-readiness-list b{
  font-size:11px;
  line-height:1.35;
}
.discover-readiness-list small{
  font-size:8.5px;
  line-height:1.3;
  padding-left:10px;
}
.discovery-guided-lock>p{
  font-size:10.5px;
  line-height:1.65;
}
.discovery-guided-lock .privacy-kicker{
  font-size:8px;
}
@media(max-width:640px){
  .discover-readiness-list a{
    min-height:50px;
    padding:11px 12px;
    grid-template-columns:28px 1fr;
  }
  .discover-readiness-list small{
    grid-column:2;
    padding-left:0;
    font-size:8px;
  }
  .discover-readiness-list b{
    font-size:10.5px;
  }
}


/* AutoFace v0.34.3 — engaging empty Discovery state */
.discovery-waiting-experience{display:grid;gap:15px}
.discovery-live-state{position:relative;overflow:hidden;padding:30px!important;text-align:left!important;background:radial-gradient(circle at 90% 10%,rgba(116,91,255,.09),transparent 32%),linear-gradient(135deg,rgba(10,17,31,.9),rgba(8,14,27,.88))!important}
.discovery-live-state>h2{max-width:760px;margin:7px 0 8px;font-size:25px}
.discovery-live-state>p{max-width:820px;margin:0;font-size:10.5px;line-height:1.65;color:#8d9caf}
.discovery-live-orb{position:absolute;right:25px;top:22px;width:50px;height:50px;display:grid;place-items:center;border-radius:50%;background:radial-gradient(circle,rgba(132,105,255,.22),rgba(75,52,171,.04));border:1px solid rgba(140,112,255,.16);box-shadow:0 0 32px rgba(111,86,255,.10)}
.discovery-live-orb span{color:#a58fff;font-size:17px}
.discovery-live-checks{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
.discovery-live-checks span{display:flex;align-items:center;gap:7px;min-height:38px;padding:8px 11px;border:1px solid rgba(77,200,166,.13);border-radius:10px;background:rgba(72,196,161,.035)}
.discovery-live-checks b{width:20px;height:20px;display:grid;place-items:center;border-radius:6px;background:rgba(74,201,165,.08);font-size:8px;color:#70d1b5}
.discovery-live-checks small{font-size:8.5px;color:#a3afbf;font-weight:700}
.discovery-wait-actions{display:flex;gap:8px;flex-wrap:wrap}
.discovery-no-filler{display:flex;gap:9px;align-items:flex-start;max-width:800px;margin-top:17px;padding:11px 12px;border:1px solid rgba(129,102,255,.10);border-radius:10px;background:rgba(129,102,255,.025);color:#7d8da3}
.discovery-no-filler svg{flex:0 0 auto;color:#a18cff;margin-top:1px}.discovery-no-filler span{font-size:8.5px;line-height:1.5}.discovery-no-filler b{color:#aeb9c9}

.while-you-wait-card{padding:24px;border-color:rgba(90,183,255,.12)!important;background:linear-gradient(130deg,rgba(54,148,255,.035),rgba(126,89,255,.035))!important}
.while-you-wait-heading{display:grid;grid-template-columns:48px 1fr auto;gap:12px;align-items:center}
.while-you-wait-heading h2{margin:3px 0 3px;font-size:20px}.while-you-wait-heading p{margin:0;max-width:780px;font-size:9.5px;line-height:1.55;color:#8797ab}.while-you-wait-heading p b{color:#b7c2d0}
.while-you-wait-icon{width:44px;height:44px;display:grid;place-items:center;border:1px solid rgba(107,174,255,.14);border-radius:13px;background:rgba(78,150,255,.055);color:#77b9ff}
.while-you-wait-progress{min-width:48px;padding:7px 9px;border:1px solid rgba(255,255,255,.06);border-radius:999px;text-align:center;font-size:8px;color:#8494aa;background:rgba(7,12,23,.35)}
.this-or-that-game{max-width:840px;margin:19px auto 0;padding:18px;border:1px solid rgba(255,255,255,.06);border-radius:14px;background:rgba(7,12,23,.32)}
.this-or-that-prompt{text-align:center}.this-or-that-prompt small{display:block;font-size:7px;letter-spacing:.1em;color:#6f8198;font-weight:900}.this-or-that-prompt b{display:block;margin-top:4px;font-size:13px}
.this-or-that-options{display:grid;grid-template-columns:1fr 42px 1fr;align-items:center;gap:8px;margin:15px 0}
.this-or-that-options button{min-height:82px;display:grid;place-items:center;gap:4px;padding:14px;border:1px solid rgba(255,255,255,.075);border-radius:13px;background:linear-gradient(135deg,rgba(20,30,50,.85),rgba(12,19,35,.9));color:#d7dde8;cursor:pointer;transition:transform .15s ease,border-color .15s ease,background .15s ease}
.this-or-that-options button:hover{transform:translateY(-2px);border-color:rgba(129,103,255,.35);background:linear-gradient(135deg,rgba(126,98,255,.10),rgba(49,151,255,.06))}
.this-or-that-options button span{width:24px;height:24px;display:grid;place-items:center;border-radius:8px;background:rgba(129,103,255,.08);font-size:7px;color:#9f8cff}.this-or-that-options button b{font-size:11px}
.this-or-that-or{text-align:center;font-size:7px;font-weight:900;color:#596b83}
.this-or-that-note{display:flex;align-items:flex-start;justify-content:center;gap:6px;margin:0;font-size:7.5px;line-height:1.45;color:#697b92}.this-or-that-note svg{flex:0 0 auto;color:#8f7aff}.this-or-that-note b{color:#8192a7}
.this-or-that-complete{text-align:center;max-width:700px;margin:20px auto 0;padding:22px;border:1px solid rgba(72,198,164,.10);border-radius:14px;background:rgba(72,198,164,.025)}.this-or-that-confetti{font-size:22px;color:#9e87ff}.this-or-that-complete h3{margin:5px 0;font-size:16px}.this-or-that-complete p{margin:0 auto 13px;max-width:560px;font-size:8.5px;line-height:1.5;color:#8090a5}.this-or-that-complete .btn{display:inline-flex!important;align-items:center;gap:6px}
.this-or-that-summary{display:flex;justify-content:center;flex-wrap:wrap;gap:6px;margin-bottom:13px}.this-or-that-summary span{padding:6px 9px;border:1px solid rgba(255,255,255,.06);border-radius:999px;background:rgba(255,255,255,.025);font-size:7px;color:#8999ad}
@media(max-width:680px){.discovery-live-orb{display:none}.discovery-live-state{padding:22px!important}.while-you-wait-heading{grid-template-columns:42px 1fr}.while-you-wait-progress{grid-column:2;justify-self:start}.this-or-that-options{grid-template-columns:1fr}.this-or-that-or{padding:2px}.this-or-that-options button{min-height:66px}.discovery-live-checks{display:grid;grid-template-columns:1fr}}


/* AutoFace v0.34.4 — landing community map blue treatment */
.community-map,
.world-map,
.landing-map,
.global-community-map,
.community-network-map,
.sikh-community-map{
  background:
    radial-gradient(circle at 50% 34%,rgba(59,130,246,.22),transparent 35%),
    radial-gradient(circle at 18% 18%,rgba(37,99,235,.18),transparent 28%),
    linear-gradient(145deg,#071d4a 0%,#0a2f78 48%,#071a43 100%) !important;
  border-color:rgba(73,143,255,.30) !important;
  box-shadow:inset 0 0 70px rgba(37,99,235,.10),0 24px 80px rgba(0,33,92,.16);
}
.community-map svg,
.world-map svg,
.landing-map svg,
.global-community-map svg,
.community-network-map svg,
.sikh-community-map svg{
  filter:drop-shadow(0 8px 24px rgba(0,36,110,.20));
}


/* v0.34.4 exact landing-map selectors */
.sikh-world-card{
  background:
    radial-gradient(circle at 50% 30%,rgba(71,130,255,.25),transparent 38%),
    radial-gradient(circle at 16% 18%,rgba(34,102,230,.18),transparent 30%),
    linear-gradient(145deg,#071d4a 0%,#0a2f78 50%,#071a43 100%) !important;
  border-color:rgba(74,137,255,.32) !important;
  box-shadow:inset 0 0 72px rgba(44,111,235,.12),0 24px 80px rgba(0,31,94,.17);
}
.sikh-map{
  background:transparent !important;
}
.sikh-map .map-land{
  fill:rgba(52,105,205,.24) !important;
  stroke:rgba(117,166,255,.32) !important;
}
.sikh-map .map-link{
  stroke:rgba(148,167,255,.48) !important;
}
.sikh-world-footer,
.sikh-world-note{
  position:relative;
  z-index:1;
}


/* AutoFace v0.34.5 — Registration experience */
.launch-register-section{
  position:relative;
  overflow:hidden;
  background:
    radial-gradient(circle at 16% 30%,rgba(46,127,255,.075),transparent 31%),
    radial-gradient(circle at 82% 34%,rgba(126,91,255,.085),transparent 28%);
}
.launch-register-section:before{
  content:"";
  position:absolute;
  width:420px;height:420px;
  left:-230px;top:80px;
  border-radius:50%;
  background:rgba(45,134,255,.055);
  filter:blur(80px);
  pointer-events:none;
}
.launch-register-layout{position:relative;z-index:1;gap:24px}
.launch-register-form-vivid{
  position:relative;
  overflow:hidden;
  padding:27px;
  border:1px solid rgba(81,137,255,.18);
  border-radius:18px;
  background:
    radial-gradient(circle at 100% 0%,rgba(117,84,255,.09),transparent 29%),
    linear-gradient(145deg,rgba(15,27,48,.92),rgba(9,16,31,.95));
  box-shadow:0 24px 70px rgba(0,27,81,.15),inset 0 1px rgba(255,255,255,.02);
}
.launch-register-form-vivid:before{
  content:"";
  position:absolute;
  top:0;left:0;right:0;
  height:3px;
  background:linear-gradient(90deg,#7861ff,#4a9dff,#55d5c0);
  opacity:.78;
}
.launch-register-form-head{
  display:grid;
  grid-template-columns:48px 1fr;
  gap:13px;
  align-items:center;
  margin-bottom:24px;
  padding-bottom:20px;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.launch-register-form-head h2{margin:4px 0 4px;font-size:21px;line-height:1.22}
.launch-register-form-head p{margin:0;max-width:650px;font-size:10px;line-height:1.55;color:#8292a8}
.launch-register-form-icon{
  width:46px;height:46px;
  display:grid;place-items:center;
  border-radius:14px;
  border:1px solid rgba(91,148,255,.20);
  background:linear-gradient(135deg,rgba(74,148,255,.14),rgba(125,87,255,.12));
  color:#84b7ff;
  box-shadow:0 10px 30px rgba(54,98,211,.11);
}
.launch-register-form-vivid .field{margin-bottom:17px}
.launch-register-form-vivid .field label{font-size:11px}
.launch-register-form-vivid .field input{
  min-height:50px;
  border-color:rgba(92,122,177,.24);
  background:rgba(5,12,28,.68);
  transition:border-color .16s ease,box-shadow .16s ease,background .16s ease;
}
.launch-register-form-vivid .field input:focus{
  outline:none;
  border-color:rgba(91,145,255,.55);
  background:rgba(7,15,33,.92);
  box-shadow:0 0 0 3px rgba(75,126,255,.09),0 9px 28px rgba(36,91,194,.07);
}
.launch-register-form-vivid .field small{font-size:9px;line-height:1.45}
.launch-consent-vivid{
  display:grid;
  grid-template-columns:30px 18px 1fr;
  gap:9px;
  align-items:center;
  padding:14px 15px;
  border-color:rgba(72,201,166,.16);
  background:linear-gradient(135deg,rgba(57,185,160,.045),rgba(78,130,255,.035));
}
.launch-consent-vivid .launch-consent-icon{
  width:29px;height:29px;
  display:grid;place-items:center;
  border-radius:9px;
  background:rgba(68,203,166,.07);
  color:#65ceb0;
}
.launch-consent-vivid input{margin:0}
.launch-consent-vivid>span:last-child{display:grid;gap:2px}
.launch-consent-vivid b{font-size:9.5px;color:#c7d2df}
.launch-consent-vivid small{font-size:8.5px;line-height:1.45;color:#8798ad}
.launch-create-button{
  display:inline-flex!important;
  align-items:center;
  justify-content:center;
  gap:8px;
  min-height:46px;
  padding-inline:20px;
  background:linear-gradient(100deg,#7560ff,#4d9fff)!important;
  border-color:rgba(124,114,255,.34)!important;
  box-shadow:0 11px 32px rgba(69,100,255,.16);
}
.launch-create-button:not(:disabled):hover{transform:translateY(-1px);box-shadow:0 14px 38px rgba(69,100,255,.22)}
.launch-create-button:disabled{filter:saturate(.55);opacity:.62}

.launch-next-card,.launch-trust-note-vivid{
  position:relative;
  overflow:hidden;
  padding:23px;
}
.launch-next-card{
  border-color:rgba(108,86,255,.20)!important;
  background:
    radial-gradient(circle at 100% 0%,rgba(122,89,255,.12),transparent 34%),
    linear-gradient(145deg,rgba(16,23,40,.94),rgba(10,17,32,.96))!important;
}
.launch-side-icon,.launch-control-icon{
  position:absolute;
  right:18px;top:18px;
  width:36px;height:36px;
  display:grid;place-items:center;
  border-radius:11px;
}
.launch-side-icon{
  border:1px solid rgba(126,96,255,.19);
  background:rgba(126,96,255,.08);
  color:#9c88ff;
}
.launch-next-card h3{max-width:250px;margin:6px 0 0;font-size:18px}
.launch-step-list-vivid{position:relative;gap:0;margin-top:18px}
.launch-step-list-vivid span{
  position:relative;
  min-height:43px;
  gap:10px;
  font-size:10px;
}
.launch-step-list-vivid span b{
  position:relative;
  z-index:2;
  width:28px;height:28px;
  flex:0 0 28px;
  border:1px solid rgba(127,99,255,.16);
  background:linear-gradient(135deg,rgba(125,95,255,.15),rgba(52,137,255,.08));
  color:#d2cbff;
}
.launch-step-list-vivid span em{font-style:normal;color:#a8b5c7}
.launch-step-list-vivid span i{
  position:absolute;
  left:13px;top:28px;
  width:1px;height:15px;
  background:linear-gradient(#6754c8,rgba(67,116,197,.18));
}
.launch-trust-note-vivid{
  border-color:rgba(45,178,210,.17)!important;
  background:
    radial-gradient(circle at 90% 10%,rgba(33,155,224,.11),transparent 37%),
    linear-gradient(145deg,rgba(13,28,46,.96),rgba(10,22,36,.96))!important;
}
.launch-control-icon{
  border:1px solid rgba(75,188,224,.18);
  background:rgba(56,177,217,.07);
  color:#65c4df;
}
.launch-trust-note-vivid h3{margin:6px 0 8px;font-size:17px}
.launch-trust-note-vivid p{font-size:10.5px;line-height:1.65}
.launch-control-pills{display:flex;gap:6px;flex-wrap:wrap;margin-top:14px}
.launch-control-pills span{
  display:inline-flex;align-items:center;gap:5px;
  padding:6px 8px;
  border:1px solid rgba(73,191,177,.12);
  border-radius:999px;
  background:rgba(65,187,169,.035);
  font-size:7.5px;
  color:#8ba9aa;
}
.launch-control-pills svg{color:#64c9b4}

@media(max-width:850px){
  .launch-register-form-vivid{padding:22px}
}
@media(max-width:520px){
  .launch-register-form-head{grid-template-columns:40px 1fr}
  .launch-register-form-icon{width:39px;height:39px;border-radius:12px}
  .launch-register-form-head h2{font-size:18px}
  .launch-consent-vivid{grid-template-columns:28px 18px 1fr;padding:12px}
  .launch-next-card,.launch-trust-note-vivid{padding:19px}
}


/* AutoFace v0.34.7 — colourful, readable homepage journey */
.autoface-how-flow{
  background:
    radial-gradient(circle at 10% 20%,rgba(44,137,255,.055),transparent 27%),
    radial-gradient(circle at 88% 50%,rgba(255,78,147,.045),transparent 28%),
    radial-gradient(circle at 50% 70%,rgba(126,91,255,.055),transparent 30%);
}
.autoface-flow-line{gap:14px}
.autoface-flow-step{
  min-height:224px;
  padding:22px 20px;
  border-width:1px;
  transition:transform .18s ease,box-shadow .18s ease;
}
.autoface-flow-step:hover{transform:translateY(-2px)}
.autoface-flow-step:nth-of-type(1){
  border-color:rgba(70,164,255,.22);
  background:linear-gradient(145deg,rgba(34,122,220,.10),rgba(8,15,29,.91));
  box-shadow:inset 0 0 35px rgba(43,137,255,.035);
}
.autoface-flow-step:nth-of-type(2){
  border-color:rgba(145,105,255,.24);
  background:linear-gradient(145deg,rgba(119,77,225,.11),rgba(9,14,29,.91));
  box-shadow:inset 0 0 35px rgba(128,88,255,.04);
}
.autoface-flow-step:nth-of-type(3){
  border-color:rgba(64,205,183,.22);
  background:linear-gradient(145deg,rgba(42,177,157,.095),rgba(8,16,28,.91));
  box-shadow:inset 0 0 35px rgba(46,194,171,.035);
}
.autoface-flow-step:nth-of-type(4){
  border-color:rgba(255,99,157,.23);
  background:linear-gradient(145deg,rgba(220,57,119,.10),rgba(10,14,28,.91));
  box-shadow:inset 0 0 35px rgba(255,82,147,.035);
}
.flow-number{
  min-width:32px;height:23px;padding:0 8px;
  font-size:7.5px;
  border-color:rgba(145,116,255,.30);
  background:rgba(128,94,255,.11);
  color:#b4a6ff;
}
.flow-icon{
  width:52px;height:52px;
  margin:17px 0 13px;
  border-radius:15px;
}
.flow-profile{color:#6bc1ff;background:linear-gradient(135deg,rgba(48,156,255,.18),rgba(48,156,255,.06));border-color:rgba(75,172,255,.18);box-shadow:0 9px 30px rgba(38,128,220,.10)}
.flow-atlas{color:#b495ff;background:linear-gradient(135deg,rgba(143,96,255,.20),rgba(111,79,229,.07));border-color:rgba(153,113,255,.20);box-shadow:0 9px 30px rgba(113,75,220,.10)}
.flow-discover{color:#6ee3cd;background:linear-gradient(135deg,rgba(49,205,178,.18),rgba(41,175,155,.06));border-color:rgba(74,211,188,.18);box-shadow:0 9px 30px rgba(42,166,145,.09)}
.flow-interest{color:#ff8caf;background:linear-gradient(135deg,rgba(255,82,145,.18),rgba(220,59,118,.06));border-color:rgba(255,104,158,.19);box-shadow:0 9px 30px rgba(218,55,115,.09)}
.autoface-flow-step h3{font-size:20px;margin-bottom:4px;color:#f4f5f8}
.autoface-flow-step b{font-size:10px;line-height:1.35;color:#d0d7e3}
.autoface-flow-step p{margin-top:9px;font-size:10px;line-height:1.58;color:#93a1b5}
.flow-connector{color:#7185a7}
.flow-connector svg{opacity:.95;filter:drop-shadow(0 0 8px rgba(100,139,210,.18))}

.autoface-mutual-stage{
  margin-top:38px;
  min-height:205px;
  padding:28px 30px;
  border-color:rgba(245,91,151,.28);
  background:
    radial-gradient(circle at 50% 48%,rgba(137,89,255,.19),transparent 29%),
    radial-gradient(circle at 10% 50%,rgba(255,73,143,.07),transparent 25%),
    radial-gradient(circle at 90% 50%,rgba(74,147,255,.07),transparent 25%),
    linear-gradient(145deg,rgba(32,18,48,.56),rgba(8,15,30,.93));
  box-shadow:inset 0 0 65px rgba(123,74,214,.035),0 20px 60px rgba(0,0,0,.10);
}
.mutual-side{
  min-height:66px;
  padding:14px 15px;
  border-color:rgba(255,106,160,.18);
  background:linear-gradient(135deg,rgba(255,83,146,.07),rgba(13,21,38,.75));
}
.mutual-side span{font-size:7.5px;color:#91a0b5}
.mutual-side svg{width:20px;height:20px;color:#ff759f;filter:drop-shadow(0 0 8px rgba(255,86,145,.25))}
.mutual-side b{font-size:10px;color:#eef1f6}
.mutual-path i{height:2px;background:linear-gradient(90deg,rgba(255,91,150,.20),rgba(139,97,255,.95));box-shadow:0 0 9px rgba(132,94,255,.16)}
.mutual-path-right i{background:linear-gradient(90deg,rgba(139,97,255,.95),rgba(255,91,150,.20))}
.mutual-centre .flow-number{margin-bottom:4px}
.mutual-centre .flow-icon{width:56px;height:56px;margin:10px auto 9px}
.flow-mutual{
  color:#ff9cbd;
  background:linear-gradient(135deg,rgba(255,76,143,.25),rgba(127,85,255,.22));
  border-color:rgba(255,118,171,.23);
  box-shadow:0 0 38px rgba(143,86,255,.18);
}
.mutual-centre h3{font-size:22px;color:#fff}
.mutual-centre p{max-width:300px;font-size:10px;line-height:1.55;color:#a0aec0}

.autoface-introduction-finish{padding-top:34px}
.finish-line{height:34px;width:2px;background:linear-gradient(#8c64ff,#ff6f9f);box-shadow:0 0 10px rgba(144,94,255,.22)}
.autoface-introduction-finish article{
  max-width:760px;
  grid-template-columns:44px 58px 1fr;
  gap:15px;
  padding:22px 24px;
  border-color:rgba(255,110,164,.30);
  background:
    radial-gradient(circle at 8% 50%,rgba(255,86,148,.11),transparent 23%),
    linear-gradient(110deg,rgba(255,82,145,.10),rgba(126,83,255,.14),rgba(45,151,255,.09));
  box-shadow:0 22px 65px rgba(38,26,96,.13),inset 0 0 35px rgba(114,83,255,.025);
}
.autoface-introduction-finish .flow-icon{width:54px;height:54px}
.flow-message{color:#ffa1c1;background:linear-gradient(135deg,rgba(255,88,150,.20),rgba(124,89,255,.12));border-color:rgba(255,111,165,.22)}
.autoface-introduction-finish h3{font-size:21px;margin-bottom:3px}
.autoface-introduction-finish b{font-size:10.5px;color:#e1e5ed}
.autoface-introduction-finish p{margin-top:6px;font-size:9.5px;line-height:1.55;color:#96a5b9}
.autoface-flow-principle{
  max-width:850px;
  margin-top:25px;
  padding:14px 18px;
  border:1px solid rgba(78,207,174,.10);
  border-radius:12px;
  background:rgba(55,186,157,.025);
  font-size:9.5px;
  line-height:1.5;
  color:#9cabbc;
}
.autoface-flow-principle svg{width:20px;height:20px;color:#68d7b6}
.autoface-flow-principle b{color:#e0e5ec}

@media(max-width:760px){
  .autoface-flow-step{min-height:auto;padding:20px}
  .autoface-flow-step h3{font-size:19px}
  .autoface-flow-step b,.autoface-flow-step p{font-size:10px}
  .autoface-mutual-stage{padding:22px 18px}
  .mutual-side{max-width:260px}
  .autoface-introduction-finish article{grid-template-columns:38px 52px 1fr;padding:18px}
}


/* AutoFace v0.34.8 — refined community map background */
.sikh-world-card{
  background:
    radial-gradient(circle at 48% 30%,rgba(68,111,220,.18),transparent 34%),
    radial-gradient(circle at 78% 68%,rgba(96,72,190,.08),transparent 32%),
    linear-gradient(145deg,#09111f 0%,#102448 48%,#0a1324 100%) !important;
  border-color:rgba(77,115,186,.24) !important;
  box-shadow:
    inset 0 0 65px rgba(48,87,162,.09),
    0 24px 70px rgba(0,17,45,.14);
}
.sikh-map{
  background:
    radial-gradient(circle at 46% 34%,rgba(79,115,225,.10),transparent 24%) !important;
}
.sikh-map .map-land{
  fill:rgba(55,83,135,.22) !important;
  stroke:rgba(104,138,205,.30) !important;
}
.sikh-map .map-link{
  stroke:rgba(122,113,219,.42) !important;
}
.sikh-map .map-point.uk .pulse{
  stroke:rgba(132,103,255,.56) !important;
  filter:drop-shadow(0 0 8px rgba(124,92,255,.30));
}
.sikh-world-footer{
  color:#aebbd0;
}
.sikh-world-note{
  color:#718198;
}


/* AutoFace v0.34.9 — mobile homepage journey fix */
@media(max-width:760px){
  .autoface-how-flow{
    overflow:hidden;
  }

  .autoface-how-flow .container{
    width:min(100% - 28px,1180px);
  }

  .autoface-flow-line{
    display:grid !important;
    grid-template-columns:1fr !important;
    gap:0 !important;
    width:100%;
  }

  .autoface-flow-step,
  .autoface-flow-step:nth-of-type(1),
  .autoface-flow-step:nth-of-type(2),
  .autoface-flow-step:nth-of-type(3),
  .autoface-flow-step:nth-of-type(4){
    grid-column:1 !important;
    width:100% !important;
    min-width:0 !important;
    max-width:none !important;
    min-height:auto !important;
    box-sizing:border-box;
    padding:20px 18px !important;
    margin:0 !important;
  }

  .autoface-flow-step h3{
    font-size:20px !important;
    line-height:1.2;
  }

  .autoface-flow-step b{
    font-size:10.5px !important;
    line-height:1.4;
  }

  .autoface-flow-step p{
    max-width:none !important;
    font-size:10px !important;
    line-height:1.58 !important;
    word-break:normal !important;
    overflow-wrap:break-word;
  }

  .flow-icon{
    width:50px !important;
    height:50px !important;
    margin:14px 0 12px !important;
  }

  .flow-number{
    min-width:32px;
    height:23px;
    font-size:7.5px;
  }

  .flow-connector{
    display:flex !important;
    align-items:center;
    justify-content:center;
    width:100%;
    height:34px !important;
    transform:none !important;
    color:#7083a4;
  }

  .flow-connector svg{
    transform:rotate(90deg);
    width:18px;
    height:18px;
    opacity:.95;
  }

  .autoface-mutual-stage{
    display:grid !important;
    grid-template-columns:1fr !important;
    gap:12px !important;
    width:100%;
    padding:20px 16px !important;
    margin-top:18px !important;
    box-sizing:border-box;
  }

  .mutual-side{
    max-width:none !important;
    width:100% !important;
    box-sizing:border-box;
  }

  .mutual-path,
  .mutual-path-right{
    width:100%;
    height:30px !important;
  }

  .mutual-path i,
  .mutual-path-right i{
    left:50% !important;
    right:auto !important;
    top:0 !important;
    bottom:auto !important;
    width:2px !important;
    height:30px !important;
    transform:none !important;
    background:linear-gradient(rgba(255,112,159,.25),rgba(135,99,255,.88)) !important;
  }

  .mutual-path i:last-child,
  .mutual-path-right i:last-child{
    display:none !important;
  }

  .mutual-centre{
    padding:4px 0;
  }

  .mutual-centre p{
    max-width:310px !important;
    font-size:10px !important;
  }

  .autoface-introduction-finish{
    width:100%;
    padding-top:32px;
  }

  .autoface-introduction-finish article{
    grid-template-columns:36px 50px minmax(0,1fr) !important;
    gap:11px !important;
    width:100%;
    max-width:none !important;
    box-sizing:border-box;
    padding:17px 15px !important;
  }

  .autoface-introduction-finish h3{
    font-size:19px !important;
  }

  .autoface-introduction-finish b{
    font-size:10px !important;
  }

  .autoface-introduction-finish p{
    font-size:9.5px !important;
    line-height:1.55;
  }

  .autoface-flow-principle{
    width:100%;
    box-sizing:border-box;
    margin-top:18px;
    font-size:9px !important;
  }
}

@media(max-width:420px){
  .autoface-how-flow .container{
    width:min(100% - 22px,1180px);
  }

  .autoface-flow-step{
    padding:18px 16px !important;
  }

  .autoface-introduction-finish article{
    grid-template-columns:34px 46px minmax(0,1fr) !important;
    padding:15px 13px !important;
  }

  .autoface-introduction-finish .flow-icon{
    width:46px !important;
    height:46px !important;
  }
}

/* v0.35.0 — AWS Rekognition Face Verification */
.face-verification-card{overflow:hidden}
.face-check-steps{display:grid;gap:12px;margin:22px 0}
.face-check-steps>div{display:flex;gap:13px;align-items:flex-start;padding:14px 15px;border:1px solid rgba(124,92,255,.18);background:rgba(124,92,255,.045);border-radius:16px}
.face-check-steps>div>b{display:grid;place-items:center;flex:0 0 32px;height:32px;border-radius:50%;background:linear-gradient(135deg,#6f57ff,#ff6ea8);color:#fff;font-size:14px}
.face-check-steps span{display:flex;flex-direction:column;gap:3px}
.face-check-steps strong{font-size:14px;color:var(--text)}
.face-check-steps small,.face-helper{color:var(--muted);line-height:1.55}
.aws-liveness-shell{margin-top:20px;min-height:440px;border-radius:20px;overflow:hidden;background:#fff;border:1px solid rgba(91,74,181,.18)}
.aws-liveness-shell [data-amplify-liveness]{min-height:440px}
.face-result{display:flex;gap:16px;align-items:flex-start;padding:20px;border-radius:18px;margin-top:18px;border:1px solid}
.face-result.success{background:#eefbf5;border-color:#9bdabd}
.face-result.failed{background:#fff7f3;border-color:#f1c2ac}
.face-result-icon{display:grid;place-items:center;width:44px;height:44px;border-radius:50%;font-size:24px;font-weight:800;background:#fff}
.face-result h3{margin:0 0 6px}
.face-result p{margin:0 0 8px}
.face-result small{display:block;color:var(--muted);margin-top:3px}
.face-result-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}
@media(max-width:700px){.aws-liveness-shell{min-height:520px}.face-check-steps>div{padding:13px}.face-result{padding:16px}.face-result-actions .btn{width:100%;justify-content:center}}


/* v0.35.1 camera diagnostics */
.camera-diagnostic-actions{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-top:18px}
.camera-diagnostic{display:flex;gap:12px;align-items:flex-start;margin-top:14px;padding:14px 15px;border-radius:16px;border:1px solid rgba(124,92,255,.18);background:rgba(124,92,255,.045)}
.camera-diagnostic.passed{border-color:rgba(63,201,151,.32);background:rgba(63,201,151,.07)}
.camera-diagnostic.failed{border-color:rgba(255,110,168,.34);background:rgba(255,110,168,.07)}
.camera-diagnostic.checking{border-color:rgba(82,201,255,.28);background:rgba(82,201,255,.06)}
.camera-diagnostic-icon{display:grid;place-items:center;flex:0 0 30px;height:30px;border-radius:50%;background:rgba(124,92,255,.14);font-weight:800}
.camera-diagnostic>div:last-child{display:flex;flex-direction:column;gap:4px;min-width:0}
.camera-diagnostic strong{color:var(--text)}
.camera-diagnostic p{margin:0;color:var(--muted);line-height:1.5}
.camera-diagnostic small{color:var(--muted);overflow-wrap:anywhere}
.camera-diagnostic code{font-size:.9em}
@media(max-width:700px){.camera-diagnostic-actions .btn{width:100%;justify-content:center}}

/* v0.35.3 biometric consent & privacy */
.biometric-privacy-panel{margin:22px 0;padding:20px;border:1px solid rgba(96,165,250,.35);border-radius:20px;background:linear-gradient(145deg,rgba(8,18,38,.98),rgba(17,24,55,.98));box-shadow:0 18px 50px rgba(2,6,23,.22)}
.biometric-privacy-heading{display:flex;align-items:flex-start;gap:14px;margin-bottom:16px}.biometric-privacy-heading h3{margin:4px 0 4px;color:#f8fbff}.biometric-privacy-heading p{margin:0;color:#a9b9d6;line-height:1.5}.biometric-privacy-shield{display:grid;place-items:center;flex:0 0 42px;width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,#0ea5e9,#2563eb);color:white;font-weight:900;box-shadow:0 8px 24px rgba(37,99,235,.3)}
.biometric-privacy-grid{overflow:hidden;border:1px solid rgba(148,163,184,.18);border-radius:16px;background:rgba(255,255,255,.035)}.biometric-info-row{display:grid;grid-template-columns:42px 1fr;gap:13px;padding:15px 16px;border-bottom:1px solid rgba(148,163,184,.13)}.biometric-info-row:last-child{border-bottom:0}.biometric-info-row strong{display:block;margin-bottom:3px;font-size:.98rem}.biometric-info-row p{margin:0;color:#b5c2d8;line-height:1.5;font-size:.92rem}.biometric-info-icon{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;font-weight:900;font-size:1rem}.info-blue strong{color:#60a5fa}.info-blue .biometric-info-icon{color:#60a5fa;background:rgba(59,130,246,.14);border:1px solid rgba(96,165,250,.22)}.info-green strong{color:#4ade80}.info-green .biometric-info-icon{color:#4ade80;background:rgba(34,197,94,.13);border:1px solid rgba(74,222,128,.22)}.info-purple strong{color:#c084fc}.info-purple .biometric-info-icon{color:#c084fc;background:rgba(168,85,247,.14);border:1px solid rgba(192,132,252,.22)}.info-orange strong{color:#fb923c}.info-orange .biometric-info-icon{color:#fb923c;background:rgba(249,115,22,.13);border:1px solid rgba(251,146,60,.22)}.info-teal strong{color:#2dd4bf}.info-teal .biometric-info-icon{color:#2dd4bf;background:rgba(20,184,166,.13);border:1px solid rgba(45,212,191,.22)}.biometric-info-row a{color:#7dd3fc;text-decoration:underline;font-weight:800}
.biometric-consent{display:grid;grid-template-columns:auto 38px 1fr;gap:12px;align-items:flex-start;margin-top:16px;padding:15px;border-radius:16px;background:linear-gradient(135deg,rgba(16,185,129,.11),rgba(6,78,59,.2));border:1px solid rgba(52,211,153,.45);cursor:pointer;transition:border-color .2s ease,background .2s ease,transform .2s ease}.biometric-consent:hover{border-color:rgba(52,211,153,.8);background:linear-gradient(135deg,rgba(16,185,129,.16),rgba(6,78,59,.25))}.biometric-consent.consent-selected{border-color:#34d399;background:linear-gradient(135deg,rgba(16,185,129,.2),rgba(6,78,59,.32));box-shadow:0 0 0 3px rgba(52,211,153,.08)}.biometric-consent input{width:20px;height:20px;margin-top:8px;accent-color:#10b981;flex:0 0 auto}.biometric-consent-icon{display:grid!important;place-items:center;width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,#16a34a,#059669);color:#fff;font-weight:900;box-shadow:0 7px 20px rgba(16,185,129,.22)}.biometric-consent>span:last-child{display:flex;flex-direction:column;gap:5px}.biometric-consent strong{color:#6ee7b7;line-height:1.4}.biometric-consent small{color:#b6c7d8;line-height:1.45}.biometric-privacy-panel .privacy-kicker{color:#67e8f9}
@media(max-width:640px){.biometric-privacy-panel{padding:15px}.biometric-info-row{grid-template-columns:36px 1fr;padding:13px 12px}.biometric-info-icon{width:34px;height:34px}.biometric-consent{grid-template-columns:auto 1fr}.biometric-consent-icon{display:none!important}.biometric-consent input{margin-top:2px}}

/* v0.35.4.1 - clearer face verification failure state */
.face-failure-wrap{display:grid;gap:16px;margin-top:18px}
.face-failure-hero{display:flex;gap:18px;align-items:flex-start;padding:22px 24px;border:1px solid rgba(251,113,133,.55);border-radius:20px;background:linear-gradient(135deg,rgba(127,29,29,.38),rgba(76,5,25,.26));box-shadow:0 0 0 1px rgba(244,63,94,.08) inset}
.face-failure-icon{flex:0 0 50px;width:50px;height:50px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(135deg,#fb7185,#e11d48);color:#fff;font-size:32px;font-weight:900;box-shadow:0 10px 28px rgba(225,29,72,.25)}
.face-failure-hero h3{margin:0 0 7px;color:#fff;font-size:1.35rem}
.face-failure-hero p{margin:0 0 12px;color:#fecdd3;line-height:1.55;max-width:760px}
.face-failure-hero strong{display:block;color:#fda4af;margin-bottom:4px}
.face-failure-hero span{display:block;color:#cbd5e1;line-height:1.5}
.face-failure-details{padding:20px;border:1px solid rgba(96,165,250,.24);border-radius:20px;background:linear-gradient(180deg,rgba(15,23,42,.96),rgba(15,23,42,.76))}
.face-failure-details h4{margin:0 0 14px;color:#e2e8f0;font-size:.85rem;letter-spacing:.11em;text-transform:uppercase}
.face-failure-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.face-metric{display:flex;gap:14px;padding:16px;border:1px solid rgba(148,163,184,.16);border-radius:16px;background:rgba(30,41,59,.72)}
.face-metric .metric-icon{flex:0 0 40px;width:40px;height:40px;display:grid;place-items:center;border-radius:12px;font-size:20px;font-weight:800}
.face-metric small{display:block;color:#cbd5e1;font-weight:700;margin-bottom:4px}
.face-metric strong{font-size:1.55rem;line-height:1;color:#fff;margin-right:8px}
.face-metric em{display:inline-flex;padding:3px 8px;border-radius:999px;font-size:.72rem;font-style:normal;font-weight:800;vertical-align:3px}
.face-metric p{margin:8px 0 0;color:#94a3b8;line-height:1.45;font-size:.88rem}
.metric-live .metric-icon{background:rgba(34,197,94,.13);color:#4ade80}
.metric-live em{background:rgba(34,197,94,.13);color:#86efac}
.metric-match .metric-icon{background:rgba(168,85,247,.14);color:#c084fc}
.metric-match em{background:rgba(244,63,94,.14);color:#fda4af}
.face-failure-tips{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:14px;padding:14px 16px;border-radius:14px;background:rgba(14,165,233,.08);border:1px solid rgba(56,189,248,.2)}
.face-failure-tips strong{width:100%;color:#38bdf8}
.face-failure-tips span{color:#cbd5e1;font-size:.88rem}
.face-retry-btn{border-color:rgba(251,113,133,.55);color:#fecdd3}
.face-retry-btn:hover{background:rgba(244,63,94,.09)}
@media(max-width:700px){.face-failure-hero{padding:18px;gap:12px}.face-failure-icon{flex-basis:42px;width:42px;height:42px}.face-failure-metrics{grid-template-columns:1fr}.face-failure-tips{display:grid;gap:7px}}

/* v0.35.5 — Colour & Visual Depth
   Keep AutoFace dark and premium, but give every page a more colourful atmosphere. */
:root{
  --bg:#07101d;
  --panel:#0d1729;
  --panel-2:#121f35;
  --page-blue:rgba(38,132,255,.16);
  --page-violet:rgba(129,76,255,.15);
  --page-pink:rgba(244,63,143,.09);
  --page-cyan:rgba(34,211,238,.07);
}

body{
  min-height:100vh;
  background:
    radial-gradient(900px 620px at -8% -4%,rgba(54,138,255,.23),transparent 62%),
    radial-gradient(820px 560px at 106% 8%,rgba(148,75,255,.19),transparent 62%),
    radial-gradient(760px 520px at 74% 72%,rgba(236,72,153,.09),transparent 65%),
    radial-gradient(680px 480px at 12% 88%,rgba(34,211,238,.075),transparent 64%),
    linear-gradient(155deg,#07101d 0%,#090d1b 42%,#0a1020 72%,#07101d 100%);
  background-attachment:fixed;
}

/* A soft coloured atmosphere behind content without making cards bright. */
body::before{
  content:"";
  position:fixed;
  inset:72px 0 0;
  z-index:-1;
  pointer-events:none;
  background:
    radial-gradient(circle at 24% 18%,rgba(59,130,246,.085),transparent 28%),
    radial-gradient(circle at 80% 34%,rgba(168,85,247,.07),transparent 27%),
    radial-gradient(circle at 48% 82%,rgba(236,72,153,.045),transparent 30%);
}

.nav{
  background:linear-gradient(90deg,rgba(7,16,29,.88),rgba(15,12,35,.88),rgba(7,18,32,.88));
  border-bottom-color:rgba(116,143,255,.14);
  box-shadow:0 10px 40px rgba(2,6,23,.16);
}

/* General cards gain subtle blue/violet depth rather than flat black. */
.card,
.form,
.step,
.otp-panel{
  border-color:rgba(144,164,220,.12);
  box-shadow:0 18px 45px rgba(1,7,20,.15),0 1px 0 rgba(121,147,255,.035) inset;
}
.card{
  background:
    linear-gradient(145deg,rgba(19,31,53,.82),rgba(11,18,34,.88)),
    linear-gradient(135deg,rgba(92,119,255,.04),rgba(187,79,255,.025));
}
.form{
  background:linear-gradient(150deg,rgba(16,29,50,.94),rgba(10,18,34,.96));
}

/* Alternate page sections pick up very restrained colour washes. */
.section:nth-of-type(3n+1),
.dashboard-section:nth-of-type(3n+1){
  background:linear-gradient(180deg,transparent,rgba(45,122,255,.025),transparent);
}
.section:nth-of-type(3n+2),
.dashboard-section:nth-of-type(3n+2){
  background:linear-gradient(180deg,transparent,rgba(139,76,255,.025),transparent);
}
.section:nth-of-type(3n),
.dashboard-section:nth-of-type(3n){
  background:linear-gradient(180deg,transparent,rgba(225,70,145,.018),transparent);
}

.page-hero{
  position:relative;
}
.page-hero::after{
  content:"";
  position:absolute;
  left:50%;
  top:-100px;
  width:min(880px,92vw);
  height:360px;
  transform:translateX(-50%);
  pointer-events:none;
  z-index:-1;
  background:radial-gradient(ellipse,rgba(88,96,255,.10),rgba(55,160,255,.04) 46%,transparent 72%);
  filter:blur(8px);
}

/* Make common informational surfaces feel intentionally colour-coded. */
.notice{
  background:linear-gradient(135deg,rgba(52,211,153,.10),rgba(34,211,238,.055));
  border-color:rgba(79,220,182,.28);
}
.next-step{
  background:linear-gradient(135deg,rgba(48,155,255,.08),rgba(126,91,255,.045));
}
.status-pill{
  background:linear-gradient(135deg,rgba(124,92,255,.13),rgba(58,167,255,.08));
}

/* Homepage sections previously using flat #070b14 now retain colour continuity. */
.experience-statement{
  background:
    radial-gradient(circle at 18% 30%,rgba(65,132,255,.075),transparent 35%),
    radial-gradient(circle at 82% 70%,rgba(156,83,255,.065),transparent 34%),
    linear-gradient(180deg,rgba(7,11,20,.35),rgba(8,15,28,.72));
}
.experience-dual{
  background:
    radial-gradient(circle at 84% 42%,rgba(128,79,255,.085),transparent 34%),
    radial-gradient(circle at 18% 64%,rgba(38,167,220,.05),transparent 32%),
    linear-gradient(180deg,rgba(7,13,24,.68),rgba(9,13,25,.74));
}
.experience-principle{
  background:
    radial-gradient(circle at 50% 20%,rgba(236,72,153,.055),transparent 38%),
    linear-gradient(180deg,rgba(9,13,25,.74),rgba(7,16,29,.52));
}
.sikh-world-section{
  background:
    radial-gradient(circle at 48% 30%,rgba(42,145,255,.055),transparent 40%),
    radial-gradient(circle at 76% 70%,rgba(147,82,255,.045),transparent 35%);
}
.autoface-how-flow{
  background:
    radial-gradient(circle at 15% 25%,rgba(53,164,255,.055),transparent 30%),
    radial-gradient(circle at 86% 58%,rgba(255,93,156,.04),transparent 32%),
    linear-gradient(180deg,transparent,rgba(75,62,155,.035),transparent);
}

/* Small visual accents help long product pages feel less monochrome. */
.card:nth-child(4n+1){border-top-color:rgba(82,160,255,.26)}
.card:nth-child(4n+2){border-top-color:rgba(150,104,255,.25)}
.card:nth-child(4n+3){border-top-color:rgba(68,205,184,.22)}
.card:nth-child(4n){border-top-color:rgba(255,105,158,.20)}

.footer{
  background:linear-gradient(180deg,rgba(7,11,20,0),rgba(5,12,24,.72));
  border-top-color:rgba(116,143,255,.11);
}

@media(max-width:800px){
  body{
    background:
      radial-gradient(560px 440px at -18% 0%,rgba(54,138,255,.19),transparent 62%),
      radial-gradient(520px 420px at 112% 14%,rgba(148,75,255,.16),transparent 62%),
      radial-gradient(460px 380px at 50% 82%,rgba(236,72,153,.055),transparent 65%),
      linear-gradient(160deg,#07101d,#090d1b 55%,#07101d);
    background-attachment:scroll;
  }
  .page-hero::after{height:280px;top:-70px}
  .card{box-shadow:0 12px 30px rgba(1,7,20,.13)}
}

@media(prefers-reduced-motion:reduce){
  body{background-attachment:scroll}
}

/* v0.35.5.1 — Stronger Colour Canvas
   Explicitly targets page sections that previously painted over the global body background. */
.experience-home{
  background:
    radial-gradient(900px 640px at 4% 8%,rgba(39,132,255,.18),transparent 60%),
    radial-gradient(900px 620px at 96% 12%,rgba(137,76,255,.20),transparent 62%),
    linear-gradient(155deg,#071221 0%,#0b1026 48%,#07101d 100%);
}
.experience-hero{
  background:
    radial-gradient(720px 560px at 8% 35%,rgba(47,143,255,.22),transparent 62%),
    radial-gradient(720px 520px at 91% 39%,rgba(145,76,255,.24),transparent 62%),
    radial-gradient(520px 400px at 55% 92%,rgba(236,72,153,.10),transparent 66%),
    linear-gradient(150deg,#07111f 0%,#10102a 52%,#07111f 100%) !important;
}
.experience-hero::after{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:linear-gradient(115deg,rgba(56,189,248,.035),transparent 35%,rgba(192,132,252,.045) 72%,transparent);
}
.experience-statement{
  background:
    radial-gradient(650px 420px at 20% 35%,rgba(59,130,246,.13),transparent 62%),
    radial-gradient(640px 420px at 82% 55%,rgba(168,85,247,.12),transparent 62%),
    linear-gradient(180deg,#081323,#0b1022) !important;
}
.experience-journey{
  background:
    radial-gradient(620px 440px at 82% 18%,rgba(34,211,238,.08),transparent 64%),
    radial-gradient(650px 440px at 12% 75%,rgba(124,92,255,.12),transparent 64%),
    linear-gradient(180deg,#091326,#08101f) !important;
}
.experience-dual{
  background:
    radial-gradient(700px 480px at 80% 45%,rgba(168,85,247,.15),transparent 64%),
    radial-gradient(620px 460px at 15% 62%,rgba(37,150,255,.10),transparent 64%),
    linear-gradient(180deg,#08101f,#0b1125) !important;
}
.experience-principle,
.experience-final{
  background:
    radial-gradient(620px 430px at 50% 25%,rgba(236,72,153,.09),transparent 64%),
    radial-gradient(650px 460px at 82% 80%,rgba(94,92,255,.10),transparent 64%),
    linear-gradient(180deg,#0a1022,#07101d) !important;
}
.sikh-world-section{
  background:
    radial-gradient(760px 500px at 18% 30%,rgba(38,143,255,.13),transparent 62%),
    radial-gradient(720px 480px at 82% 60%,rgba(137,82,255,.13),transparent 62%),
    linear-gradient(180deg,#081423,#0b1024) !important;
}
.autoface-how-flow{
  background:
    radial-gradient(720px 500px at 8% 30%,rgba(34,211,238,.09),transparent 62%),
    radial-gradient(740px 500px at 90% 58%,rgba(244,63,143,.09),transparent 62%),
    linear-gradient(180deg,#091225,#08101e) !important;
}
.page-shell,
.dashboard-page{
  background-image:
    radial-gradient(720px 520px at 5% 8%,rgba(40,133,255,.10),transparent 62%),
    radial-gradient(700px 500px at 96% 18%,rgba(151,78,255,.10),transparent 62%);
}
@media(max-width:800px){
  .experience-hero{
    background:
      radial-gradient(520px 430px at -8% 20%,rgba(47,143,255,.20),transparent 62%),
      radial-gradient(520px 430px at 108% 38%,rgba(145,76,255,.20),transparent 62%),
      linear-gradient(160deg,#07111f,#0e1028 55%,#07111f) !important;
  }
}

/* v0.35.5.2 — Visible Colour System
   Strong, intentionally visible colour across every AutoFace page. */
body{
  background:
    radial-gradient(1000px 760px at -5% 5%,rgba(22,132,255,.30),transparent 58%),
    radial-gradient(980px 720px at 105% 8%,rgba(139,68,255,.30),transparent 58%),
    radial-gradient(900px 700px at 50% 100%,rgba(236,72,153,.15),transparent 62%),
    linear-gradient(145deg,#061525 0%,#0c1230 46%,#160d31 72%,#071421 100%);
  background-attachment:fixed;
}

/* Every standard inner page gets a visible coloured header canvas. */
.page-hero,
.compact-hero{
  position:relative;
  isolation:isolate;
  background:
    radial-gradient(700px 360px at 8% 25%,rgba(24,145,255,.28),transparent 62%),
    radial-gradient(720px 380px at 92% 30%,rgba(153,74,255,.27),transparent 62%),
    linear-gradient(115deg,rgba(9,34,59,.74),rgba(25,18,61,.70));
  border-bottom:1px solid rgba(132,116,255,.14);
}
.page-hero::after{
  z-index:-1;
  opacity:.9;
}

/* Product/content sections: alternate obvious blue, violet and rose atmosphere. */
.section,
.dashboard-section,
.discovery-section,
.message-section{
  position:relative;
  isolation:isolate;
}
.section:nth-of-type(3n+1),
.dashboard-section:nth-of-type(3n+1){
  background:
    radial-gradient(760px 520px at 0% 35%,rgba(20,133,255,.18),transparent 62%),
    linear-gradient(90deg,rgba(7,27,48,.48),rgba(8,15,31,.18));
}
.section:nth-of-type(3n+2),
.dashboard-section:nth-of-type(3n+2){
  background:
    radial-gradient(760px 520px at 100% 35%,rgba(145,68,255,.19),transparent 62%),
    linear-gradient(270deg,rgba(30,17,64,.48),rgba(8,15,31,.18));
}
.section:nth-of-type(3n),
.dashboard-section:nth-of-type(3n){
  background:
    radial-gradient(760px 520px at 12% 55%,rgba(236,72,153,.12),transparent 62%),
    radial-gradient(700px 480px at 92% 35%,rgba(37,180,220,.10),transparent 62%);
}

/* Sections with dedicated class names that aren't always .section. */
.discovery-section,
.message-section{
  background:
    radial-gradient(820px 560px at 4% 10%,rgba(23,139,255,.17),transparent 62%),
    radial-gradient(780px 540px at 98% 30%,rgba(145,69,255,.17),transparent 62%);
}

/* Cards remain dark, but now sit visibly above the colourful canvas. */
.card,
.form,
.step,
.discovery-card,
.chat-card{
  background:linear-gradient(150deg,rgba(14,25,45,.94),rgba(12,16,34,.95));
  border-color:rgba(139,159,224,.17);
  box-shadow:0 20px 55px rgba(0,5,18,.28),0 1px 0 rgba(139,159,255,.05) inset;
}

/* Landing page: substantially more visible than v0.35.5.1. */
.experience-hero{
  background:
    radial-gradient(900px 700px at -5% 35%,rgba(20,140,255,.34),transparent 61%),
    radial-gradient(900px 700px at 105% 35%,rgba(145,65,255,.38),transparent 61%),
    radial-gradient(700px 520px at 55% 100%,rgba(236,72,153,.18),transparent 66%),
    linear-gradient(135deg,#07192c 0%,#111237 50%,#211043 76%,#081526 100%) !important;
}
.experience-statement{
  background:linear-gradient(120deg,#08223a 0%,#101b3d 48%,#26133e 100%) !important;
}
.experience-journey{
  background:linear-gradient(120deg,#0a1c35 0%,#15163b 52%,#112a3a 100%) !important;
}
.experience-dual{
  background:linear-gradient(120deg,#0a2038 0%,#17163d 48%,#29133f 100%) !important;
}
.experience-principle,
.experience-final{
  background:linear-gradient(120deg,#101b35 0%,#25143c 52%,#0a2034 100%) !important;
}
.sikh-world-section{
  background:linear-gradient(120deg,#08243b 0%,#131b3d 50%,#24163e 100%) !important;
}
.autoface-how-flow{
  background:linear-gradient(120deg,#0a2138 0%,#17163a 50%,#28143d 100%) !important;
}

@media(max-width:800px){
  body{background-attachment:scroll}
  .page-hero,.compact-hero{
    background:
      radial-gradient(520px 360px at -10% 15%,rgba(24,145,255,.26),transparent 62%),
      radial-gradient(520px 360px at 110% 25%,rgba(153,74,255,.25),transparent 62%),
      linear-gradient(135deg,#081b30,#171039);
  }
}

/* v0.35.6 — Card Readability & Typography
   Improve scanability on Discover, Profile and My Introductions without changing layout or logic. */

/* Discover cards */
.discovery-card,
.daily-discovery-card{
  font-size:15px;
}
.discovery-card .candidate-identity h2,
.daily-discovery-card .candidate-identity h2{
  font-size:24px;
  line-height:1.15;
}
.discovery-card .candidate-identity p,
.daily-discovery-card .candidate-identity p{
  font-size:15px;
  line-height:1.5;
  color:#aeb9ca;
}
.discovery-card .candidate-about,
.daily-discovery-card .candidate-about{
  font-size:15px!important;
  line-height:1.65!important;
}
.discovery-card .candidate-badges span,
.daily-discovery-card .candidate-badges span{
  font-size:12px;
  padding:7px 10px;
}
.discovery-card .trait-icon-card b,
.daily-discovery-card .trait-icon-card b{
  font-size:14px;
  line-height:1.25;
}
.discovery-card .trait-icon-card small,
.daily-discovery-card .trait-icon-card small{
  font-size:12px;
  line-height:1.35;
}
.discovery-card .discovery-insights small,
.daily-discovery-card .discovery-insights small{
  font-size:11px;
}
.discovery-card .discovery-insights p,
.daily-discovery-card .discovery-insights p{
  font-size:14px!important;
  line-height:1.55!important;
}
.discovery-card .why-atlas-card small,
.daily-discovery-card .why-atlas-card small{
  font-size:10px;
}
.discovery-card .why-atlas-card p,
.daily-discovery-card .why-atlas-card p{
  font-size:13px!important;
  line-height:1.55!important;
}
.daily-rank span{font-size:10px}.daily-rank b{font-size:11px}
.daily-discovery-intro p{font-size:14px;line-height:1.6}
.daily-count span{font-size:10px}
.daily-discovery-footer span{font-size:14px}
.daily-discovery-footer p{font-size:13px;line-height:1.5}

/* Profile cards and panels */
.profile-section .card p,
.profile-side .card p,
.profile-preview-card p,
.profile-edit-panel p,
.profile-form-refreshed p{
  font-size:14px;
  line-height:1.6;
}
.profile-section .card small,
.profile-side .card small,
.profile-preview-card small,
.profile-edit-panel small{
  font-size:11px;
  line-height:1.45;
}
.profile-identity-copy p{font-size:15px;line-height:1.5}
.profile-identity-badges span{font-size:11px;padding:7px 10px}
.profile-identity-score span{font-size:10px}
.profile-form-heading p{font-size:14px;line-height:1.55}
.profile-edit-panel-title small{font-size:10px}
.profile-edit-panel-title h3{font-size:20px}
.photo-manager-copy p{font-size:14px;line-height:1.6}
.photo-safety-note b{font-size:12px}
.photo-safety-note span,
.photo-rules{font-size:11px;line-height:1.55}
.profile-section label{font-size:13px}
.profile-section input,
.profile-section select,
.profile-section textarea{font-size:15px}

/* My Introductions cards */
.intro-journey-card{
  font-size:14px;
}
.introduction-identity h2,
.intro-journey-card .candidate-identity h2{
  font-size:22px;
  line-height:1.2;
}
.introduction-identity p,
.intro-journey-card .candidate-identity p{
  font-size:14px;
  line-height:1.5;
  color:#a7b3c5;
}
.intro-card-status small{font-size:10px}
.intro-card-status b{font-size:13px;line-height:1.35}
.intro-mini-signals b{font-size:16px}
.intro-mini-signals small{font-size:10px;line-height:1.35}
.intro-progress small{font-size:9px;line-height:1.3}
.intro-reassurance{font-size:12px;line-height:1.55}
.intro-empty-state p{font-size:14px;line-height:1.6}
.intro-principle small{font-size:9px}
.intro-principle h3{font-size:17px}
.intro-principle p{font-size:13px;line-height:1.55}
.intro-summary-strip small{font-size:10px}
.intro-tabs button{font-size:12px;padding:10px 14px}
.intro-tabs button span{font-size:9px}

/* Protect readability on small screens — do not shrink these cards back down. */
@media(max-width:760px){
  .discovery-card .candidate-identity h2,
  .daily-discovery-card .candidate-identity h2{font-size:22px}
  .discovery-card .candidate-about,
  .daily-discovery-card .candidate-about{font-size:15px!important}
  .profile-section .card p,
  .profile-side .card p,
  .profile-preview-card p,
  .profile-edit-panel p{font-size:14px}
  .intro-progress small{font-size:8.5px}
  .intro-journey-card{padding:18px}
}

/* v0.35.6.1 — Profile Form Colour
   Give editable profile sections distinct, readable colour surfaces while preserving the AutoFace dark theme. */
.profile-page .profile-form,
.profile-form-refreshed{
  background:linear-gradient(155deg,rgba(16,25,48,.97),rgba(12,18,36,.98));
  border-color:rgba(123,110,255,.24);
  box-shadow:0 22px 60px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.025);
}
.profile-form-refreshed .profile-edit-panel{
  border-width:1px;
  box-shadow:0 14px 34px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.025);
}
.profile-form-refreshed .profile-edit-panel-blue{
  background:linear-gradient(140deg,rgba(25,78,138,.42),rgba(20,38,82,.58) 55%,rgba(18,25,52,.94));
  border-color:rgba(72,164,255,.34);
}
.profile-form-refreshed .profile-edit-panel-sikh{
  background:linear-gradient(140deg,rgba(126,72,22,.36),rgba(76,45,66,.42) 52%,rgba(29,27,58,.94));
  border-color:rgba(255,154,76,.34);
}
.profile-form-refreshed .profile-edit-panel-pink{
  background:linear-gradient(140deg,rgba(112,34,82,.40),rgba(70,32,84,.46) 55%,rgba(27,25,57,.94));
  border-color:rgba(255,102,166,.34);
}
.profile-form-refreshed .profile-edit-panel-purple{
  background:linear-gradient(140deg,rgba(73,48,139,.44),rgba(44,39,99,.52) 55%,rgba(24,25,58,.94));
  border-color:rgba(139,109,255,.38);
}
.profile-form-refreshed .profile-edit-panel:before{height:3px;opacity:1}
.profile-form-refreshed .profile-edit-panel-blue:before{background:linear-gradient(90deg,#3aa7ff,#63d4ff,transparent)}
.profile-form-refreshed .profile-edit-panel-sikh:before{background:linear-gradient(90deg,#ff9948,#ff6fa7,#8b72ff,transparent)}
.profile-form-refreshed .profile-edit-panel-pink:before{background:linear-gradient(90deg,#ff6b9f,#d974ff,transparent)}
.profile-form-refreshed .profile-edit-panel-purple:before{background:linear-gradient(90deg,#8066ff,#b56cff,transparent)}
.profile-form-refreshed .profile-edit-panel-title>span{
  background:rgba(9,15,32,.58);
  border-color:rgba(255,255,255,.13);
  box-shadow:0 5px 14px rgba(0,0,0,.20);
}
.profile-form-refreshed .profile-edit-panel .field input,
.profile-form-refreshed .profile-edit-panel .field select,
.profile-form-refreshed .profile-edit-panel .field textarea{
  background:rgba(6,12,27,.72);
  border-color:rgba(162,181,222,.22);
  color:#f7f9ff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.018);
}
.profile-form-refreshed .profile-edit-panel .field input:focus,
.profile-form-refreshed .profile-edit-panel .field select:focus,
.profile-form-refreshed .profile-edit-panel .field textarea:focus{
  border-color:#6db6ff;
  box-shadow:0 0 0 3px rgba(80,168,255,.14),inset 0 1px 0 rgba(255,255,255,.02);
  outline:none;
}
.profile-form-refreshed .profile-edit-panel-pink .field input:focus,
.profile-form-refreshed .profile-edit-panel-pink .field select:focus,
.profile-form-refreshed .profile-edit-panel-pink .field textarea:focus{
  border-color:#ff78ad;
  box-shadow:0 0 0 3px rgba(255,105,157,.12);
}
.profile-form-refreshed .profile-edit-panel-purple .field input:focus,
.profile-form-refreshed .profile-edit-panel-purple .field select:focus,
.profile-form-refreshed .profile-edit-panel-purple .field textarea:focus{
  border-color:#967cff;
  box-shadow:0 0 0 3px rgba(124,92,255,.14);
}
.profile-form-refreshed .profile-edit-panel-sikh .field input:focus,
.profile-form-refreshed .profile-edit-panel-sikh .field select:focus,
.profile-form-refreshed .profile-edit-panel-sikh .field textarea:focus{
  border-color:#ffae68;
  box-shadow:0 0 0 3px rgba(255,148,78,.12);
}
.profile-form-refreshed .profile-hobbies,
.profile-form-refreshed .sikh-profile-note{
  background:rgba(7,13,29,.42);
  border:1px solid rgba(255,255,255,.08);
  border-radius:14px;
}
@media(max-width:800px){
  .profile-form-refreshed .profile-edit-panel{padding:17px}
}

/* v0.35.6.2 — Discover & Introductions Colour Cards
   Extend the Profile page's coloured-surface language to recommendation and introduction cards. */

/* Discover — coloured recommendation surfaces while preserving readability. */
.discovery-section .discovery-toolbar,
.discovery-section .daily-discovery-intro{
  background:linear-gradient(145deg,rgba(27,64,116,.36),rgba(31,30,78,.38),rgba(15,22,44,.82));
  border:1px solid rgba(86,157,255,.22);
  border-radius:18px;
  padding:18px 20px;
  box-shadow:0 14px 34px rgba(0,0,0,.16),inset 0 1px 0 rgba(255,255,255,.025);
}
.discovery-grid .discovery-card{
  position:relative;
  overflow:hidden;
  border-width:1px;
  box-shadow:0 18px 42px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.025);
}
.discovery-grid .discovery-card::before{
  content:"";
  position:absolute;
  left:0;right:0;top:0;
  height:3px;
  pointer-events:none;
}
.discovery-grid .discovery-card:nth-child(4n+1){
  background:linear-gradient(145deg,rgba(26,76,136,.44),rgba(19,42,88,.57) 55%,rgba(17,24,50,.95));
  border-color:rgba(73,163,255,.34);
}
.discovery-grid .discovery-card:nth-child(4n+1)::before{background:linear-gradient(90deg,#3aa7ff,#68d6ff,transparent)}
.discovery-grid .discovery-card:nth-child(4n+2){
  background:linear-gradient(145deg,rgba(81,46,145,.44),rgba(47,39,101,.56) 55%,rgba(23,25,57,.95));
  border-color:rgba(151,113,255,.36);
}
.discovery-grid .discovery-card:nth-child(4n+2)::before{background:linear-gradient(90deg,#8b72ff,#c36cff,transparent)}
.discovery-grid .discovery-card:nth-child(4n+3){
  background:linear-gradient(145deg,rgba(114,38,84,.38),rgba(70,35,86,.48) 55%,rgba(25,25,57,.95));
  border-color:rgba(255,103,166,.32);
}
.discovery-grid .discovery-card:nth-child(4n+3)::before{background:linear-gradient(90deg,#ff6fa7,#d977ff,transparent)}
.discovery-grid .discovery-card:nth-child(4n+4){
  background:linear-gradient(145deg,rgba(21,93,105,.34),rgba(30,58,85,.48) 55%,rgba(18,27,52,.95));
  border-color:rgba(65,205,218,.30);
}
.discovery-grid .discovery-card:nth-child(4n+4)::before{background:linear-gradient(90deg,#38d9d0,#55b7ff,transparent)}
.discovery-card .trait-icon-card,
.discovery-card .discovery-insights>div,
.discovery-card .why-atlas-card,
.discovery-card .ai-discovery-teaser{
  background:rgba(6,12,27,.48);
  border-color:rgba(191,205,238,.13);
}
.discovery-card .candidate-badges span{
  background:rgba(7,13,29,.50);
  border-color:rgba(255,255,255,.12);
}
.discovery-privacy{
  background:linear-gradient(145deg,rgba(24,87,99,.32),rgba(29,45,78,.48),rgba(15,22,44,.92));
  border-color:rgba(67,205,198,.28);
}

/* Introductions — use the same blue/purple/pink/cyan family as Profile and Discover. */
.introductions-section .intro-journey-card{
  position:relative;
  overflow:hidden;
  border-width:1px;
  box-shadow:0 18px 42px rgba(0,0,0,.22),inset 0 1px 0 rgba(255,255,255,.025);
}
.introductions-section .intro-journey-card::before{
  content:"";
  position:absolute;
  left:0;right:0;top:0;
  height:3px;
  pointer-events:none;
}
.introductions-section .intro-journey-card:nth-child(4n+1){
  background:linear-gradient(145deg,rgba(26,76,136,.44),rgba(19,42,88,.57) 55%,rgba(17,24,50,.95));
  border-color:rgba(73,163,255,.34);
}
.introductions-section .intro-journey-card:nth-child(4n+1)::before{background:linear-gradient(90deg,#3aa7ff,#68d6ff,transparent)}
.introductions-section .intro-journey-card:nth-child(4n+2){
  background:linear-gradient(145deg,rgba(81,46,145,.44),rgba(47,39,101,.56) 55%,rgba(23,25,57,.95));
  border-color:rgba(151,113,255,.36);
}
.introductions-section .intro-journey-card:nth-child(4n+2)::before{background:linear-gradient(90deg,#8b72ff,#c36cff,transparent)}
.introductions-section .intro-journey-card:nth-child(4n+3){
  background:linear-gradient(145deg,rgba(114,38,84,.38),rgba(70,35,86,.48) 55%,rgba(25,25,57,.95));
  border-color:rgba(255,103,166,.32);
}
.introductions-section .intro-journey-card:nth-child(4n+3)::before{background:linear-gradient(90deg,#ff6fa7,#d977ff,transparent)}
.introductions-section .intro-journey-card:nth-child(4n+4){
  background:linear-gradient(145deg,rgba(21,93,105,.34),rgba(30,58,85,.48) 55%,rgba(18,27,52,.95));
  border-color:rgba(65,205,218,.30);
}
.introductions-section .intro-journey-card:nth-child(4n+4)::before{background:linear-gradient(90deg,#38d9d0,#55b7ff,transparent)}
.intro-card-status,
.intro-mini-signals>div,
.intro-progress,
.intro-reassurance{
  background:rgba(6,12,27,.48);
  border-color:rgba(191,205,238,.13);
}
.intro-summary-strip{
  background:linear-gradient(145deg,rgba(35,68,119,.32),rgba(60,39,105,.35),rgba(15,22,44,.78));
  border-color:rgba(131,122,255,.22);
}
.intro-tabs{
  background:rgba(8,14,30,.55);
  border:1px solid rgba(145,157,214,.14);
  border-radius:16px;
  padding:6px;
}
.intro-principle{
  background:linear-gradient(145deg,rgba(74,44,128,.36),rgba(72,34,83,.35),rgba(16,22,45,.90));
  border-color:rgba(190,111,255,.28);
}
.intro-empty-state{
  background:linear-gradient(145deg,rgba(24,72,122,.35),rgba(51,38,96,.38),rgba(16,22,45,.92));
  border-color:rgba(100,151,255,.25);
}

@media(max-width:760px){
  .discovery-section .discovery-toolbar,
  .discovery-section .daily-discovery-intro{padding:15px 16px}
}

/* v0.35.6.3 — Atlas Relationship Profile Colour & Readability
   Bring the relationship-profile page into the same coloured-surface language as Profile, Discover and Introductions. */
.relationship-section .relationship-form{
  background:linear-gradient(155deg,rgba(16,25,48,.97),rgba(12,18,36,.98));
  border-color:rgba(123,110,255,.26);
  box-shadow:0 22px 60px rgba(0,0,0,.28),inset 0 1px 0 rgba(255,255,255,.025);
}

/* Compatibility questions — alternating coloured surfaces rather than one flat dark block. */
.relationship-section .relationship-questions{
  border-top:0;
  gap:12px;
}
.relationship-section .relationship-question{
  position:relative;
  overflow:hidden;
  padding:20px 18px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:16px;
  box-shadow:0 12px 28px rgba(0,0,0,.16),inset 0 1px 0 rgba(255,255,255,.02);
}
.relationship-section .relationship-question:nth-child(4n+1){
  background:linear-gradient(140deg,rgba(25,78,138,.42),rgba(20,38,82,.58) 55%,rgba(18,25,52,.94));
  border-color:rgba(72,164,255,.32);
}
.relationship-section .relationship-question:nth-child(4n+2){
  background:linear-gradient(140deg,rgba(73,48,139,.44),rgba(44,39,99,.52) 55%,rgba(24,25,58,.94));
  border-color:rgba(139,109,255,.36);
}
.relationship-section .relationship-question:nth-child(4n+3){
  background:linear-gradient(140deg,rgba(112,34,82,.40),rgba(70,32,84,.46) 55%,rgba(27,25,57,.94));
  border-color:rgba(255,102,166,.32);
}
.relationship-section .relationship-question:nth-child(4n+4){
  background:linear-gradient(140deg,rgba(21,93,105,.34),rgba(30,58,85,.48) 55%,rgba(18,27,52,.95));
  border-color:rgba(65,205,218,.28);
}
.relationship-section .question-number{
  background:rgba(7,13,29,.52);
  border:1px solid rgba(255,255,255,.12);
  border-radius:10px;
  padding:8px 6px;
  align-self:start;
  text-align:center;
}
.relationship-section .question-body h3{font-size:17px;line-height:1.35}
.relationship-section .question-body p{font-size:14px;line-height:1.6;color:#b7c4d6}
.relationship-section .scale-meta{font-size:12px;color:#aebbd0}
.relationship-section .scale-meta strong{font-size:13px;color:#f3f6ff}

/* WHAT MATTERS TO YOU — deliberately larger and easier to scan. */
.relationship-section .relationship-tiles-intro{
  max-width:780px;
  margin:10px 0 22px;
  font-size:15px;
  line-height:1.65;
  color:#c0ccdc;
}
.relationship-section .relationship-tile-question{
  margin:22px 0 26px;
  padding:20px;
  border-width:1px;
  box-shadow:0 14px 34px rgba(0,0,0,.17),inset 0 1px 0 rgba(255,255,255,.025);
}
.relationship-section .relationship-tile-question:nth-of-type(1){
  background:linear-gradient(140deg,rgba(25,78,138,.42),rgba(20,38,82,.58) 55%,rgba(18,25,52,.94));
  border-color:rgba(72,164,255,.34);
}
.relationship-section .relationship-tile-question:nth-of-type(2){
  background:linear-gradient(140deg,rgba(73,48,139,.44),rgba(44,39,99,.52) 55%,rgba(24,25,58,.94));
  border-color:rgba(139,109,255,.36);
}
.relationship-section .relationship-tile-question:nth-of-type(3){
  background:linear-gradient(140deg,rgba(112,34,82,.40),rgba(70,32,84,.46) 55%,rgba(27,25,57,.94));
  border-color:rgba(255,102,166,.32);
}
.relationship-section .relationship-tile-head label{
  font-size:17px;
  line-height:1.4;
  font-weight:800;
  color:#f7f8ff;
}
.relationship-section .relationship-tile-head small{
  font-size:12px;
  line-height:1.45;
  color:#a9b8cb;
}
.relationship-section .relationship-tile-head>strong{
  min-width:44px;
  padding:7px 10px;
  font-size:12px;
  color:#d5ccff;
  background:rgba(8,14,31,.52);
  border-color:rgba(160,135,255,.28);
}
.relationship-section .relationship-choice-grid{gap:10px}
.relationship-section .relationship-choice{
  min-height:45px;
  padding:11px 15px;
  background:rgba(6,12,27,.68);
  border-color:rgba(190,205,238,.16);
  color:#d4deec;
  font-size:14.5px;
  line-height:1.3;
}
.relationship-section .relationship-choice>span{
  width:22px;
  height:22px;
  font-size:11px;
  background:rgba(255,255,255,.07);
}
.relationship-section .relationship-choice.selected{
  border-color:rgba(132,111,255,.48);
  background:linear-gradient(135deg,rgba(126,99,255,.22),rgba(67,161,255,.12));
  color:#fff;
}
.relationship-section .field label,
.relationship-section .relationship-context-field label{font-size:14px;line-height:1.45}
.relationship-section .field small,
.relationship-section .relationship-context-field small{font-size:11.5px;color:#9eacc0}
.relationship-section .field input,
.relationship-section .field select,
.relationship-section .field textarea{
  background:rgba(6,12,27,.72);
  border-color:rgba(162,181,222,.22);
  color:#f7f9ff;
  font-size:15px;
}
.relationship-section .field input:focus,
.relationship-section .field select:focus,
.relationship-section .field textarea:focus{
  border-color:#806dff;
  box-shadow:0 0 0 3px rgba(124,92,255,.14);
  outline:none;
}

/* Consent and side panels use the same coloured card family. */
.relationship-section .consent-card{
  background:linear-gradient(140deg,rgba(25,78,138,.26),rgba(44,39,99,.34),rgba(18,25,52,.86));
  border-color:rgba(96,151,255,.25);
}
.relationship-section .consent-card b{font-size:14px}
.relationship-section .consent-card small{font-size:12px;line-height:1.55}
.relationship-side .atlas-card{
  background:linear-gradient(145deg,rgba(26,76,136,.42),rgba(19,42,88,.55) 55%,rgba(17,24,50,.95));
  border-color:rgba(73,163,255,.32);
}
.relationship-side .atlas-ai-card{
  background:linear-gradient(145deg,rgba(81,46,145,.42),rgba(47,39,101,.54) 55%,rgba(23,25,57,.95));
  border-color:rgba(151,113,255,.34);
}
.relationship-side .completeness-card{
  background:linear-gradient(145deg,rgba(21,93,105,.32),rgba(30,58,85,.46) 55%,rgba(18,27,52,.95));
  border-color:rgba(65,205,218,.28);
}
.relationship-side .minimisation-card{
  background:linear-gradient(145deg,rgba(112,34,82,.34),rgba(70,35,86,.44) 55%,rgba(25,25,57,.95));
  border-color:rgba(255,103,166,.28);
}
.relationship-side .card p{font-size:14px;line-height:1.6}
.relationship-side .card h3{font-size:18px;line-height:1.4}

@media(max-width:760px){
  .relationship-section .relationship-question{padding:17px 15px}
  .relationship-section .question-body h3{font-size:16px}
  .relationship-section .question-body p{font-size:13.5px}
  .relationship-section .relationship-tiles-intro{font-size:14.5px}
  .relationship-section .relationship-tile-question{padding:16px}
  .relationship-section .relationship-tile-head label{font-size:16px}
  .relationship-section .relationship-choice{font-size:14px;padding:10px 12px}
}

/* v0.35.7 — Homepage Product Story */
.product-story-section{padding:112px 0;background:radial-gradient(900px 600px at 5% 20%,rgba(37,99,235,.15),transparent 65%),radial-gradient(900px 620px at 95% 68%,rgba(168,85,247,.15),transparent 65%),linear-gradient(180deg,#081322,#0a1022)}
.product-story-intro{max-width:900px;margin:0 auto 72px;text-align:center}.product-story-intro h2{font-size:clamp(38px,5vw,66px);line-height:1.04;margin:16px 0 20px}.product-story-intro h2 em{font-style:normal;color:#a78bfa}.product-story-intro p{font-size:18px;line-height:1.7;color:#b9c5d8;max-width:760px;margin:auto}
.product-story-row{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:72px;align-items:center;padding:78px 0;border-top:1px solid rgba(148,163,184,.14)}.product-story-row:nth-of-type(3){direction:rtl}.product-story-row:nth-of-type(3)>*{direction:ltr}.product-story-copy{max-width:510px}.story-number{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:12px;background:rgba(99,102,241,.15);border:1px solid rgba(129,140,248,.35);font-weight:800;color:#c4b5fd;margin-right:12px}.story-kicker{font-size:12px;font-weight:800;letter-spacing:.16em;color:#8fb6ff}.product-story-copy h3{font-size:clamp(32px,4vw,52px);line-height:1.05;margin:20px 0 16px}.product-story-copy p{font-size:17px;line-height:1.72;color:#b9c5d8}.product-story-copy a{display:inline-flex;gap:8px;align-items:center;margin-top:18px;color:#c4b5fd;font-weight:750;text-decoration:none}
.story-visual{position:relative;border:1px solid rgba(148,163,184,.2);border-radius:26px;padding:28px;background:linear-gradient(145deg,rgba(23,32,59,.94),rgba(12,18,38,.96));box-shadow:0 28px 80px rgba(0,0,0,.32),0 0 70px rgba(99,102,241,.08)}.story-understand .story-visual{border-color:rgba(59,130,246,.32)}.story-discover .story-visual{border-color:rgba(168,85,247,.34)}.story-trust .story-visual{border-color:rgba(34,211,238,.30)}.story-window-head{display:flex;justify-content:space-between;align-items:center;color:#9fb7db;font-size:12px;font-weight:800;letter-spacing:.13em;padding-bottom:20px;border-bottom:1px solid rgba(148,163,184,.15)}
.story-profile-score{display:flex;align-items:end;justify-content:space-between;padding:25px 0}.story-profile-score strong{font-size:30px}.story-profile-score span{color:#a8b6ca}.story-signal-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.story-signal-grid span{padding:17px;border-radius:15px;background:rgba(59,130,246,.08);border:1px solid rgba(96,165,250,.18)}.story-signal-grid b,.story-signal-grid i{display:block}.story-signal-grid i{font-style:normal;color:#91a5c1;font-size:13px;margin-top:4px}.story-insight{display:flex;gap:12px;margin-top:18px;padding:17px;border-radius:15px;background:rgba(139,92,246,.10);border:1px solid rgba(167,139,250,.2);color:#cbd5e1}.story-insight p{margin:0;font-size:14px;line-height:1.55}
.discover-person{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;padding:24px 0}.discover-avatar{width:54px;height:54px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,#7c3aed,#2563eb);font-size:22px;font-weight:800}.discover-person>div:nth-child(2) strong,.discover-person>div:nth-child(2) span{display:block}.discover-person>div:nth-child(2) strong{font-size:19px}.discover-person>div:nth-child(2) span{font-size:14px;color:#9aa9bd;margin-top:4px}.discover-score{text-align:right}.discover-score b,.discover-score small{display:block}.discover-score b{font-size:30px;color:#c4b5fd}.discover-score small{font-size:10px;letter-spacing:.13em;color:#91a5c1}.story-bars{display:grid;gap:13px}.story-bars span{display:grid;grid-template-columns:82px 1fr 45px;gap:12px;align-items:center;font-size:13px}.story-bars i{height:7px;border-radius:20px;background:#202a41;overflow:hidden}.story-bars em{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,#3b82f6,#a855f7)}.story-bars strong{text-align:right;color:#dbeafe}
.trust-visual{text-align:center;padding:38px}.trust-shield{width:68px;height:68px;margin:0 auto 16px;display:grid;place-items:center;border-radius:22px;background:rgba(34,211,238,.10);border:1px solid rgba(34,211,238,.28);color:#67e8f9}.trust-title{display:flex;justify-content:center;align-items:center;gap:8px;color:#86efac;font-size:14px;font-weight:850;letter-spacing:.08em}.trust-checks{display:grid;gap:11px;margin:26px 0;text-align:left}.trust-checks span{display:flex;align-items:center;gap:12px;padding:15px 17px;border-radius:14px;background:rgba(16,185,129,.07);border:1px solid rgba(52,211,153,.18);color:#d7f8e9}.trust-checks svg{color:#6ee7b7}.trust-visual>p{font-size:13px;color:#91a5c1;margin:0}
@media(max-width:800px){.product-story-section{padding:78px 0}.product-story-intro{margin-bottom:42px;text-align:left}.product-story-row,.product-story-row:nth-of-type(3){grid-template-columns:1fr;gap:30px;padding:52px 0;direction:ltr}.product-story-copy{max-width:none}.story-visual{padding:20px;border-radius:20px}.story-signal-grid{grid-template-columns:1fr}.story-bars span{grid-template-columns:70px 1fr 42px}}


/* v0.35.7.2 — Discover Card Readability + Relationship Preference Colour */
/* Discover card lower sections: larger type, better contrast and spacing. */
.discovery-grid-wide .why-atlas-card,
.discovery-grid-wide .ai-discovery-teaser,
.discovery-grid-wide .recommendation-detail-button {
  padding: 16px !important;
}
.discovery-grid-wide .why-atlas-card {
  grid-template-columns: 42px minmax(0, 1fr) !important;
  gap: 13px !important;
}
.discovery-grid-wide .why-atlas-icon {
  width: 40px !important;
  height: 40px !important;
}
.discovery-grid-wide .why-atlas-card small,
.discovery-grid-wide .ai-discovery-teaser small,
.discovery-grid-wide .recommendation-detail-copy small {
  font-size: 11px !important;
  line-height: 1.35 !important;
  letter-spacing: .08em !important;
}
.discovery-grid-wide .why-atlas-card p {
  margin-top: 6px !important;
  font-size: 14px !important;
  line-height: 1.55 !important;
  color: #c0ccdc !important;
}
.discovery-grid-wide .ai-discovery-teaser b {
  font-size: 15px !important;
  line-height: 1.4 !important;
  color: #f5f7ff !important;
}
.discovery-grid-wide .ai-discovery-teaser em,
.discovery-grid-wide .ai-discovery-teaser p {
  font-size: 13px !important;
  line-height: 1.5 !important;
  color: #aebbd0 !important;
}
.discovery-grid-wide .recommendation-detail-button {
  min-height: 62px !important;
  margin-top: 16px !important;
}
.discovery-grid-wide .recommendation-detail-copy b {
  font-size: 15px !important;
  line-height: 1.35 !important;
}
.discovery-grid-wide .thoughtful-actions {
  gap: 10px !important;
  margin-top: 16px !important;
}
.discovery-grid-wide .thoughtful-actions .btn {
  min-height: 52px !important;
  padding: 12px 14px !important;
  font-size: 13px !important;
  letter-spacing: .01em !important;
  font-weight: 800 !important;
}
.discovery-grid-wide .decision-reassurance {
  margin-top: 10px !important;
  font-size: 12px !important;
  line-height: 1.55 !important;
  color: #9eacc0 !important;
}

/* Relationship Profile: explicit colour cards matching the profile-page visual system. */
.relationship-section .relationship-tile-question {
  position: relative;
  overflow: hidden;
  border-width: 1px !important;
  border-style: solid !important;
  border-radius: 18px !important;
  padding: 22px !important;
}
.relationship-section .relationship-tile-question::after {
  content: "";
  position: absolute;
  width: 360px;
  height: 180px;
  right: -110px;
  bottom: -105px;
  border-radius: 50%;
  pointer-events: none;
  opacity: .62;
}
.relationship-section .relationship-tile-weekend {
  background: radial-gradient(520px 250px at 8% 0%, rgba(41,153,255,.28), transparent 70%), linear-gradient(140deg, rgba(10,67,130,.88), rgba(14,37,84,.92) 58%, rgba(13,24,57,.98)) !important;
  border-color: rgba(55,165,255,.50) !important;
  box-shadow: 0 18px 45px rgba(0,81,180,.18), inset 0 1px 0 rgba(255,255,255,.05) !important;
}
.relationship-section .relationship-tile-weekend::after {
  background: radial-gradient(ellipse, rgba(33,126,255,.30), transparent 70%);
}
.relationship-section .relationship-tile-priorities {
  background: radial-gradient(520px 250px at 8% 0%, rgba(151,88,255,.30), transparent 70%), linear-gradient(140deg, rgba(66,42,145,.90), rgba(45,31,102,.94) 58%, rgba(24,24,65,.98)) !important;
  border-color: rgba(159,106,255,.52) !important;
  box-shadow: 0 18px 45px rgba(91,48,190,.20), inset 0 1px 0 rgba(255,255,255,.05) !important;
}
.relationship-section .relationship-tile-priorities::after {
  background: radial-gradient(ellipse, rgba(180,76,255,.28), transparent 70%);
}
.relationship-section .relationship-tile-nonnegotiables {
  background: radial-gradient(520px 250px at 8% 0%, rgba(255,75,145,.27), transparent 70%), linear-gradient(140deg, rgba(122,34,83,.90), rgba(75,27,79,.94) 58%, rgba(33,22,60,.98)) !important;
  border-color: rgba(255,88,153,.50) !important;
  box-shadow: 0 18px 45px rgba(184,42,99,.18), inset 0 1px 0 rgba(255,255,255,.05) !important;
}
.relationship-section .relationship-tile-nonnegotiables::after {
  background: radial-gradient(ellipse, rgba(255,72,151,.27), transparent 70%);
}
.relationship-section .relationship-tile-head,
.relationship-section .relationship-choice-grid {
  position: relative;
  z-index: 1;
}
.relationship-section .relationship-tile-head label {
  font-size: 18px !important;
}
.relationship-section .relationship-tile-head small {
  font-size: 13px !important;
}
.relationship-section .relationship-tile-head > strong {
  font-size: 13px !important;
  min-width: 48px !important;
}
.relationship-section .relationship-choice {
  min-height: 47px !important;
  font-size: 15px !important;
  background: rgba(5,12,29,.68) !important;
  border-color: rgba(194,210,240,.20) !important;
}
.relationship-section .relationship-tile-weekend .relationship-choice.selected {
  background: linear-gradient(135deg, rgba(30,116,255,.78), rgba(96,77,230,.82)) !important;
  border-color: rgba(88,186,255,.70) !important;
  color: #fff !important;
}
.relationship-section .relationship-tile-priorities .relationship-choice.selected {
  background: linear-gradient(135deg, rgba(108,77,232,.80), rgba(178,69,238,.82)) !important;
  border-color: rgba(190,121,255,.72) !important;
  color: #fff !important;
}
.relationship-section .relationship-tile-nonnegotiables .relationship-choice.selected {
  background: linear-gradient(135deg, rgba(206,54,125,.82), rgba(255,91,129,.84)) !important;
  border-color: rgba(255,126,166,.72) !important;
  color: #fff !important;
}

@media (max-width: 620px) {
  .discovery-grid-wide .why-atlas-card p { font-size: 13.5px !important; }
  .discovery-grid-wide .ai-discovery-teaser b { font-size: 14px !important; }
  .discovery-grid-wide .ai-discovery-teaser em { font-size: 12.5px !important; }
  .discovery-grid-wide .thoughtful-actions .btn { font-size: 13px !important; }
  .relationship-section .relationship-tile-question { padding: 17px !important; }
  .relationship-section .relationship-tile-head label { font-size: 17px !important; }
  .relationship-section .relationship-choice { font-size: 14.5px !important; }
}


/* v0.35.7.3 — Profile Lifestyle Readability
   Align the Lifestyle & Interests header and make hobby icons easier to see. */
.profile-form-refreshed .profile-hobbies {
  margin-top: 22px;
  padding: 20px;
}
.profile-form-refreshed .profile-hobbies-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 16px;
}
.profile-form-refreshed .profile-hobbies-title > div {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.profile-form-refreshed .profile-hobbies-title small {
  margin: 0 0 4px;
  font-size: 10px;
  line-height: 1.25;
  letter-spacing: .10em;
  color: #ffad72;
}
.profile-form-refreshed .profile-hobbies-title h4 {
  margin: 0;
  font-size: 19px;
  line-height: 1.25;
  color: #f8f9ff;
}
.profile-form-refreshed .profile-hobbies-title > span {
  flex: 0 0 auto;
  align-self: center;
  font-size: 11px;
  line-height: 1.35;
  color: #aab7ca;
  text-align: right;
}
.profile-form-refreshed .hobby-chip-grid {
  gap: 10px;
}
.profile-form-refreshed .hobby-chip {
  min-height: 82px;
  padding: 12px 8px;
  gap: 7px;
  border-radius: 13px;
}
.profile-form-refreshed .hobby-chip span {
  display: grid;
  place-items: center;
  min-width: 38px;
  min-height: 38px;
  padding: 4px;
  border-radius: 11px;
  font-size: 28px;
  line-height: 1;
  background: rgba(255,255,255,.055);
  border: 1px solid rgba(255,255,255,.08);
}
.profile-form-refreshed .hobby-chip b {
  font-size: 11px;
  line-height: 1.25;
  font-weight: 750;
  color: #d8e0ee;
  text-align: center;
}
.profile-form-refreshed .hobby-chip.selected span {
  background: rgba(126,98,255,.20);
  border-color: rgba(155,132,255,.34);
}
.profile-form-refreshed .hobby-chip.selected b {
  color: #ffffff;
}

@media (max-width: 700px) {
  .profile-form-refreshed .profile-hobbies { padding: 16px; }
  .profile-form-refreshed .profile-hobbies-title {
    align-items: flex-start;
    flex-direction: column;
    gap: 7px;
  }
  .profile-form-refreshed .profile-hobbies-title > span {
    align-self: flex-start;
    text-align: left;
  }
  .profile-form-refreshed .hobby-chip { min-height: 78px; }
  .profile-form-refreshed .hobby-chip span {
    min-width: 36px;
    min-height: 36px;
    font-size: 26px;
  }
  .profile-form-refreshed .hobby-chip b { font-size: 10.5px; }
}

/* v0.35.7.4 Founding Member */
.founder-access-section{padding:84px 0;background:radial-gradient(760px 420px at 12% 40%,rgba(245,158,11,.14),transparent 65%),radial-gradient(720px 440px at 88% 55%,rgba(147,51,234,.20),transparent 65%),#091225}.founder-access-card{display:grid;grid-template-columns:1.25fr .75fr;gap:54px;align-items:center;padding:54px;border:1px solid rgba(250,190,70,.45);border-radius:30px;background:linear-gradient(135deg,#4c2670,#162f68 48%,#692a62);box-shadow:0 30px 80px rgba(0,0,0,.32)}.founder-badge{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;border:1px solid rgba(253,205,91,.55);border-radius:999px;background:rgba(245,158,11,.14);color:#ffe39b;font-size:12px;font-weight:850;letter-spacing:.09em}.founder-access-copy h2{margin:18px 0 14px;font-size:clamp(38px,5vw,62px);line-height:1.02;color:#fff}.founder-access-copy h2 em{font-style:normal;color:#ffd56a}.founder-access-copy>p{margin:0;color:#e0e6f2;font-size:18px;line-height:1.65}.founder-access-copy>p strong{color:#fff1bd}.founder-benefits{display:flex;gap:12px;margin:28px 0 25px}.founder-benefits span{min-width:125px;padding:15px;border:1px solid rgba(255,255,255,.15);border-radius:15px;background:rgba(6,13,34,.46)}.founder-benefits b{display:block;color:#fff;font-size:27px}.founder-benefits small{display:block;margin-top:5px;color:#c7d2e5;font-size:10px;font-weight:800;letter-spacing:.08em}.founder-cta{display:inline-flex;align-items:center;gap:9px;padding:14px 20px;border-radius:12px;background:linear-gradient(135deg,#ffd15a,#ff806b 52%,#d06aff);color:#101424!important;font-size:15px;font-weight:900;text-decoration:none}.founder-qualifier{display:flex;align-items:center;gap:7px;margin-top:14px;color:#c4cee0;font-size:12px}.founder-pass{justify-self:center;width:min(100%,330px);min-height:390px;padding:26px;border:1px solid rgba(255,220,126,.58);border-radius:25px;background:radial-gradient(260px 180px at 80% 15%,rgba(255,204,82,.23),transparent 65%),linear-gradient(150deg,#2b1b58,#19285d 52%,#6b2d69);box-shadow:0 24px 55px rgba(0,0,0,.30);transform:rotate(2deg)}.founder-pass-top{display:flex;justify-content:space-between;color:#ffe39b;font-size:12px;font-weight:900;letter-spacing:.14em}.founder-pass-mark{display:grid;place-items:center;width:78px;height:78px;margin:43px auto 20px;border:1px solid rgba(255,219,116,.55);border-radius:50%;background:rgba(255,193,61,.12);color:#ffd76e;font-size:38px}.founder-pass-label{display:block;text-align:center;color:#ffd978;font-size:11px;font-weight:900;letter-spacing:.18em}.founder-pass>strong{display:block;margin-top:8px;text-align:center;color:#fff;font-size:34px}.founder-pass>p{text-align:center;color:#d9e0ef;font-size:13px;font-weight:800;line-height:1.45;letter-spacing:.12em}.founder-pass-foot{display:flex;justify-content:center;align-items:center;gap:7px;margin-top:34px;padding-top:16px;border-top:1px solid rgba(255,255,255,.12);color:#d7e5ff;font-size:10px;font-weight:800;letter-spacing:.09em}@media(max-width:850px){.founder-access-card{grid-template-columns:1fr;padding:30px}.founder-pass{transform:none}.founder-benefits{flex-wrap:wrap}}@media(max-width:520px){.founder-access-card{padding:23px 18px}.founder-benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.founder-benefits span{min-width:0;padding:10px 6px}.founder-benefits small{font-size:8px}.founder-cta{width:100%;justify-content:center}}


/* v0.35.8 — Match Intelligence Brand */
.brand-copy{display:flex;flex-direction:column;gap:1px;line-height:1}.brand-copy b{font-size:22px;letter-spacing:-.03em}.brand-copy small{font-size:9px;line-height:1.15;letter-spacing:.06em;text-transform:uppercase;color:#9fb0c8;font-weight:800}.experience-kicker{background:linear-gradient(135deg,rgba(76,125,255,.14),rgba(168,85,247,.16));border-color:rgba(139,116,255,.35)}@media(max-width:800px){.brand-copy b{font-size:19px}.brand-copy small{font-size:7.5px;max-width:135px}.brand{gap:8px}}@media(max-width:430px){.brand-copy small{display:none}}


/* v0.35.8.1 — mip.chat domain identity */
.mip-domain-chip{display:inline-flex;align-items:center;margin-left:7px;padding:4px 9px;border:1px solid rgba(103,201,255,.38);border-radius:999px;background:linear-gradient(135deg,rgba(46,160,255,.14),rgba(158,83,255,.16));color:#8fdcff;font-size:10px;font-weight:900;letter-spacing:.08em;text-transform:lowercase;box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}
.brand-copy small strong{color:#7fd6ff;font-weight:850;letter-spacing:.02em}.footer-inner>span:nth-child(2) b{color:#83d9ff;font-weight:850}
@media(max-width:560px){.mip-domain-chip{margin-left:4px;padding:3px 7px;font-size:9px}.brand-copy small strong{display:inline}}


/* v0.35.8.2 — Get Started readability */
.onboarding-section .simple-journey-card h2{font-size:26px!important;line-height:1.2!important}
.onboarding-section .simple-journey-grid>div{min-height:150px!important;padding:20px!important}
.onboarding-section .simple-journey-grid>div>span{font-size:10px!important}
.onboarding-section .simple-journey-grid svg{width:28px!important;height:28px!important;margin-bottom:12px!important}
.onboarding-section .simple-journey-grid b{font-size:16px!important;line-height:1.3!important}
.onboarding-section .simple-journey-grid p{font-size:13.5px!important;line-height:1.55!important;color:#aebbd0!important}
.onboarding-section .onboarding-card-head h2{font-size:26px!important}
.onboarding-section .onboarding-step-copy small{font-size:10px!important;line-height:1.3!important}
.onboarding-section .onboarding-step-copy b{font-size:15px!important;line-height:1.35!important;color:#f2f5fb!important}
.onboarding-section .onboarding-step-copy p{font-size:13px!important;line-height:1.5!important;color:#9fafc4!important;margin-top:3px!important}
.onboarding-section .onboarding-rail-step>strong{font-size:10px!important}
.onboarding-section .onboarding-rail-step{grid-template-columns:48px minmax(0,1fr) 54px!important;gap:14px!important;padding:14px 8px!important}
.onboarding-section .onboarding-step-marker{width:42px!important;height:42px!important}
.onboarding-section .onboarding-step-marker svg{width:18px!important;height:18px!important}
.onboarding-section .privacy-kicker{font-size:11px!important;letter-spacing:.10em!important}
.onboarding-side .onboarding-next-card h3,.onboarding-side .onboarding-control-card h3,.onboarding-side .beta-feedback-card h3{font-size:21px!important;line-height:1.25!important}
.onboarding-side .onboarding-next-card p,.onboarding-side .onboarding-control-card p,.onboarding-side .beta-feedback-card>p{font-size:13px!important;line-height:1.55!important;color:#aebbd0!important}
.onboarding-side .beta-feedback-card label{font-size:12px!important}
.onboarding-side .beta-feedback-card select,.onboarding-side .beta-feedback-card textarea{font-size:13px!important;line-height:1.45!important}
.onboarding-side .onboarding-intro-count strong{font-size:20px!important}
.onboarding-side .onboarding-intro-count span{font-size:11px!important}
@media(max-width:760px){.onboarding-section .simple-journey-grid{grid-template-columns:1fr!important;gap:12px!important}.onboarding-section .simple-journey-grid>i{display:none}.onboarding-section .simple-journey-grid>div{min-height:auto!important}.onboarding-section .onboarding-rail-step{grid-template-columns:44px 1fr!important}.onboarding-section .onboarding-rail-step>strong{grid-column:2!important;justify-self:start!important}}

/* v0.35.8.3 — Compatibility Colour System
   Give each major Compatibility area a distinct, readable AutoFace colour identity. */
.compatibility-section .candidate-picker-card{
  background:radial-gradient(560px 250px at 8% 0%,rgba(43,144,255,.22),transparent 68%),linear-gradient(145deg,rgba(18,65,124,.62),rgba(16,30,68,.92) 58%,rgba(12,20,44,.98))!important;
  border-color:rgba(74,164,255,.38)!important;
  box-shadow:0 18px 44px rgba(12,75,160,.13),inset 0 1px 0 rgba(255,255,255,.04)!important;
}
.compatibility-section .compatibility-score-card{
  background:radial-gradient(560px 260px at 90% 8%,rgba(193,73,255,.22),transparent 68%),linear-gradient(145deg,rgba(73,42,142,.66),rgba(39,31,92,.91) 58%,rgba(21,22,54,.98))!important;
  border-color:rgba(164,107,255,.42)!important;
  box-shadow:0 18px 44px rgba(83,46,176,.15),inset 0 1px 0 rgba(255,255,255,.04)!important;
}
.compatibility-section .dimension-card{
  background:radial-gradient(620px 280px at 8% 0%,rgba(255,76,148,.19),transparent 70%),linear-gradient(145deg,rgba(111,35,82,.58),rgba(63,30,79,.86) 58%,rgba(25,23,54,.98))!important;
  border-color:rgba(255,101,163,.36)!important;
  box-shadow:0 18px 44px rgba(177,44,102,.12),inset 0 1px 0 rgba(255,255,255,.04)!important;
}
.compatibility-section .dimension-row{
  margin:0 -8px;
  padding:18px 10px;
  border-bottom-color:rgba(255,255,255,.09);
  border-radius:12px;
}
.compatibility-section .dimension-row:nth-child(4n+1){background:rgba(54,137,255,.055)}
.compatibility-section .dimension-row:nth-child(4n+2){background:rgba(149,93,255,.055)}
.compatibility-section .dimension-row:nth-child(4n+3){background:rgba(244,82,149,.05)}
.compatibility-section .dimension-row:nth-child(4n+4){background:rgba(49,203,198,.045)}
.compatibility-section .compatibility-side > .card:nth-of-type(1){
  background:linear-gradient(145deg,rgba(14,87,96,.55),rgba(18,43,69,.90) 62%,rgba(12,23,44,.98))!important;
  border-color:rgba(72,216,203,.34)!important;
}
.compatibility-section .compatibility-side > .card:nth-of-type(2){
  background:linear-gradient(145deg,rgba(116,69,25,.48),rgba(73,45,46,.76) 62%,rgba(28,25,47,.98))!important;
  border-color:rgba(255,183,77,.35)!important;
}
.compatibility-section .compatibility-side > .card:nth-of-type(3){
  background:linear-gradient(145deg,rgba(35,77,128,.50),rgba(34,45,94,.82) 62%,rgba(20,23,53,.98))!important;
  border-color:rgba(87,163,255,.34)!important;
}
.compatibility-section .methodology-card{
  background:linear-gradient(145deg,rgba(48,57,96,.56),rgba(30,34,70,.90) 62%,rgba(19,21,48,.98))!important;
  border-color:rgba(140,151,213,.30)!important;
}
.compatibility-section .atlas-ai-compat-card{
  background:radial-gradient(440px 220px at 90% 0%,rgba(91,178,255,.16),transparent 68%),linear-gradient(145deg,rgba(73,44,146,.62),rgba(34,48,104,.88) 60%,rgba(20,23,53,.98))!important;
  border-color:rgba(133,112,255,.40)!important;
}
.compatibility-section .privacy-kicker{color:#8fd7ff}
.compatibility-section .compatibility-score-card .privacy-kicker,
.compatibility-section .atlas-ai-compat-card .privacy-kicker{color:#c9a5ff}
.compatibility-section .dimension-card .privacy-kicker{color:#ff9dc8}
.compatibility-section .compatibility-side > .card:nth-of-type(1) .privacy-kicker{color:#7fe7d6}
.compatibility-section .compatibility-side > .card:nth-of-type(2) .privacy-kicker{color:#ffd08a}
.compatibility-section .compatibility-side h3{font-size:21px;line-height:1.25;margin-top:8px}
.compatibility-section .insight-stack>div{background:rgba(5,13,31,.38);border-color:rgba(255,255,255,.11)}
.compatibility-section .insight-stack b{font-size:14px}.compatibility-section .insight-stack span{font-size:12px}

@media(max-width:800px){
  .compatibility-section .compatibility-main,.compatibility-section .compatibility-side{gap:14px}
  .compatibility-section .candidate-picker-card,.compatibility-section .compatibility-score-card,.compatibility-section .dimension-card,.compatibility-section .compatibility-side>.card{border-radius:17px}
}


/* v0.35.8.3.1 — Compatibility Dimension Colour Refinement
   Keep the parent panel neutral and colour each dimension independently for faster scanning. */
.compatibility-section .dimension-card{
  background:radial-gradient(660px 280px at 90% 0%,rgba(116,83,255,.12),transparent 70%),linear-gradient(145deg,rgba(15,27,58,.96),rgba(10,19,42,.98))!important;
  border-color:rgba(122,145,214,.30)!important;
  box-shadow:0 18px 44px rgba(4,10,28,.28),inset 0 1px 0 rgba(255,255,255,.04)!important;
}
.compatibility-section .dimension-card .privacy-kicker{color:#ff86c8!important}
.compatibility-section .dimension-list{gap:10px;border-top:0!important;margin-top:22px!important}
.compatibility-section .dimension-row{
  position:relative;
  margin:0!important;
  padding:18px 20px!important;
  border:1px solid rgba(255,255,255,.10)!important;
  border-radius:14px!important;
  overflow:hidden;
}
.compatibility-section .dimension-row::before{
  content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--dimension-accent,#7c5cff);
}
.compatibility-section .dimension-row:nth-child(n){background:linear-gradient(120deg,var(--dimension-bg,rgba(124,92,255,.12)),rgba(9,18,41,.72))!important}
.compatibility-section .dimension-familyOrientation{--dimension-accent:#ff59b5;--dimension-bg:rgba(177,41,126,.25);border-color:rgba(255,89,181,.34)!important}
.compatibility-section .dimension-communicationDirectness{--dimension-accent:#5596ff;--dimension-bg:rgba(37,92,190,.26);border-color:rgba(85,150,255,.36)!important}
.compatibility-section .dimension-socialEnergy{--dimension-accent:#43dc87;--dimension-bg:rgba(21,124,82,.25);border-color:rgba(67,220,135,.34)!important}
.compatibility-section .dimension-careerPriority{--dimension-accent:#ffa719;--dimension-bg:rgba(145,82,16,.27);border-color:rgba(255,167,25,.36)!important}
.compatibility-section .dimension-routineVsAdventure{--dimension-accent:#25d6db;--dimension-bg:rgba(13,117,131,.28);border-color:rgba(37,214,219,.35)!important}
.compatibility-section .dimension-relocationFlexibility{--dimension-accent:#9b6dff;--dimension-bg:rgba(91,55,161,.27);border-color:rgba(155,109,255,.36)!important}
.compatibility-section .dimension-sharedInterestsImportance{--dimension-accent:#ff7d63;--dimension-bg:rgba(143,63,49,.26);border-color:rgba(255,125,99,.34)!important}
.compatibility-section .dimension-independencePreference{--dimension-accent:#63c7ff;--dimension-bg:rgba(30,103,146,.25);border-color:rgba(99,199,255,.34)!important}
.compatibility-section .dimension-relationshipPace{--dimension-accent:#d06cff;--dimension-bg:rgba(112,48,143,.26);border-color:rgba(208,108,255,.34)!important}
.compatibility-section .dimension-heading b{font-size:15px!important;color:#fff!important}
.compatibility-section .dimension-heading span{font-size:11px!important;color:var(--dimension-accent)!important;font-weight:800}
.compatibility-section .dimension-values span{font-size:12px!important;background:rgba(255,255,255,.065)!important;color:#d4dcec!important}
.compatibility-section .dimension-copy small{font-size:13px!important;color:#aebbd0!important;line-height:1.5!important}
.compatibility-section .dimension-score{width:56px!important;height:56px!important;font-size:18px!important;border:1px solid color-mix(in srgb,var(--dimension-accent) 48%, transparent)!important;background:rgba(8,18,42,.55)!important;color:var(--dimension-accent)!important}
.compatibility-section .dimension-score.good,.compatibility-section .dimension-score.attention{color:var(--dimension-accent)!important;border-color:color-mix(in srgb,var(--dimension-accent) 55%, transparent)!important;background:rgba(8,18,42,.55)!important}
@media(max-width:800px){.compatibility-section .dimension-row{padding:16px!important}.compatibility-section .dimension-heading b{font-size:14px!important}.compatibility-section .dimension-copy small{font-size:12.5px!important}.compatibility-section .dimension-score{width:48px!important;height:48px!important;font-size:16px!important}}


/* v0.35.8.4 — Discovery Preferences Colour System */
.discovery-preferences-section{background:radial-gradient(720px 480px at 8% 10%,rgba(37,99,235,.10),transparent 64%),radial-gradient(680px 460px at 94% 28%,rgba(168,85,247,.10),transparent 64%),transparent}
.preference-form-colour{background:linear-gradient(180deg,rgba(8,17,37,.90),rgba(8,14,31,.96))!important;border-color:rgba(123,144,190,.22)!important;padding:18px!important}
.preference-form-colour .card-inside{position:relative;overflow:hidden;border-radius:18px!important;padding:22px!important;margin:0!important}
.preference-form-colour .card-inside::after{content:"";position:absolute;width:330px;height:170px;right:-110px;bottom:-100px;border-radius:50%;pointer-events:none;opacity:.50}
.preference-form-colour .card-inside>*{position:relative;z-index:1}
.preference-hard{border:1px solid rgba(59,153,255,.48)!important;background:radial-gradient(520px 250px at 8% 0%,rgba(37,139,255,.26),transparent 70%),linear-gradient(140deg,rgba(12,61,121,.86),rgba(16,38,79,.94) 58%,rgba(11,24,53,.98))!important;box-shadow:0 18px 42px rgba(0,84,180,.16),inset 0 1px 0 rgba(255,255,255,.05)!important}
.preference-hard::after{background:radial-gradient(ellipse,rgba(48,145,255,.30),transparent 70%)}
.preference-lifestyle{border:1px solid rgba(175,103,255,.50)!important;background:radial-gradient(520px 250px at 8% 0%,rgba(157,83,255,.28),transparent 70%),linear-gradient(140deg,rgba(72,42,145,.90),rgba(47,31,103,.94) 58%,rgba(25,23,65,.98))!important;box-shadow:0 18px 42px rgba(93,48,190,.18),inset 0 1px 0 rgba(255,255,255,.05)!important}
.preference-lifestyle::after{background:radial-gradient(ellipse,rgba(190,76,255,.28),transparent 70%)}
.preference-career{border:1px solid rgba(45,211,221,.46)!important;background:radial-gradient(520px 250px at 8% 0%,rgba(24,198,211,.23),transparent 70%),linear-gradient(140deg,rgba(10,86,100,.88),rgba(17,52,78,.94) 58%,rgba(12,28,55,.98))!important;box-shadow:0 18px 42px rgba(0,120,140,.15),inset 0 1px 0 rgba(255,255,255,.05)!important}
.preference-career::after{background:radial-gradient(ellipse,rgba(34,211,238,.25),transparent 70%)}
.preference-form-colour .preference-relocation{margin-top:0;padding:18px!important;border:1px solid rgba(251,191,36,.42)!important;border-radius:16px!important;background:linear-gradient(135deg,rgba(116,73,15,.48),rgba(52,39,33,.72),rgba(29,28,48,.88))!important}
.preference-form-colour .preference-relocation span b{color:#fff2c2!important;font-size:14px!important}.preference-form-colour .preference-relocation span small{color:#d8c9a4!important;font-size:12px!important;line-height:1.5!important}
.preference-form-colour .field label,.preference-form-colour .preference-block>label:first-child,.preference-form-colour .preference-age label{color:#dbe6f6!important;font-size:13px!important;font-weight:750!important}
.preference-form-colour input[type="number"],.preference-form-colour select{background:rgba(5,12,29,.74)!important;border-color:rgba(200,218,250,.20)!important;color:#f7f9ff!important}
.preference-form-colour .field small{color:#b9c7da!important;font-size:11.5px!important;line-height:1.5!important}
.preference-form-colour .toggle-row{border-color:rgba(210,224,255,.16)!important;background:rgba(5,12,29,.54)!important}
.preference-form-colour .toggle-row:has(input:checked){border-color:rgba(125,103,255,.56)!important;background:linear-gradient(135deg,rgba(98,77,225,.34),rgba(38,122,215,.18))!important}
.preference-form-colour .preference-interest-chip{min-height:44px;background:rgba(5,12,29,.62)!important;border-color:rgba(210,224,255,.16)!important;color:#d8e2f2!important;font-size:11px!important}.preference-form-colour .preference-interest-chip span{font-size:17px!important}.preference-form-colour .preference-interest-chip.selected{background:linear-gradient(135deg,rgba(113,78,238,.72),rgba(37,131,238,.54))!important;border-color:rgba(174,139,255,.62)!important;color:#fff!important}
.preference-explainer{border-color:rgba(105,122,255,.38)!important;background:radial-gradient(420px 250px at 80% 0%,rgba(111,76,255,.20),transparent 68%),linear-gradient(160deg,rgba(24,31,72,.96),rgba(11,21,46,.98))!important;box-shadow:0 20px 48px rgba(30,26,100,.16)!important}.preference-explainer .recommendation-flow span{background:rgba(5,12,29,.58)!important;border:1px solid rgba(157,137,255,.18);color:#e4e7ff!important;font-size:12px!important}.preference-explainer .recommendation-flow b{color:#9f8cff!important;font-size:14px!important}
.preference-form-colour .journey-complete-card{border-color:rgba(52,211,153,.42)!important;background:linear-gradient(135deg,rgba(10,94,75,.50),rgba(15,51,64,.76),rgba(18,31,58,.92))!important}
@media(max-width:700px){.preference-form-colour{padding:12px!important}.preference-form-colour .card-inside{padding:17px!important}}

/* v0.35.8.5 — Context-aware AutoFace Assistant */
.support-panel{width:min(430px,calc(100vw - 28px));height:min(650px,calc(100vh - 105px));border-color:rgba(93,128,255,.34);background:radial-gradient(360px 210px at 90% 0%,rgba(137,83,255,.15),transparent 70%),rgba(8,13,24,.988)}
.support-header{grid-template-columns:46px 1fr 34px;padding:16px;border-bottom-color:rgba(134,151,204,.16)}
.support-avatar{width:44px;height:44px;border-radius:14px;font-size:17px;box-shadow:0 10px 28px rgba(94,87,255,.22)}
.support-header b{font-size:15px}.support-header span{font-size:11px;color:#9aabc2}
.support-boundary{padding:9px 14px;font-size:9px;color:#93cdb7}
.support-messages{padding:16px;gap:12px}
.support-message{padding:12px 14px;border-radius:15px}.support-message>span{font-size:9px}.support-message p{font-size:13.5px;line-height:1.6;color:#c8d2df}.support-action{font-size:12px;margin-top:9px}
.support-quick{display:grid;grid-template-columns:1fr 1fr;gap:7px;padding:0 14px 12px;overflow:visible}.support-quick button{white-space:normal;text-align:left;padding:9px 10px;border-radius:12px;font-size:11px;line-height:1.35;background:linear-gradient(145deg,rgba(85,105,220,.10),rgba(145,70,210,.05));color:#b9c6d8}
.support-composer input{font-size:13px;padding:12px 13px}.support-composer button{font-size:12px;padding:0 16px}
@media(max-width:620px){.support-panel{width:calc(100vw - 20px);height:min(650px,calc(100vh - 84px))}.support-quick{grid-template-columns:1fr}.support-message p{font-size:13px}}


/* v0.35.8.6 — Introductions status navigation visibility */
.introductions-section .intro-tabs{
  width:100%;max-width:880px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;padding:9px;margin-bottom:26px;border:1px solid rgba(135,112,255,.24);
  border-radius:20px;background:linear-gradient(145deg,rgba(18,26,58,.84),rgba(12,18,40,.94));
  box-shadow:0 18px 44px rgba(0,0,0,.18),inset 0 1px 0 rgba(255,255,255,.035);
}
.introductions-section .intro-tabs .intro-tab{
  display:grid;grid-template-columns:46px minmax(0,1fr) auto;align-items:center;gap:12px;
  min-height:82px;padding:14px 16px;border:1px solid transparent;border-radius:15px;
  text-align:left;cursor:pointer;transition:transform .16s ease,border-color .16s ease,box-shadow .16s ease,filter .16s ease;
}
.introductions-section .intro-tabs .intro-tab:hover{transform:translateY(-1px);filter:brightness(1.08)}
.introductions-section .intro-tabs .intro-tab>svg{width:42px;height:42px;padding:10px;border-radius:13px;stroke-width:2.2}
.introductions-section .intro-tab-copy{display:flex!important;flex-direction:column;gap:4px;min-width:0;padding:0!important;background:transparent!important}
.introductions-section .intro-tab-copy b{font-size:16px;line-height:1.15;color:#f7f9ff}
.introductions-section .intro-tab-copy small{font-size:11px;line-height:1.25;color:#b7c3d7;font-weight:600}
.introductions-section .intro-tab-count{display:grid!important;place-items:center;min-width:30px!important;height:30px;padding:0 8px!important;border-radius:999px!important;font-size:13px!important;font-weight:900;color:#fff}

.introductions-section .intro-tab-mutual{
  background:linear-gradient(135deg,rgba(135,35,103,.50),rgba(80,39,124,.50),rgba(23,29,63,.88))!important;
  border-color:rgba(255,93,175,.30)!important;
}
.introductions-section .intro-tab-mutual>svg{color:#ff78bd;background:rgba(255,69,162,.13);border:1px solid rgba(255,105,181,.25)}
.introductions-section .intro-tab-mutual .intro-tab-count{background:linear-gradient(135deg,#f0449c,#b85cff)!important}
.introductions-section .intro-tab-mutual.active{
  background:linear-gradient(135deg,rgba(188,42,118,.82),rgba(110,45,159,.76),rgba(35,36,81,.94))!important;
  border-color:rgba(255,91,177,.78)!important;
  box-shadow:0 12px 30px rgba(213,44,142,.22),inset 0 0 0 1px rgba(255,255,255,.07)!important;
}

.introductions-section .intro-tab-waiting{
  background:linear-gradient(135deg,rgba(24,76,150,.50),rgba(35,51,119,.53),rgba(19,27,58,.90))!important;
  border-color:rgba(67,145,255,.32)!important;
}
.introductions-section .intro-tab-waiting>svg{color:#62adff;background:rgba(42,122,255,.13);border:1px solid rgba(74,151,255,.26)}
.introductions-section .intro-tab-waiting .intro-tab-count{background:linear-gradient(135deg,#2676e8,#5a72ff)!important}
.introductions-section .intro-tab-waiting.active{
  background:linear-gradient(135deg,rgba(30,101,196,.78),rgba(48,62,151,.74),rgba(27,35,77,.96))!important;
  border-color:rgba(73,155,255,.78)!important;
  box-shadow:0 12px 30px rgba(40,111,230,.22),inset 0 0 0 1px rgba(255,255,255,.07)!important;
}

.introductions-section .intro-tab-saved{
  background:linear-gradient(135deg,rgba(20,100,84,.47),rgba(19,74,85,.50),rgba(17,29,58,.90))!important;
  border-color:rgba(49,202,151,.30)!important;
}
.introductions-section .intro-tab-saved>svg{color:#51e2a1;background:rgba(31,199,137,.12);border:1px solid rgba(62,220,158,.24)}
.introductions-section .intro-tab-saved .intro-tab-count{background:linear-gradient(135deg,#1ba66b,#21c996)!important}
.introductions-section .intro-tab-saved.active{
  background:linear-gradient(135deg,rgba(23,125,96,.74),rgba(24,91,105,.72),rgba(22,37,72,.96))!important;
  border-color:rgba(58,220,163,.70)!important;
  box-shadow:0 12px 30px rgba(25,154,112,.20),inset 0 0 0 1px rgba(255,255,255,.07)!important;
}

.introductions-hero .intro-summary-strip{gap:12px}
.introductions-hero .intro-summary-strip>span{
  min-width:190px;min-height:58px;padding:12px 15px;border-color:rgba(137,117,255,.18);
  background:linear-gradient(135deg,rgba(28,43,87,.72),rgba(38,29,79,.62));
}
.introductions-hero .intro-summary-strip svg{width:20px;height:20px}
.introductions-hero .intro-summary-strip b{font-size:20px}
.introductions-hero .intro-summary-strip small{font-size:11px;line-height:1.3;color:#b9c5d8}

@media(max-width:760px){
  .introductions-section .intro-tabs{grid-template-columns:1fr;max-width:none}
  .introductions-section .intro-tabs .intro-tab{min-height:72px;grid-template-columns:40px minmax(0,1fr) auto;padding:12px 14px}
  .introductions-section .intro-tabs .intro-tab>svg{width:38px;height:38px;padding:9px}
  .introductions-section .intro-tab-copy b{font-size:15px}
  .introductions-section .intro-tab-copy small{font-size:10.5px}
}


/* v0.35.9 — Email Notifications & Communication Preferences */
.notification-preferences-card{
  background:radial-gradient(520px 300px at 8% 0%,rgba(68,139,255,.10),transparent 68%),
             radial-gradient(520px 320px at 96% 30%,rgba(174,75,255,.11),transparent 68%),
             linear-gradient(155deg,rgba(14,24,53,.98),rgba(14,18,42,.98))!important;
  border-color:rgba(117,137,212,.28)!important;
}
.notification-channel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:22px 0}
.notification-channel{
  padding:18px;border-radius:18px;border:1px solid rgba(255,255,255,.10);
  background:rgba(4,12,31,.48);
}
.notification-channel-app{border-color:rgba(72,157,255,.30);background:linear-gradient(145deg,rgba(22,65,122,.38),rgba(9,22,53,.72))}
.notification-channel-email{border-color:rgba(185,101,255,.32);background:linear-gradient(145deg,rgba(86,43,128,.42),rgba(19,20,58,.74))}
.notification-channel-head{display:flex;gap:12px;align-items:center;margin-bottom:14px}
.notification-channel-head>span{
  display:grid;place-items:center;width:40px;height:40px;border-radius:13px;
  background:rgba(255,255,255,.07);font-size:19px;color:#c7dcff;
}
.notification-channel-email .notification-channel-head>span{color:#e8b9ff;background:rgba(191,91,255,.11)}
.notification-channel-head div{display:flex;flex-direction:column;gap:3px}
.notification-channel-head b{font-size:16px;color:#fff}
.notification-channel-head small{font-size:11px;color:#aebbd0;line-height:1.4}
.notification-channel .toggle-row{background:rgba(4,11,27,.48)!important;border-color:rgba(195,215,250,.13)!important}
.notification-channel .toggle-row:has(input:checked){border-color:rgba(116,104,255,.46)!important;background:linear-gradient(135deg,rgba(88,70,218,.24),rgba(42,109,194,.14))!important}
.notification-channel-email .toggle-row:has(input:checked){border-color:rgba(191,99,255,.46)!important;background:linear-gradient(135deg,rgba(130,62,194,.25),rgba(73,58,154,.17))!important}
.email-privacy-note{
  display:flex;flex-direction:column;gap:6px;margin:0 0 18px;padding:16px 18px;
  border:1px solid rgba(49,210,173,.28);border-radius:15px;
  background:linear-gradient(135deg,rgba(12,89,77,.24),rgba(12,31,53,.64));
}
.email-privacy-note b{color:#9ce8d0;font-size:13px}
.email-privacy-note span{color:#b8c7d8;font-size:12px;line-height:1.55}
@media(max-width:850px){.notification-channel-grid{grid-template-columns:1fr}}


/* v0.35.9.2 — Authenticity Centre production cleanup */
.face-verification-action{
  border-color:rgba(55,211,165,.34)!important;
  background:linear-gradient(135deg,rgba(13,99,83,.30),rgba(16,42,66,.62),rgba(18,25,54,.84))!important;
}
.face-verification-action .status-pill{
  background:rgba(39,201,151,.12)!important;
  border-color:rgba(67,222,174,.30)!important;
  color:#8ee8c9!important;
}
.face-verification-complete{display:flex;flex-direction:column;align-items:flex-start;gap:10px}
.face-verification-action .facial-principle{color:#8ee8c9!important}


/* v0.35.9.3 — Blocked Profiles & Unblock Management */
.blocked-profiles-card{
  background:radial-gradient(520px 260px at 94% 0%,rgba(244,63,94,.10),transparent 68%),
             linear-gradient(155deg,rgba(21,27,55,.97),rgba(12,18,39,.98))!important;
  border-color:rgba(251,113,133,.24)!important;
}
.blocked-profile-list{display:grid;gap:11px;margin:20px 0}
.blocked-profile-row{
  display:grid;grid-template-columns:48px minmax(0,1fr) auto;gap:14px;align-items:center;
  padding:14px 15px;border:1px solid rgba(251,113,133,.17);border-radius:15px;
  background:linear-gradient(135deg,rgba(73,28,54,.38),rgba(12,22,47,.72));
}
.blocked-profile-avatar{
  display:grid;place-items:center;width:46px;height:46px;border-radius:14px;
  background:linear-gradient(135deg,rgba(244,63,94,.28),rgba(139,92,246,.26));
  border:1px solid rgba(251,113,133,.24);color:#ffd4dc;font-size:18px;font-weight:900;
}
.blocked-profile-copy{display:flex;flex-direction:column;gap:3px;min-width:0}
.blocked-profile-copy b{color:#fff;font-size:15px}
.blocked-profile-copy span{color:#c2ccdc;font-size:12px}
.blocked-profile-copy small{color:#8999af;font-size:10px;line-height:1.4}
.unblock-button{
  border-color:rgba(74,222,128,.35)!important;color:#a7f3d0!important;
  background:rgba(16,185,129,.08)!important;
}
.unblock-button:hover{background:rgba(16,185,129,.16)!important}
.blocked-empty{
  display:flex;flex-direction:column;gap:6px;margin:18px 0;padding:18px;border-radius:14px;
  border:1px dashed rgba(148,163,184,.22);background:rgba(4,12,28,.35);
}
.blocked-empty b{color:#dfe7f4}.blocked-empty span{color:#92a2b9;font-size:12px;line-height:1.55}
.blocked-privacy-note{
  display:flex;flex-direction:column;gap:5px;padding:15px 17px;border-radius:14px;
  border:1px solid rgba(96,165,250,.20);background:rgba(37,99,235,.07);
}
.blocked-privacy-note b{color:#b9d8ff;font-size:12px}
.blocked-privacy-note span{color:#9eacc0;font-size:11px;line-height:1.55}
@media(max-width:650px){
  .blocked-profile-row{grid-template-columns:42px 1fr}
  .blocked-profile-avatar{width:40px;height:40px}
  .blocked-profile-row .unblock-button{grid-column:1/-1;width:100%}
}


/* v0.35.9.4 — Face verification card formatting */
.face-verification-action{
  display:flex!important;
  flex-direction:column;
  gap:18px!important;
  padding:22px!important;
  border-radius:18px!important;
  overflow:hidden;
}
.face-verification-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
}
.face-verification-header>div{
  min-width:0;
}
.face-verification-header strong{
  display:block;
  margin:0 0 7px;
  font-size:18px;
  line-height:1.2;
  color:#fff;
}
.face-verification-header p{
  margin:0;
  max-width:620px;
  font-size:14px;
  line-height:1.55;
  color:#aebbd0;
}
.face-status-badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  flex:0 0 auto;
  min-height:34px;
  padding:7px 12px;
  border-radius:999px;
  font-size:11px;
  line-height:1;
  font-weight:900;
  letter-spacing:.04em;
  text-transform:uppercase;
}
.face-status-badge.verified{
  color:#9df0d1;
  border:1px solid rgba(68,223,169,.32);
  background:rgba(28,177,126,.13);
}
.face-status-badge.pending{
  color:#d9cbff;
  border:1px solid rgba(153,119,255,.28);
  background:rgba(112,80,212,.13);
}
.face-verification-result{
  display:grid;
  grid-template-columns:44px minmax(0,1fr);
  gap:14px;
  align-items:center;
  padding:15px 16px;
  border-radius:15px;
}
.face-verification-result.verified{
  border:1px solid rgba(63,211,166,.30);
  background:linear-gradient(135deg,rgba(15,108,87,.24),rgba(15,47,67,.48));
}
.face-verification-result.pending{
  border:1px solid rgba(140,115,255,.24);
  background:linear-gradient(135deg,rgba(74,55,144,.22),rgba(20,30,60,.52));
}
.face-result-icon{
  display:grid;
  place-items:center;
  width:42px;
  height:42px;
  border-radius:13px;
  font-size:19px;
  font-weight:900;
}
.face-verification-result.verified .face-result-icon{
  color:#9df0d1;
  border:1px solid rgba(63,211,166,.28);
  background:rgba(37,176,126,.12);
}
.face-verification-result.pending .face-result-icon{
  color:#cabaff;
  border:1px solid rgba(153,119,255,.25);
  background:rgba(112,80,212,.10);
}
.face-result-copy{
  display:flex;
  flex-direction:column;
  gap:4px;
}
.face-result-copy b{
  color:#fff;
  font-size:14px;
}
.face-result-copy span{
  color:#a8b6ca;
  font-size:12px;
  line-height:1.45;
}
.face-verification-footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
}
.face-verification-footer .facial-principle{
  margin:0!important;
  padding:7px 10px!important;
  border-radius:999px!important;
  font-size:10px!important;
  line-height:1.2!important;
  font-weight:800;
  white-space:normal;
}
.face-verification-footer .btn{
  flex:0 0 auto;
  min-width:150px;
}

@media(max-width:760px){
  .face-verification-header,
  .face-verification-footer{
    flex-direction:column;
    align-items:stretch;
  }
  .face-status-badge{
    align-self:flex-start;
  }
  .face-verification-footer .btn{
    width:100%;
  }
}


/* v0.35.9.5 — Atlas Reflection simplification */
.atlas-reflection-card{
  background:
    radial-gradient(420px 230px at 92% 0%,rgba(124,92,255,.18),transparent 70%),
    linear-gradient(155deg,rgba(49,31,101,.92),rgba(27,25,73,.96))!important;
}
.atlas-reflection-card .atlas-ai-title{margin-bottom:8px}
.atlas-reflection-card .atlas-ai-title h3{max-width:320px}
.atlas-reflection-button{margin-top:8px}
.atlas-reflection-output{
  margin-top:16px!important;
  padding:18px!important;
  border:1px solid rgba(152,126,255,.34)!important;
  background:linear-gradient(145deg,rgba(65,51,133,.46),rgba(21,28,67,.64))!important;
}
.atlas-reflection-output p{
  white-space:pre-line;
  margin:10px 0 0!important;
  color:#d4d9e6!important;
  font-size:13px!important;
  line-height:1.65!important;
}
.atlas-reflection-privacy{
  margin:16px 0 0!important;
  padding-top:15px;
  border-top:1px solid rgba(181,169,255,.16);
  color:#9faabd!important;
  font-size:11px!important;
  line-height:1.55!important;
}
.atlas-reflection-unavailable{
  margin-top:14px;
}


/* v0.35.9.6 — Mandatory profile photo */
.photo-status-pill.photo-required{
  color:#ffd1d8!important;
  background:rgba(244,63,94,.12)!important;
  border-color:rgba(251,113,133,.32)!important;
}
.photo-status-pill.photo-ready{
  color:#9df0d1!important;
  background:rgba(16,185,129,.10)!important;
  border-color:rgba(52,211,153,.28)!important;
}
.profile-actions.photo-required-save{
  border-color:rgba(251,113,133,.24)!important;
  background:linear-gradient(135deg,rgba(69,25,47,.94),rgba(19,24,52,.96))!important;
}
.profile-actions.photo-required-save small{color:#f8a8b7!important}
.profile-actions.photo-required-save b{color:#fff!important}
.profile-actions.photo-required-save .btn:disabled{
  opacity:.58;
  cursor:not-allowed;
  filter:saturate(.7);
}


/* AutoFace v0.36 — Feedback & Founding Member proposition */
.feedback-hero .lead{max-width:820px}.feedback-layout{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:20px;align-items:start}.feedback-card{position:relative;padding:30px;display:grid;gap:12px}.feedback-heading{display:flex;gap:13px;align-items:center;margin-bottom:7px}.feedback-heading>svg{width:44px;height:44px;padding:10px;border-radius:13px;background:rgba(124,92,255,.12);color:#b6a8ff}.feedback-heading h2{margin:3px 0 0;font-size:30px}.feedback-card label{margin-top:8px;font-size:11px;font-weight:800;color:#d9e0ec}.feedback-card select,.feedback-card textarea{width:100%;border:1px solid rgba(124,92,255,.22);border-radius:13px;background:#10162a;color:#eef2f8;padding:13px;font:inherit}.feedback-card textarea{min-height:150px;resize:vertical;line-height:1.55}.feedback-stars{display:flex;gap:6px}.feedback-stars button{border:0;background:transparent;color:#667085;padding:4px;cursor:pointer}.feedback-stars button.active{color:#f3b65f}.feedback-stars button.active svg{fill:currentColor}.feedback-count{justify-self:end;color:#718096}.feedback-contact{display:flex!important;gap:10px;align-items:flex-start;padding:13px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.018)}.feedback-contact input{margin-top:3px}.feedback-contact span{display:grid;gap:3px}.feedback-contact small{font-weight:400;color:#8795a9;line-height:1.45}.feedback-success{padding:11px 13px;border:1px solid rgba(88,210,174,.25);border-radius:12px;background:rgba(88,210,174,.07);color:#8ee1c3}.feedback-side{padding:27px;position:sticky;top:100px}.feedback-side h2{font-size:27px;margin:8px 0 10px}.feedback-side h3{font-size:17px;margin:18px 0 7px}.feedback-side p{font-size:11px;line-height:1.65;color:#91a0b4}.feedback-side-rule{height:1px;background:var(--line);margin:22px 0}.founding-callout{margin-top:20px;display:grid;grid-template-columns:1fr auto;gap:30px;align-items:center;padding:30px;border-color:rgba(255,105,157,.20);background:linear-gradient(120deg,rgba(124,92,255,.08),rgba(255,105,157,.035))}.founding-callout h2{font-size:30px;margin:7px 0 9px}.founding-callout p{max-width:760px;font-size:11px;line-height:1.65}.founding-number{display:grid;text-align:center;min-width:150px}.founding-number strong{font-size:54px;line-height:1;background:linear-gradient(90deg,#c08aff,#ff78ad);-webkit-background-clip:text;background-clip:text;color:transparent}.founding-number span{font-size:9px;color:#8997aa;margin-top:6px}.pricing-card.featured{transform:translateY(-5px)}
@media(max-width:820px){.feedback-layout{grid-template-columns:1fr}.feedback-side{position:static}.founding-callout{grid-template-columns:1fr}.founding-number{text-align:left;justify-items:start}.pricing-card.featured{transform:none}}
@media(max-width:620px){.feedback-card,.feedback-side{padding:21px 18px}.feedback-heading h2{font-size:25px}}


/* v0.36.1 — membership entitlements */
.premium-lock-card{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;padding:18px;border:1px solid rgba(255,180,72,.25);border-radius:16px;background:linear-gradient(135deg,rgba(92,58,18,.26),rgba(40,28,82,.46));margin-top:14px}
.premium-lock-card .premium-lock-icon{display:grid;place-items:center;width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,rgba(255,191,73,.22),rgba(163,104,255,.20));color:#ffd180;font-size:22px}
.premium-lock-card b{display:block;color:#fff;margin:4px 0}
.premium-lock-card p{margin:0!important;color:#aeb8c9!important;font-size:11px!important;line-height:1.55!important}
.preferences-premium-lock{margin:0 0 18px}
.premium-history-banner{display:flex;justify-content:space-between;align-items:center;gap:18px;padding:17px 19px;margin:14px 0 20px;border:1px solid rgba(255,180,72,.20);border-radius:15px;background:linear-gradient(120deg,rgba(94,58,20,.20),rgba(42,31,90,.34))}
.premium-history-banner b{display:block;color:#fff;margin:4px 0}.premium-history-banner p{margin:0;color:#98a6ba;font-size:11px}
.membership-admin-toolbar{margin-top:34px}.admin-member-list{display:grid;gap:10px;margin-bottom:30px}.admin-member-row{display:grid;grid-template-columns:minmax(0,1fr) auto auto;gap:16px;align-items:center;padding:14px 16px}.admin-member-identity{display:flex;align-items:center;gap:12px}.admin-member-identity>div:last-child{display:grid;gap:3px}.admin-member-identity span{font-size:11px;color:#8f9db1}.admin-member-actions{display:flex;gap:8px}.founding-plan-pill{color:#ffe0a3!important;border-color:rgba(255,193,77,.34)!important;background:rgba(255,177,45,.10)!important}.membership-status-card.is-founding{border-color:rgba(255,193,77,.26)!important;background:radial-gradient(480px 220px at 100% 0,rgba(255,177,45,.10),transparent 68%),linear-gradient(145deg,rgba(44,32,83,.95),rgba(16,25,49,.98))!important}.founding-member-number{display:inline-flex;gap:5px;align-items:center;margin-top:8px;padding:9px 12px;border-radius:12px;background:rgba(255,190,70,.09);border:1px solid rgba(255,190,70,.20);color:#dfc792;font-size:12px}.founding-member-number b{color:#ffe3a7}
@media(max-width:760px){.premium-lock-card{grid-template-columns:1fr}.premium-lock-card .premium-lock-icon{width:40px;height:40px}.premium-lock-card .btn{width:100%}.premium-history-banner{align-items:stretch;flex-direction:column}.premium-history-banner .btn{width:100%}.admin-member-row{grid-template-columns:1fr}.admin-member-plan,.admin-member-actions{justify-self:stretch}.admin-member-actions .btn{width:100%}}


/* v0.36.1.2 — Discover "While You Wait" game visual refresh */
.while-you-wait-card{
  position:relative;
  overflow:hidden;
  padding:30px!important;
  border:1px solid rgba(130,95,255,.34)!important;
  background:
    radial-gradient(520px 260px at 88% 4%,rgba(220,46,255,.15),transparent 70%),
    radial-gradient(430px 230px at 8% 0%,rgba(31,164,255,.14),transparent 72%),
    linear-gradient(130deg,rgba(25,48,103,.80),rgba(50,25,101,.84))!important;
  box-shadow:0 24px 70px rgba(7,8,30,.26);
}
.while-you-wait-card:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 8% 18%,rgba(255,207,63,.85) 0 2px,transparent 3px),
    radial-gradient(circle at 94% 22%,rgba(70,216,255,.85) 0 2px,transparent 3px),
    radial-gradient(circle at 83% 78%,rgba(255,96,177,.75) 0 2px,transparent 3px),
    radial-gradient(circle at 18% 82%,rgba(141,99,255,.80) 0 2px,transparent 3px);
  opacity:.8;
}
.while-you-wait-heading{
  position:relative;
  z-index:1;
  grid-template-columns:64px 1fr auto!important;
  gap:18px!important;
}
.while-you-wait-heading .privacy-kicker{
  color:#70d7ff!important;
  font-size:11px!important;
  letter-spacing:.14em!important;
}
.while-you-wait-heading h2{
  margin:4px 0 6px!important;
  font-size:29px!important;
  line-height:1.15!important;
  color:#fff!important;
}
.while-you-wait-heading h2 span{font-size:24px}
.while-you-wait-heading p{
  max-width:820px!important;
  font-size:12px!important;
  line-height:1.6!important;
  color:#aebbd0!important;
}
.while-you-wait-heading p b{
  color:#ffd85d!important;
  font-weight:900!important;
}
.while-you-wait-icon{
  width:60px!important;
  height:60px!important;
  border-radius:18px!important;
  border:1px solid rgba(67,190,255,.34)!important;
  background:linear-gradient(145deg,rgba(31,140,255,.20),rgba(106,67,255,.20))!important;
  color:#73caff!important;
  box-shadow:0 10px 30px rgba(40,110,255,.16),inset 0 0 24px rgba(92,174,255,.08);
}
.while-you-wait-progress{
  display:inline-flex!important;
  align-items:center!important;
  gap:6px!important;
  min-width:74px!important;
  padding:10px 14px!important;
  border:1px solid rgba(202,86,255,.34)!important;
  border-radius:999px!important;
  font-size:12px!important;
  font-weight:900!important;
  color:#fff!important;
  background:linear-gradient(135deg,rgba(105,54,225,.86),rgba(173,46,223,.78))!important;
  box-shadow:0 8px 24px rgba(112,44,220,.18);
}
.while-you-wait-progress span{color:#ffd84d;font-size:13px}
.this-or-that-game{
  position:relative;
  z-index:1;
  max-width:980px!important;
  margin:24px auto 0!important;
  padding:26px!important;
  border:1px solid rgba(145,93,255,.24)!important;
  border-radius:20px!important;
  background:linear-gradient(145deg,rgba(15,22,57,.82),rgba(36,18,75,.78))!important;
  box-shadow:inset 0 0 38px rgba(101,55,195,.08);
}
.this-or-that-prompt small{
  display:inline-flex!important;
  padding:7px 12px!important;
  border-radius:999px!important;
  background:linear-gradient(135deg,#724eff,#bc42dc)!important;
  color:#fff!important;
  font-size:9px!important;
  letter-spacing:.12em!important;
  font-weight:900!important;
}
.this-or-that-prompt b{
  margin-top:10px!important;
  font-size:23px!important;
  line-height:1.2!important;
  color:#fff!important;
}
.this-or-that-prompt b em{
  color:#ffd84d;
  font-style:normal;
}
.this-or-that-options{
  grid-template-columns:1fr 58px 1fr!important;
  gap:14px!important;
  margin:22px 0!important;
}
.this-or-that-options .this-or-that-option{
  min-height:132px!important;
  align-content:center!important;
  gap:10px!important;
  padding:20px!important;
  border-radius:19px!important;
  color:#fff!important;
  overflow:hidden;
  position:relative;
}
.this-or-that-options .option-a{
  border:1px solid rgba(255,106,144,.48)!important;
  background:
    radial-gradient(240px 120px at 15% 10%,rgba(255,196,61,.16),transparent 72%),
    linear-gradient(135deg,rgba(213,76,104,.25),rgba(137,53,134,.22),rgba(22,31,64,.94))!important;
  box-shadow:inset 0 0 35px rgba(244,80,137,.07);
}
.this-or-that-options .option-b{
  border:1px solid rgba(60,181,255,.48)!important;
  background:
    radial-gradient(240px 120px at 85% 10%,rgba(71,215,255,.16),transparent 72%),
    linear-gradient(135deg,rgba(23,141,218,.25),rgba(63,92,222,.20),rgba(22,31,64,.94))!important;
  box-shadow:inset 0 0 35px rgba(67,164,255,.07);
}
.this-or-that-options .option-a:hover{
  transform:translateY(-4px) scale(1.01)!important;
  border-color:rgba(255,118,162,.82)!important;
  box-shadow:0 16px 34px rgba(223,54,114,.18),inset 0 0 32px rgba(255,90,149,.10)!important;
}
.this-or-that-options .option-b:hover{
  transform:translateY(-4px) scale(1.01)!important;
  border-color:rgba(77,195,255,.82)!important;
  box-shadow:0 16px 34px rgba(42,135,255,.18),inset 0 0 32px rgba(67,164,255,.10)!important;
}
.this-or-that-options .choice-badge{
  width:42px!important;
  height:42px!important;
  border-radius:50%!important;
  font-size:14px!important;
  font-weight:950!important;
  color:#fff!important;
  box-shadow:0 6px 18px rgba(0,0,0,.18);
}
.this-or-that-options .option-a .choice-badge{
  background:linear-gradient(135deg,#ff7c54,#f22e88)!important;
  border:1px solid rgba(255,255,255,.34);
}
.this-or-that-options .option-b .choice-badge{
  background:linear-gradient(135deg,#00bddd,#3568ff)!important;
  border:1px solid rgba(255,255,255,.34);
}
.this-or-that-options .this-or-that-option b{
  font-size:17px!important;
  line-height:1.25!important;
  color:#fff!important;
}
.this-or-that-options .this-or-that-option small{
  font-size:9px!important;
  color:#9eacc0!important;
  font-weight:700;
}
.this-or-that-or{
  display:grid!important;
  place-items:center!important;
  width:52px!important;
  height:52px!important;
  justify-self:center!important;
  border-radius:50%!important;
  border:1px solid rgba(176,96,255,.44)!important;
  background:linear-gradient(135deg,rgba(112,61,220,.92),rgba(89,42,161,.88))!important;
  color:#fff!important;
  font-size:10px!important;
  font-weight:950!important;
  box-shadow:0 8px 22px rgba(75,35,150,.22);
}
.this-or-that-note{
  gap:9px!important;
  font-size:10px!important;
  line-height:1.55!important;
  color:#91a1b7!important;
}
.this-or-that-note svg{
  color:#b07cff!important;
}
.this-or-that-note b{
  color:#ffd84d!important;
}
.this-or-that-complete{
  padding:30px!important;
  border-color:rgba(80,213,176,.24)!important;
  background:linear-gradient(145deg,rgba(25,92,82,.18),rgba(31,27,79,.50))!important;
}
.this-or-that-confetti{font-size:34px!important;color:#ffd84d!important}
.this-or-that-complete h3{font-size:22px!important}
.this-or-that-complete p{font-size:11px!important}
.this-or-that-summary span{font-size:9px!important;padding:8px 11px!important}

@media(max-width:680px){
  .while-you-wait-card{padding:22px!important}
  .while-you-wait-heading{grid-template-columns:54px 1fr!important}
  .while-you-wait-icon{width:52px!important;height:52px!important}
  .while-you-wait-heading h2{font-size:23px!important}
  .while-you-wait-heading p{font-size:11px!important}
  .while-you-wait-progress{grid-column:2!important;justify-self:start!important}
  .this-or-that-game{padding:18px!important}
  .this-or-that-prompt b{font-size:20px!important}
  .this-or-that-options{grid-template-columns:1fr!important;gap:12px!important}
  .this-or-that-or{width:44px!important;height:44px!important;margin:0 auto!important}
  .this-or-that-options .this-or-that-option{min-height:112px!important}
  .this-or-that-options .this-or-that-option b{font-size:16px!important}
  .this-or-that-note{font-size:9px!important;text-align:center!important}
}

/* v0.36.1.3 — Discover mutual messaging explainer */
.discovery-mutual-explainer{
  padding:28px!important;
  border-color:rgba(65,205,218,.28)!important;
  background:
    radial-gradient(420px 190px at 0% 0%,rgba(20,170,190,.11),transparent 72%),
    linear-gradient(145deg,rgba(18,44,76,.92),rgba(26,29,66,.96))!important;
}
.discovery-mutual-explainer .privacy-kicker{
  color:#79dff0!important;
}
.discovery-mutual-explainer h3{
  margin:7px 0 10px!important;
  font-size:24px!important;
  line-height:1.2!important;
  color:#fff!important;
}
.discovery-mutual-explainer>p{
  max-width:800px;
  font-size:14px!important;
  line-height:1.65!important;
  color:#aeb9cb!important;
}
.discovery-mutual-explainer>p b{
  color:#fff;
}
.mutual-message-flow{
  display:grid;
  grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;
  gap:10px;
  align-items:center;
  margin:22px 0 18px;
}
.mutual-flow-step{
  display:flex;
  align-items:center;
  gap:10px;
  min-height:64px;
  padding:12px 14px;
  border:1px solid rgba(126,145,188,.20);
  border-radius:14px;
  background:rgba(13,24,51,.58);
}
.mutual-flow-step>span{
  display:grid;
  place-items:center;
  flex:0 0 auto;
  width:31px;
  height:31px;
  border-radius:50%;
  background:rgba(122,92,255,.16);
  border:1px solid rgba(137,111,255,.26);
  color:#c9bfff;
  font-size:11px;
  font-weight:900;
}
.mutual-flow-step>b{
  color:#fff;
  font-size:11px;
  line-height:1.3;
}
.mutual-flow-success{
  border-color:rgba(66,213,165,.25);
  background:rgba(24,103,84,.17);
}
.mutual-flow-success>span{
  color:#8ce6c5;
  border-color:rgba(66,213,165,.30);
  background:rgba(37,184,133,.14);
}
.mutual-flow-chat{
  border-color:rgba(69,171,255,.27);
  background:rgba(38,96,170,.17);
}
.mutual-flow-chat>span{
  color:#a9d7ff;
  border-color:rgba(69,171,255,.30);
  background:rgba(61,138,228,.14);
}
.mutual-flow-arrow{
  color:#6f819e;
  font-size:17px;
  font-weight:900;
}
.mutual-message-reassurance{
  margin:0 0 18px!important;
  padding-top:15px;
  border-top:1px solid rgba(120,141,180,.14);
  font-size:11px!important;
  color:#8e9cb1!important;
}
.discovery-mutual-explainer .btn{
  min-width:190px;
}
@media(max-width:850px){
  .mutual-message-flow{
    grid-template-columns:1fr;
    gap:8px;
  }
  .mutual-flow-arrow{
    transform:rotate(90deg);
    justify-self:center;
    line-height:1;
  }
}
@media(max-width:600px){
  .discovery-mutual-explainer{
    padding:22px!important;
  }
  .discovery-mutual-explainer h3{
    font-size:21px!important;
  }
  .discovery-mutual-explainer>p{
    font-size:13px!important;
  }
  .discovery-mutual-explainer .btn{
    width:100%;
  }
}



/* v0.36.1.4 - Entitlement test harness */
.dev-entitlement-card{
  border-color:rgba(255,185,70,.24)!important;
  background:
    radial-gradient(500px 230px at 100% 0%,rgba(255,173,48,.09),transparent 70%),
    linear-gradient(145deg,rgba(49,31,82,.88),rgba(17,30,56,.95))!important;
}
.dev-entitlement-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:18px;
}
.dev-entitlement-head h2{margin:5px 0 0}
.dev-entitlement-stats{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:10px;
  margin:18px 0;
}
.dev-entitlement-stats span{
  display:grid;
  gap:4px;
  padding:14px;
  border:1px solid rgba(146,157,190,.16);
  border-radius:14px;
  background:rgba(7,17,38,.35);
}
.dev-entitlement-stats b{font-size:20px;color:#fff}
.dev-entitlement-stats small{font-size:9px;color:#8f9db2;text-transform:uppercase;letter-spacing:.07em}
.dev-entitlement-flow{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:9px;
  margin:16px 0;
}
.dev-entitlement-flow span{
  display:flex;
  align-items:center;
  gap:8px;
  min-height:54px;
  padding:10px;
  border-radius:12px;
  border:1px solid rgba(126,145,188,.15);
  color:#aeb9ca;
  font-size:9px;
}
.dev-entitlement-flow b{
  display:grid;
  place-items:center;
  flex:0 0 auto;
  width:25px;height:25px;
  border-radius:50%;
  background:rgba(124,92,255,.14);
  color:#c8beff;
}
.dev-entitlement-actions{display:flex;gap:8px;flex-wrap:wrap;margin:17px 0}
.dev-entitlement-actions .entitlement-active-button{
  outline:2px solid rgba(255,210,117,.25);
  box-shadow:0 0 0 4px rgba(255,190,70,.04);
}
.dev-entitlement-test-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:18px 0;
}
.dev-entitlement-test-grid>div{
  padding:15px;
  border:1px solid rgba(129,145,180,.15);
  border-radius:13px;
  background:rgba(8,17,38,.35);
}
.dev-entitlement-test-grid b,.dev-entitlement-test-grid small{display:block}
.dev-entitlement-test-grid b{margin:6px 0;color:#fff;font-size:12px}
.dev-entitlement-test-grid small{color:#91a0b5;font-size:9px;line-height:1.55}
.dev-entitlement-tip{
  display:grid;
  gap:4px;
  padding:14px 15px;
  border-radius:13px;
  border:1px solid rgba(71,189,255,.18);
  background:rgba(30,104,166,.08);
}
.dev-entitlement-tip b{color:#a8d9ff;font-size:11px}
.dev-entitlement-tip span{color:#94a4b9;font-size:9px;line-height:1.55}
.dev-entitlement-tip strong{color:#d9e9f8}
.dev-entitlement-links{display:flex;gap:7px;flex-wrap:wrap;margin-top:15px}
.dev-entitlement-links .btn{font-size:9px}
@media(max-width:760px){
  .dev-entitlement-head{display:grid}
  .dev-entitlement-stats{grid-template-columns:1fr}
  .dev-entitlement-flow{grid-template-columns:1fr 1fr}
  .dev-entitlement-test-grid{grid-template-columns:1fr}
  .dev-entitlement-actions{display:grid}
  .dev-entitlement-actions .btn,.dev-entitlement-links .btn{width:100%}
}
@media(max-width:480px){.dev-entitlement-flow{grid-template-columns:1fr}}



/* v0.36.1.4.1 - Self-contained entitlement seeding */
.dev-entitlement-seed-state{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  margin:18px 0 10px;
  padding:16px;
  border:1px solid rgba(73,174,255,.20);
  border-radius:14px;
  background:linear-gradient(135deg,rgba(23,104,169,.10),rgba(78,51,145,.12));
}
.dev-entitlement-seed-state>div{
  display:grid;
  gap:4px;
}
.dev-entitlement-seed-state b{
  color:#fff;
  font-size:13px;
}
.dev-entitlement-seed-state small{
  color:#91a2b8;
  font-size:9px;
}
.dev-entitlement-seed-state .btn{
  min-width:170px;
}
.entitlement-seeded-button{
  color:#91ead0!important;
  border-color:rgba(56,207,163,.28)!important;
  background:rgba(33,148,116,.10)!important;
}
.dev-entitlement-actions .btn:disabled{
  opacity:.46;
  cursor:not-allowed;
}
@media(max-width:680px){
  .dev-entitlement-seed-state{
    align-items:stretch;
    flex-direction:column;
  }
  .dev-entitlement-seed-state .btn{
    width:100%;
  }
}



/* v0.36.1.4.2 - Atlas Reflection locked-state layout fix */
.atlas-reflection-card .premium-lock-card{
  display:grid!important;
  grid-template-columns:52px minmax(0,1fr)!important;
  grid-template-areas:
    "icon content"
    "cta cta"!important;
  gap:14px 16px!important;
  align-items:start!important;
  padding:18px!important;
  margin-top:14px!important;
  border:1px solid rgba(255,177,74,.28)!important;
  border-radius:16px!important;
  background:
    radial-gradient(260px 130px at 100% 0%,rgba(255,126,88,.10),transparent 72%),
    linear-gradient(145deg,rgba(57,33,83,.64),rgba(30,27,71,.82))!important;
  overflow:hidden!important;
}
.atlas-reflection-card .premium-lock-card .premium-lock-icon{
  grid-area:icon!important;
  width:46px!important;
  height:46px!important;
  border-radius:14px!important;
  display:grid!important;
  place-items:center!important;
  font-size:22px!important;
  color:#ffd58f!important;
  background:linear-gradient(135deg,rgba(255,174,75,.18),rgba(192,93,255,.15))!important;
  border:1px solid rgba(255,193,102,.20)!important;
}
.atlas-reflection-card .premium-lock-card>div:nth-child(2){
  grid-area:content!important;
  min-width:0!important;
}
.atlas-reflection-card .premium-lock-card .privacy-kicker{
  display:block!important;
  margin-bottom:6px!important;
  color:#80d7ff!important;
  font-size:9px!important;
  line-height:1.25!important;
  letter-spacing:.14em!important;
  white-space:normal!important;
}
.atlas-reflection-card .premium-lock-card b{
  display:block!important;
  margin:0 0 7px!important;
  color:#fff!important;
  font-size:17px!important;
  line-height:1.15!important;
}
.atlas-reflection-card .premium-lock-card p{
  margin:0!important;
  color:#aeb7c8!important;
  font-size:11px!important;
  line-height:1.55!important;
}
.atlas-reflection-card .premium-lock-card .btn{
  grid-area:cta!important;
  justify-self:stretch!important;
  width:100%!important;
  min-width:0!important;
  margin:2px 0 0!important;
  text-align:center!important;
  white-space:normal!important;
  line-height:1.2!important;
  padding:12px 14px!important;
}
@media(min-width:720px){
  .atlas-reflection-card .premium-lock-card{
    grid-template-columns:52px minmax(0,1fr) auto!important;
    grid-template-areas:"icon content cta"!important;
    align-items:center!important;
  }
  .atlas-reflection-card .premium-lock-card .btn{
    justify-self:end!important;
    width:auto!important;
    min-width:170px!important;
  }
}
@media(max-width:420px){
  .atlas-reflection-card .premium-lock-card{
    grid-template-columns:1fr!important;
    grid-template-areas:
      "icon"
      "content"
      "cta"!important;
  }
  .atlas-reflection-card .premium-lock-card .premium-lock-icon{
    width:42px!important;
    height:42px!important;
  }
  .atlas-reflection-card .premium-lock-card b{
    font-size:16px!important;
  }
}



/* v0.36.1.4.3 - Atlas Reflection lock card forced stack fix */
.atlas-reflection-card .premium-lock-card,
.atlas-reflection-card div.premium-lock-card{
  display:flex!important;
  flex-direction:column!important;
  align-items:stretch!important;
  justify-content:flex-start!important;
  gap:12px!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  box-sizing:border-box!important;
  padding:18px!important;
  overflow:hidden!important;
}

.atlas-reflection-card .premium-lock-card .premium-lock-icon{
  flex:0 0 auto!important;
  width:44px!important;
  height:44px!important;
  align-self:flex-start!important;
  margin:0!important;
}

.atlas-reflection-card .premium-lock-card > div:nth-child(2){
  display:block!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  margin:0!important;
}

.atlas-reflection-card .premium-lock-card .privacy-kicker{
  display:block!important;
  width:auto!important;
  max-width:none!important;
  margin:0 0 7px!important;
  white-space:nowrap!important;
  overflow:visible!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
  font-size:9px!important;
  line-height:1.25!important;
}

.atlas-reflection-card .premium-lock-card b{
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  margin:0 0 8px!important;
  font-size:17px!important;
  line-height:1.2!important;
  white-space:normal!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
}

.atlas-reflection-card .premium-lock-card p{
  display:block!important;
  width:100%!important;
  max-width:100%!important;
  margin:0!important;
  font-size:11px!important;
  line-height:1.6!important;
  white-space:normal!important;
  word-break:normal!important;
  overflow-wrap:normal!important;
}

.atlas-reflection-card .premium-lock-card .btn,
.atlas-reflection-card .premium-lock-card a.btn{
  display:flex!important;
  align-items:center!important;
  justify-content:center!important;
  position:static!important;
  float:none!important;
  width:100%!important;
  min-width:0!important;
  max-width:100%!important;
  box-sizing:border-box!important;
  margin:4px 0 0!important;
  padding:12px 14px!important;
  transform:none!important;
  white-space:normal!important;
  text-align:center!important;
  line-height:1.2!important;
}

/* Deliberately keep this card stacked at every viewport size.
   It reads better inside the narrow Atlas Reflection column. */
@media(min-width:720px){
  .atlas-reflection-card .premium-lock-card,
  .atlas-reflection-card div.premium-lock-card{
    display:flex!important;
    flex-direction:column!important;
  }
  .atlas-reflection-card .premium-lock-card .btn,
  .atlas-reflection-card .premium-lock-card a.btn{
    width:100%!important;
    min-width:0!important;
    justify-self:auto!important;
    align-self:stretch!important;
  }
}

@media(max-width:420px){
  .atlas-reflection-card .premium-lock-card .privacy-kicker{
    white-space:normal!important;
  }
}



/* v0.36.1.5 - Face verification success readability */
.face-verification-card .face-result.success.face-result-celebration{
  display:grid!important;
  grid-template-columns:64px minmax(0,1fr)!important;
  gap:18px!important;
  align-items:start!important;
  margin-top:22px!important;
  padding:24px!important;
  border:2px solid rgba(66,215,112,.56)!important;
  border-radius:18px!important;
  background:
    radial-gradient(300px 160px at 0% 0%,rgba(91,231,134,.18),transparent 72%),
    linear-gradient(145deg,rgba(226,255,233,.98),rgba(239,255,244,.94))!important;
  box-shadow:
    0 16px 40px rgba(21,177,77,.18),
    0 0 0 1px rgba(102,255,150,.10),
    inset 0 0 34px rgba(82,216,122,.08)!important;
  color:#112218!important;
}
.face-result-celebration .face-result-icon{
  display:grid!important;
  place-items:center!important;
  width:60px!important;
  height:60px!important;
  border-radius:50%!important;
  margin:0!important;
  background:linear-gradient(145deg,#27c85f,#11983f)!important;
  border:4px solid rgba(255,255,255,.72)!important;
  box-shadow:0 8px 22px rgba(14,139,54,.24)!important;
  color:#fff!important;
  font-size:30px!important;
  font-weight:950!important;
}
.face-result-success-content{
  min-width:0!important;
}
.face-result-success-content h3{
  margin:0 0 7px!important;
  color:#10391d!important;
  font-size:24px!important;
  line-height:1.15!important;
  font-weight:900!important;
}
.face-result-success-content>p{
  margin:0!important;
  color:#294f35!important;
  font-size:16px!important;
  line-height:1.5!important;
  font-weight:700!important;
}
.face-success-metrics{
  grid-column:1 / -1!important;
  display:grid!important;
  grid-template-columns:1fr 1fr!important;
  gap:12px!important;
  width:100%!important;
  margin-top:4px!important;
  padding-top:18px!important;
  border-top:1px solid rgba(34,139,71,.16)!important;
}
.face-success-metric{
  display:grid!important;
  grid-template-columns:40px minmax(0,1fr) auto!important;
  gap:11px!important;
  align-items:center!important;
  min-width:0!important;
  padding:14px!important;
  border:1px solid rgba(38,157,75,.16)!important;
  border-radius:14px!important;
  background:rgba(255,255,255,.62)!important;
}
.face-success-metric-icon{
  display:grid!important;
  place-items:center!important;
  width:38px!important;
  height:38px!important;
  border-radius:11px!important;
  background:rgba(28,171,74,.10)!important;
  color:#188d40!important;
  font-size:20px!important;
  font-weight:900!important;
}
.face-success-metric-copy{
  min-width:0!important;
}
.face-success-metric-copy small{
  display:block!important;
  margin:0 0 3px!important;
  color:#376244!important;
  font-size:11px!important;
  line-height:1.3!important;
  font-weight:800!important;
}
.face-success-metric-copy span{
  display:block!important;
  color:#5b7463!important;
  font-size:10px!important;
  line-height:1.4!important;
}
.face-success-metric strong{
  color:#128337!important;
  font-size:23px!important;
  line-height:1!important;
  font-weight:950!important;
  white-space:nowrap!important;
}
.face-result-actions{
  margin-top:18px!important;
}
.face-result-actions .btn-primary{
  min-height:48px!important;
  padding:13px 18px!important;
  font-size:14px!important;
  font-weight:850!important;
}
@media(max-width:720px){
  .face-verification-card .face-result.success.face-result-celebration{
    grid-template-columns:52px minmax(0,1fr)!important;
    padding:19px!important;
  }
  .face-result-celebration .face-result-icon{
    width:50px!important;
    height:50px!important;
    font-size:25px!important;
  }
  .face-result-success-content h3{
    font-size:21px!important;
  }
  .face-result-success-content>p{
    font-size:14px!important;
  }
  .face-success-metrics{
    grid-template-columns:1fr!important;
  }
}
@media(max-width:440px){
  .face-verification-card .face-result.success.face-result-celebration{
    grid-template-columns:1fr!important;
  }
  .face-result-success-content h3{
    font-size:20px!important;
  }
  .face-success-metrics{
    grid-column:1!important;
  }
  .face-success-metric{
    grid-template-columns:38px minmax(0,1fr)!important;
  }
  .face-success-metric strong{
    grid-column:2!important;
    font-size:21px!important;
  }
}



/* v0.36.1.6 - Paid chat entitlement experience */
.chat-entitlement-banner{
  display:grid;
  grid-template-columns:48px minmax(0,1fr) auto;
  gap:14px;
  align-items:center;
  margin:16px 0 10px;
  padding:16px;
  border:1px solid rgba(129,111,255,.24);
  border-radius:15px;
  background:linear-gradient(135deg,rgba(86,55,171,.14),rgba(35,81,145,.12));
}
.chat-entitlement-icon{
  display:grid;
  place-items:center;
  width:44px;height:44px;
  border-radius:13px;
  background:rgba(125,91,255,.15);
  font-size:20px;
}
.chat-entitlement-banner h3{margin:4px 0 5px;color:#fff;font-size:15px}
.chat-entitlement-banner p{margin:0;color:#9eacc0;font-size:10px;line-height:1.5}
.chat-entitlement-banner .btn{white-space:nowrap}
.chat-entitlement-locked{
  border-color:rgba(255,166,67,.30);
  background:linear-gradient(135deg,rgba(143,73,35,.14),rgba(80,43,104,.15));
}
.chat-entitlement-locked .chat-entitlement-icon{background:rgba(255,157,60,.13)}
.chat-entitlement-unlimited{
  grid-template-columns:48px minmax(0,1fr);
  border-color:rgba(54,210,154,.24);
  background:linear-gradient(135deg,rgba(28,125,96,.13),rgba(30,72,115,.10));
}
.chat-entitlement-unlimited .chat-entitlement-icon{color:#8be6c4;background:rgba(41,190,137,.12);font-weight:900}
.message-composer-locked textarea{
  opacity:.62;
  cursor:not-allowed;
}
@media(max-width:760px){
  .chat-entitlement-banner{grid-template-columns:44px minmax(0,1fr)}
  .chat-entitlement-banner .btn{grid-column:1/-1;width:100%}
}



/* v0.36.1.6.1 - Two-user Free chat test harness */
.dev-chat-entitlement-card{
  border-color:rgba(74,194,255,.23)!important;
  background:
    radial-gradient(480px 220px at 100% 0%,rgba(55,167,255,.10),transparent 72%),
    linear-gradient(145deg,rgba(26,42,80,.92),rgba(34,25,75,.95))!important;
}
.dev-chat-entitlement-head{display:flex;justify-content:space-between;gap:18px;align-items:flex-start}
.dev-chat-entitlement-head h2{margin:5px 0 0}
.dev-chat-test-users{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:18px 0}
.dev-chat-test-user{display:flex;gap:13px;align-items:center;padding:15px;border:1px solid rgba(131,148,190,.16);border-radius:14px;background:rgba(6,16,37,.34)}
.dev-chat-test-avatar-image{width:56px;height:56px;flex:0 0 auto;border-radius:50%;object-fit:cover;border:2px solid rgba(164,149,255,.28)}
.dev-chat-test-user-copy{display:grid;gap:5px;min-width:0}
.dev-chat-test-user-copy>div{display:flex;align-items:center;gap:8px}
.dev-chat-test-user-copy b{color:#fff;font-size:13px}
.dev-chat-test-user-copy small{color:#9aa9be;font-size:9px}
.dev-chat-test-user-copy code{width:max-content;max-width:100%;padding:5px 7px;border-radius:7px;color:#d7cfff;background:rgba(120,92,226,.10);font-size:9px;overflow-wrap:anywhere}
.dev-chat-test-user-copy em{font-style:normal;color:#79d9c1;font-size:9px}
.dev-chat-test-actions{display:flex;gap:8px;flex-wrap:wrap}
.dev-chat-login-guide{display:grid;gap:7px;margin-top:16px;padding:15px;border:1px solid rgba(62,210,165,.19);border-radius:13px;background:rgba(29,123,99,.08)}
.dev-chat-login-guide b{color:#a0ecd4;font-size:11px}
.dev-chat-login-guide span{color:#9eacbf;font-size:9px}
.dev-chat-test-note{display:flex;gap:7px;margin-top:13px;color:#8392a8;font-size:9px;line-height:1.5}
.dev-chat-test-note b{color:#aebbd0}
@media(max-width:720px){
  .dev-chat-test-users{grid-template-columns:1fr}
  .dev-chat-test-actions{display:grid}
  .dev-chat-test-actions .btn{width:100%}
}



/* v0.36.1.6.3 - Introduction chat-paused state */
.intro-journey-card.intro-chat-paused{
  border-color:rgba(255,169,64,.38)!important;
  box-shadow:0 15px 34px rgba(148,76,26,.10);
}
.intro-card-status.intro-card-status-paused{
  border-color:rgba(255,169,64,.23)!important;
  background:linear-gradient(135deg,rgba(139,72,31,.16),rgba(75,43,95,.14))!important;
}
.intro-card-status.intro-card-status-paused svg{
  color:#ffb25b!important;
}
.intro-card-status.intro-card-status-paused small{
  color:#ffbc70!important;
}
.intro-card-status.intro-card-status-paused b{
  color:#fff0dc!important;
}
.intro-chat-entitlement{
  display:flex;
  align-items:center;
  gap:7px;
  margin:10px 0 2px;
  padding:9px 11px;
  border:1px solid rgba(91,181,255,.15);
  border-radius:10px;
  background:rgba(28,85,145,.08);
  color:#91bee5;
  font-size:9px;
  line-height:1.4;
}
.intro-chat-entitlement.locked{
  border-color:rgba(255,169,64,.20);
  background:rgba(145,76,28,.09);
  color:#d8b184;
}
.intro-view-conversation{
  background:linear-gradient(135deg,#ef6c62,#ff9865)!important;
  box-shadow:0 10px 24px rgba(236,103,80,.16);
}



/* v0.36.1.6.4 - Blocked members and unblock clarity */
.blocked-profiles-card{
  border-color:rgba(239,103,96,.22)!important;
  background:
    radial-gradient(420px 180px at 100% 0%,rgba(235,95,90,.08),transparent 70%),
    rgba(13,23,48,.78)!important;
}
.blocked-profile-row{
  transition:border-color .18s ease,transform .18s ease;
}
.blocked-profile-row:hover{
  border-color:rgba(238,124,117,.28)!important;
  transform:translateY(-1px);
}
.blocked-profile-avatar{
  background:linear-gradient(135deg,rgba(224,85,100,.24),rgba(121,78,193,.24))!important;
  border:1px solid rgba(238,124,117,.24);
}
.unblock-button{
  border-color:rgba(104,204,175,.30)!important;
  color:#9ce8d2!important;
}
.blocked-privacy-note{
  border-color:rgba(102,183,255,.16)!important;
  background:rgba(41,91,145,.08)!important;
}



/* v0.36.1.7.2 - Pricing alignment with automatic Founder programme */
#founding-programme{
  scroll-margin-top:96px;
}
.pricing-card.featured .pricing-price strong{
  color:#ffd16f;
}
.pricing-card.featured .pricing-description{
  min-height:62px;
}
.pricing-beta-banner b{
  color:#fff;
}
.pricing-beta-banner small{
  display:block;
  margin-top:4px;
}



/* v0.36.1.7.3 - Founding Programme pricing styling repair */
.founder-programme-pricing{
  max-width:1180px;
  margin:34px auto;
  padding:28px;
  border:1px solid rgba(173,118,255,.28);
  border-radius:22px;
  background:
    radial-gradient(560px 260px at 100% 0%,rgba(209,84,255,.12),transparent 72%),
    radial-gradient(460px 220px at 0% 0%,rgba(51,169,255,.10),transparent 72%),
    linear-gradient(145deg,rgba(26,27,69,.96),rgba(25,39,75,.94));
  box-shadow:0 24px 60px rgba(5,8,27,.20);
  overflow:hidden;
}
.founder-programme-header{
  display:flex;
  justify-content:space-between;
  gap:28px;
  align-items:flex-start;
}
.founder-programme-header>div:first-child{max-width:760px}
.founder-programme-header h2{
  margin:7px 0 9px;
  color:#fff;
  font-size:clamp(25px,3vw,36px);
  line-height:1.12;
}
.founder-programme-header p{
  margin:0;
  color:#a6b1c4;
  font-size:12px;
  line-height:1.65;
}
.founder-availability{
  display:grid;
  min-width:175px;
  padding:17px 18px;
  border:1px solid rgba(255,193,82,.30);
  border-radius:16px;
  text-align:center;
  background:linear-gradient(135deg,rgba(202,120,37,.16),rgba(118,66,182,.15));
}
.founder-availability strong{
  color:#ffd16a;
  font-size:34px;
  line-height:1;
}
.founder-availability span{
  margin-top:6px;
  color:#e6d7bd;
  font-size:9px;
  line-height:1.35;
}
.founder-availability.full{
  border-color:rgba(160,170,190,.18);
}
.founder-availability.full strong{color:#aab3c2}

.founder-counter{
  margin:22px 0 26px;
}
.founder-counter>div:first-child{
  display:flex;
  justify-content:space-between;
  color:#bac4d3;
  font-size:9px;
}
.founder-counter>div:first-child b{color:#ffd16a}
.founder-counter-track{
  height:9px;
  margin:8px 0 7px;
  overflow:hidden;
  border-radius:999px;
  background:rgba(255,255,255,.07);
}
.founder-counter-track i{
  display:block;
  height:100%;
  border-radius:999px;
  background:linear-gradient(90deg,#7457ff,#d651db,#ffad55);
}
.founder-counter small{
  color:#77869c;
  font-size:8px;
}

.founder-tier-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:13px;
}
.founder-tier-grid article{
  min-width:0;
  padding:20px;
  border:1px solid rgba(132,146,182,.16);
  border-radius:17px;
  background:rgba(8,17,39,.43);
}
.founder-tier-grid article.founder-tier-featured{
  border-color:rgba(255,188,72,.34);
  background:
    radial-gradient(260px 140px at 100% 0%,rgba(255,176,61,.10),transparent 72%),
    rgba(52,29,76,.52);
  box-shadow:0 12px 34px rgba(151,74,39,.10);
}
.founder-tier-badge{
  display:inline-flex;
  padding:6px 9px;
  border-radius:999px;
  color:#a8dfff;
  background:rgba(47,142,210,.10);
  font-size:8px;
  font-weight:900;
  letter-spacing:.09em;
}
.founder-tier-featured .founder-tier-badge{
  color:#ffd67d;
  background:rgba(217,139,44,.12);
}
.founder-tier-grid h3{
  margin:12px 0 5px;
  color:#fff;
  font-size:18px;
}
.founder-tier-grid article>strong{
  display:block;
  color:#d8deea;
  font-size:13px;
}
.founder-tier-featured>strong{color:#ffd67d!important}
.founder-tier-grid p{
  min-height:55px;
  color:#8f9db1;
  font-size:9px;
  line-height:1.55;
}
.founder-tier-grid ul{
  display:grid;
  gap:7px;
  padding:0;
  margin:15px 0 0;
  list-style:none;
}
.founder-tier-grid li{
  color:#aeb9c9;
  font-size:9px;
}
.founder-tier-grid li:before{
  content:"✓";
  margin-right:7px;
  color:#6ed9b7;
  font-weight:900;
}

.founder-eligibility-box{
  display:grid;
  grid-template-columns:minmax(0,1.15fr) minmax(0,1fr) auto;
  gap:18px;
  align-items:center;
  margin-top:18px;
  padding:18px;
  border:1px solid rgba(75,191,255,.18);
  border-radius:16px;
  background:rgba(25,86,145,.07);
}
.founder-eligibility-box h3{
  margin:5px 0;
  color:#fff;
  font-size:15px;
}
.founder-eligibility-box p{
  margin:0;
  color:#93a2b7;
  font-size:9px;
  line-height:1.5;
}
.founder-requirements{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:7px;
}
.founder-requirements span{
  display:flex;
  align-items:center;
  gap:6px;
  color:#96a5b9;
  font-size:8px;
}
.founder-requirements i{
  display:grid;
  place-items:center;
  width:18px;
  height:18px;
  border-radius:50%;
  background:rgba(129,107,220,.12);
  color:#b9adff;
  font-style:normal;
  font-size:8px;
}
.founder-requirements span.complete{color:#9de4cb}
.founder-requirements span.complete i{
  background:rgba(50,190,139,.12);
  color:#76ddb9;
}
.founder-requirements span.incomplete{color:#a9a0a7}

@media(max-width:900px){
  .founder-programme-header{display:grid}
  .founder-availability{
    min-width:0;
    width:100%;
  }
  .founder-tier-grid{
    grid-template-columns:1fr;
  }
  .founder-tier-grid p{min-height:0}
  .founder-eligibility-box{
    grid-template-columns:1fr;
  }
  .founder-eligibility-box .btn{
    width:100%;
  }
}
@media(max-width:520px){
  .founder-programme-pricing{
    padding:20px;
  }
  .founder-requirements{
    grid-template-columns:1fr;
  }
}



/* v0.36.1.8 - Membership Centre */
.membership-centre-page{min-height:100vh}
.membership-centre-hero{
  padding:62px 0 28px;
  border-bottom:1px solid rgba(122,145,190,.10);
  background:
    radial-gradient(620px 260px at 50% 0%,rgba(116,79,255,.12),transparent 72%);
}
.membership-centre-hero h1{margin:7px 0;color:#fff;font-size:clamp(34px,5vw,54px)}
.membership-centre-hero p{max-width:680px;color:#93a2b7;line-height:1.6}
.membership-centre{display:grid;gap:18px;max-width:1050px;margin:0 auto}
.membership-current-card{
  display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:22px;align-items:stretch;
  padding:25px;border:1px solid rgba(120,143,184,.18);border-radius:21px;
  background:linear-gradient(145deg,rgba(17,28,57,.96),rgba(20,37,70,.92));
  box-shadow:0 18px 50px rgba(5,10,28,.18);
}
.membership-current-card.founding{
  border-color:rgba(255,188,72,.30);
  background:
    radial-gradient(440px 190px at 100% 0%,rgba(255,174,59,.10),transparent 70%),
    linear-gradient(145deg,rgba(33,26,61,.97),rgba(30,39,70,.94));
}
.membership-current-card.plus{border-color:rgba(112,103,255,.30)}
.membership-current-main h2{margin:11px 0 7px;color:#fff;font-size:28px}
.membership-current-main p{max-width:650px;margin:0;color:#98a6b9;font-size:11px;line-height:1.65}
.membership-plan-pill{
  display:inline-flex;padding:6px 10px;border-radius:999px;font-size:8px;font-weight:900;letter-spacing:.09em;
}
.membership-plan-pill.free{color:#a9ddff;background:rgba(54,151,217,.11)}
.membership-plan-pill.founding{color:#ffd579;background:rgba(218,139,40,.13)}
.membership-plan-pill.plus{color:#c9c1ff;background:rgba(112,89,238,.14)}
.membership-status-row{
  display:flex;align-items:center;justify-content:space-between;max-width:420px;margin-top:20px;
  padding-top:14px;border-top:1px solid rgba(255,255,255,.07);font-size:9px;
}
.membership-status-row span{color:#8796aa}
.membership-status-row span i{
  display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:#55d5a6;
}
.membership-status-row strong{text-transform:capitalize;color:#bfead9}
.membership-highlight{
  display:grid;place-items:center;align-content:center;min-height:155px;padding:18px;text-align:center;
  border-radius:16px;border:1px solid rgba(255,255,255,.08);background:rgba(7,15,34,.36);
}
.membership-highlight span{color:#8593a8;font-size:8px;font-weight:900;letter-spacing:.08em}
.membership-highlight strong{margin:7px 0;color:#fff;font-size:38px;line-height:1}
.membership-highlight small{color:#8796aa;font-size:8px}
.membership-highlight.founder{border-color:rgba(255,192,76,.22);background:rgba(141,83,27,.10)}
.membership-highlight.founder strong{color:#ffd16d}
.membership-highlight.plus strong{color:#c7bdff}
.membership-highlight.free strong{color:#85d7ff}
.membership-feature-card,.membership-founder-card,.membership-founder-thanks{
  padding:23px;border:1px solid rgba(120,143,184,.15);border-radius:19px;background:rgba(13,24,50,.72);
}
.membership-section-heading{display:flex;justify-content:space-between;gap:16px;align-items:end;margin-bottom:17px}
.membership-section-heading h2,.membership-founder-card h2,.membership-founder-thanks h2{margin:5px 0;color:#fff;font-size:20px}
.membership-section-heading a{color:#91cfff;font-size:9px;text-decoration:none}
.membership-feature-table{overflow:hidden;border:1px solid rgba(255,255,255,.07);border-radius:13px}
.membership-feature-head,.membership-feature-row{
  display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:16px;padding:11px 14px;
}
.membership-feature-head{background:rgba(255,255,255,.035);color:#74849b;font-size:8px;font-weight:900;letter-spacing:.08em}
.membership-feature-row{border-top:1px solid rgba(255,255,255,.055);color:#aab5c5;font-size:9px}
.membership-feature-row strong{color:#8fe0c3;font-weight:800}
.membership-feature-row strong.locked{color:#9a9daf}
.membership-founder-card{
  display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);gap:18px;
  border-color:rgba(255,187,72,.20);
  background:radial-gradient(380px 180px at 100% 0%,rgba(255,173,54,.08),transparent 70%),rgba(24,26,55,.76);
}
.membership-founder-card p,.membership-founder-thanks p,.membership-plus-note p{margin:4px 0;color:#94a2b5;font-size:10px;line-height:1.6}
.membership-check-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px}
.membership-check-grid span{display:flex;align-items:center;gap:6px;color:#909caf;font-size:8px}
.membership-check-grid i{
  display:grid;place-items:center;width:18px;height:18px;border-radius:50%;font-style:normal;
  background:rgba(120,101,218,.12);color:#b8adff;
}
.membership-check-grid span.complete{color:#98dfc5}
.membership-check-grid span.complete i{background:rgba(49,188,138,.12);color:#72dcb7}
.membership-actions{grid-column:1/-1;display:flex;gap:9px;flex-wrap:wrap}
.membership-founder-thanks{display:flex;align-items:center;gap:18px;border-color:rgba(255,190,75,.20)}
.membership-founder-mark{
  display:grid;place-items:center;flex:0 0 58px;width:58px;height:58px;border-radius:17px;
  color:#ffd16b;font-size:25px;background:rgba(215,139,41,.12);border:1px solid rgba(255,190,75,.18);
}
.membership-message{
  padding:12px 14px;border:1px solid rgba(84,194,158,.18);border-radius:12px;
  color:#a9e6d2;background:rgba(42,150,113,.07);font-size:9px;
}
.membership-empty{max-width:760px;margin:0 auto;padding:28px}
.membership-empty h2{color:#fff}
.membership-empty p{color:#96a4b7}
.membership-account-link{
  display:flex;justify-content:space-between;gap:18px;align-items:center;
  margin-top:18px;padding:18px 20px;border:1px solid rgba(111,151,224,.18);border-radius:16px;
  background:linear-gradient(135deg,rgba(50,104,177,.09),rgba(100,68,176,.08));
}
.membership-account-link h3{margin:4px 0;color:#fff;font-size:15px}
.membership-account-link p{margin:0;color:#8f9eb2;font-size:9px}
@media(max-width:760px){
  .membership-current-card{grid-template-columns:1fr}
  .membership-highlight{min-height:120px}
  .membership-founder-card{grid-template-columns:1fr}
  .membership-actions{grid-column:auto}
}
@media(max-width:520px){
  .membership-feature-head,.membership-feature-row{grid-template-columns:1fr auto}
  .membership-check-grid{grid-template-columns:1fr}
  .membership-account-link{display:grid}
}



/* v0.36.1.8.1 - Membership Centre readability / font-size patch */

/* Hero */
.membership-centre-hero h1{
  font-size:clamp(38px,5vw,58px)!important;
  line-height:1.05!important;
}
.membership-centre-hero p{
  font-size:15px!important;
  line-height:1.65!important;
}

/* Current membership card */
.membership-plan-pill{
  font-size:11px!important;
  padding:7px 11px!important;
}
.membership-current-main h2{
  font-size:32px!important;
  line-height:1.15!important;
}
.membership-current-main p{
  font-size:14px!important;
  line-height:1.65!important;
}
.membership-status-row{
  font-size:12px!important;
}
.membership-highlight span{
  font-size:10px!important;
}
.membership-highlight strong{
  font-size:44px!important;
}
.membership-highlight small{
  font-size:10px!important;
}

/* Section headings */
.membership-section-heading h2,
.membership-founder-card h2,
.membership-founder-thanks h2,
.membership-plus-note h2{
  font-size:24px!important;
  line-height:1.2!important;
}
.membership-section-heading a{
  font-size:12px!important;
}
.membership-centre .privacy-kicker{
  font-size:10px!important;
  letter-spacing:.11em!important;
}

/* Access table */
.membership-feature-head{
  font-size:10px!important;
}
.membership-feature-row{
  font-size:12px!important;
  line-height:1.45!important;
  padding:14px 16px!important;
}
.membership-feature-row>span{
  font-size:12px!important;
}
.membership-feature-row strong{
  font-size:12px!important;
}
.membership-feature-head{
  padding:12px 16px!important;
}

/* Founder eligibility / explanatory text */
.membership-founder-card p,
.membership-founder-thanks p,
.membership-plus-note p{
  font-size:12px!important;
  line-height:1.65!important;
}
.membership-check-grid span{
  font-size:11px!important;
}
.membership-check-grid i{
  width:22px!important;
  height:22px!important;
  font-size:10px!important;
}
.membership-message{
  font-size:12px!important;
  line-height:1.5!important;
}
.membership-empty p{
  font-size:14px!important;
  line-height:1.6!important;
}
.membership-account-link h3{
  font-size:18px!important;
}
.membership-account-link p{
  font-size:11px!important;
  line-height:1.55!important;
}

/* Improve visual density on desktop without making the page feel oversized */
@media(min-width:900px){
  .membership-current-card{
    padding:30px!important;
  }
  .membership-feature-card,
  .membership-founder-card,
  .membership-founder-thanks{
    padding:27px!important;
  }
  .membership-feature-head,
  .membership-feature-row{
    grid-template-columns:minmax(0,1fr) 220px!important;
  }
}

/* Mobile readability */
@media(max-width:760px){
  .membership-current-main h2{
    font-size:28px!important;
  }
  .membership-feature-row{
    font-size:12px!important;
  }
  .membership-highlight strong{
    font-size:38px!important;
  }
}

/* v0.36.1.8.3.1 conversation corrective */
.conversation-history-card{max-width:900px;margin:30px auto;padding:28px}.conversation-history-card h1{font-size:30px}.conversation-history-card>p{color:#9aa8bc;font-size:14px;line-height:1.6}.conversation-history-lock{margin:18px 0;padding:15px;border:1px solid rgba(154,164,186,.18);border-radius:12px}.conversation-history-lock p{margin:4px 0 0;color:#8997aa}


/* v0.36.1.8.4 - Notification chat lifecycle routing */
.notification-chat-resolver{
  min-height:70vh;
  display:grid;
  align-items:center;
}
.notification-chat-resolver-card{
  max-width:650px;
  margin:50px auto;
  padding:30px;
  text-align:center;
  border-color:rgba(104,147,223,.18)!important;
  background:
    radial-gradient(360px 160px at 50% 0%,rgba(113,82,223,.10),transparent 72%),
    rgba(16,28,56,.88)!important;
}
.notification-chat-resolver-card h1{
  margin:8px 0 10px;
  color:#fff;
  font-size:25px;
}
.notification-chat-resolver-card p{
  margin:0;
  color:#96a4b7;
  font-size:12px;
  line-height:1.6;
}


/* v0.36.1.8.5 - Founding Member Discovery */
.founder-discovery-strip{display:flex;align-items:center;justify-content:space-between;gap:16px;max-width:760px;margin:18px auto 0;padding:11px 14px;border:1px solid rgba(255,190,79,.27);border-radius:14px;background:rgba(33,29,61,.72)}
.founder-discovery-strip-copy{display:flex;align-items:center;gap:10px}.founder-discovery-spark{display:grid;place-items:center;width:34px;height:34px;border-radius:11px;color:#ffd36d;background:rgba(211,134,37,.14)}
.founder-discovery-strip-copy div{display:grid;gap:2px}.founder-discovery-strip-copy strong{color:#fff;font-size:13px}.founder-discovery-strip-copy span{color:#9aa8bb;font-size:11px}.founder-discovery-strip-copy span b{color:#ffd16b}
.founder-discovery-strip-link{white-space:nowrap;color:#ffd577;font-size:11px;font-weight:850;text-decoration:none}
.founder-discovery-overlay{position:fixed;inset:0;z-index:10000;display:grid;place-items:center;padding:20px;background:rgba(3,7,20,.70);backdrop-filter:blur(10px)}
.founder-discovery-modal{position:relative;width:min(560px,100%);padding:30px;border:1px solid rgba(255,187,74,.30);border-radius:24px;background:radial-gradient(420px 220px at 100% 0%,rgba(238,116,72,.11),transparent 72%),radial-gradient(380px 210px at 0% 0%,rgba(122,82,255,.15),transparent 72%),linear-gradient(145deg,#17213f,#251845);box-shadow:0 30px 90px rgba(0,0,0,.42)}
.founder-discovery-close{position:absolute;top:15px;right:15px;width:34px;height:34px;border:1px solid rgba(255,255,255,.10);border-radius:50%;color:#b8c2d1;background:rgba(255,255,255,.04);cursor:pointer;font-size:20px}
.founder-discovery-icon{display:grid;place-items:center;width:56px;height:56px;margin-bottom:16px;border-radius:17px;color:#ffd16b;background:rgba(211,134,37,.14);font-size:25px}
.founder-discovery-modal h2{margin:8px 0 10px;color:#fff;font-size:clamp(26px,4vw,36px);line-height:1.12}.founder-discovery-modal>p{margin:0;color:#a3afc0;font-size:13px;line-height:1.65}
.founder-discovery-count{display:flex;align-items:end;gap:10px;margin:20px 0;padding:16px 17px;border:1px solid rgba(255,190,79,.18);border-radius:15px;background:rgba(123,78,37,.10)}
.founder-discovery-count strong{color:#ffd16b;font-size:34px}.founder-discovery-count span{color:#d7cbb3;font-size:11px}.founder-discovery-benefits{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px}.founder-discovery-benefits span{color:#b8c3d1;font-size:11px}
.founder-discovery-actions{display:flex;gap:9px;flex-wrap:wrap;margin:22px 0 14px}.founder-discovery-modal>small{display:block;color:#76869b;font-size:9px;line-height:1.55}
@media(max-width:620px){.founder-discovery-strip{align-items:flex-start}.founder-discovery-benefits{grid-template-columns:1fr}.founder-discovery-actions{display:grid}.founder-discovery-actions .btn{width:100%}}



/* v0.36.1.8.5.1 - Founding Programme hero banner layout */
.founder-discovery-strip{
  width:min(1120px,calc(100% - 40px))!important;
  max-width:1120px!important;
  margin:22px auto 8px!important;
  padding:20px 22px!important;
  display:grid!important;
  grid-template-columns:minmax(0,1fr) auto!important;
  align-items:center!important;
  gap:22px!important;
  border:1px solid rgba(255,190,79,.28)!important;
  border-radius:20px!important;
  background:
    radial-gradient(420px 180px at 0% 0%,rgba(255,183,67,.12),transparent 72%),
    radial-gradient(420px 180px at 100% 0%,rgba(120,82,255,.13),transparent 72%),
    linear-gradient(135deg,rgba(28,35,72,.98),rgba(37,26,69,.96))!important;
  box-shadow:0 18px 48px rgba(4,8,24,.20)!important;
}

.founder-discovery-strip-copy{
  display:grid!important;
  grid-template-columns:54px minmax(0,1fr)!important;
  gap:15px!important;
  align-items:center!important;
}

.founder-discovery-spark{
  width:54px!important;
  height:54px!important;
  border-radius:16px!important;
  font-size:24px!important;
  color:#ffd36d!important;
  background:linear-gradient(145deg,rgba(219,139,41,.20),rgba(126,78,189,.20))!important;
  border:1px solid rgba(255,190,79,.24)!important;
  box-shadow:inset 0 0 24px rgba(255,186,72,.04)!important;
}

.founder-discovery-strip-copy div{
  display:grid!important;
  gap:5px!important;
}

.founder-discovery-strip-copy strong{
  color:#fff!important;
  font-size:18px!important;
  line-height:1.15!important;
}

.founder-discovery-strip-copy strong::before{
  content:"FOUNDING PROGRAMME";
  display:block;
  margin-bottom:5px;
  color:#8fd4ff;
  font-size:9px;
  font-weight:900;
  letter-spacing:.13em;
}

.founder-discovery-strip-copy span{
  color:#aeb9c9!important;
  font-size:12px!important;
  line-height:1.45!important;
}

.founder-discovery-strip-copy span::before{
  content:"Become one of the first 20 AutoFace members · ";
  color:#dce3ed;
}

.founder-discovery-strip-copy span b{
  display:inline-flex!important;
  align-items:center!important;
  padding:4px 7px!important;
  margin-right:2px!important;
  border-radius:999px!important;
  color:#ffd36d!important;
  background:rgba(219,139,41,.12)!important;
  font-size:11px!important;
}

.founder-discovery-strip-link{
  display:inline-flex!important;
  align-items:center!important;
  justify-content:center!important;
  min-height:46px!important;
  min-width:178px!important;
  padding:0 18px!important;
  border-radius:13px!important;
  color:#fff!important;
  background:linear-gradient(135deg,#7c5cff,#45a8ff)!important;
  box-shadow:0 12px 28px rgba(68,113,242,.20)!important;
  font-size:12px!important;
  font-weight:900!important;
  text-decoration:none!important;
  transition:transform .18s ease,box-shadow .18s ease!important;
}

.founder-discovery-strip-link:hover{
  transform:translateY(-1px)!important;
  box-shadow:0 15px 34px rgba(68,113,242,.28)!important;
}

/* Keep the modal visually separate from the hero banner. */
.founder-discovery-modal .founder-discovery-strip-copy span::before{
  content:none!important;
}

@media(max-width:760px){
  .founder-discovery-strip{
    width:min(100% - 24px,1120px)!important;
    grid-template-columns:1fr!important;
    gap:16px!important;
    padding:18px!important;
  }
  .founder-discovery-strip-copy{
    grid-template-columns:46px minmax(0,1fr)!important;
    gap:12px!important;
  }
  .founder-discovery-spark{
    width:46px!important;
    height:46px!important;
    font-size:20px!important;
  }
  .founder-discovery-strip-copy strong{
    font-size:16px!important;
  }
  .founder-discovery-strip-copy span{
    font-size:11px!important;
  }
  .founder-discovery-strip-copy span::before{
    display:block;
    margin-bottom:4px;
  }
  .founder-discovery-strip-link{
    width:100%!important;
    min-width:0!important;
  }
}



/* v0.36.1.8.5.2 - Founding Programme banner corrective layout */

/* Disable the old strip layout completely. */
.founder-discovery-strip{
  display:none!important;
}

.founder-discovery-banner{
  width:min(1120px,calc(100% - 40px));
  margin:24px auto 12px;
  padding:24px 26px;
  display:grid;
  grid-template-columns:64px minmax(0,1fr) auto;
  gap:20px;
  align-items:center;
  border:1px solid rgba(255,190,79,.28);
  border-radius:22px;
  background:
    radial-gradient(460px 190px at 0% 0%,rgba(255,181,64,.11),transparent 72%),
    radial-gradient(440px 190px at 100% 0%,rgba(115,81,255,.14),transparent 72%),
    linear-gradient(135deg,rgba(29,38,77,.98),rgba(39,27,72,.97));
  box-shadow:0 20px 52px rgba(4,8,24,.20);
}

.founder-discovery-banner-icon{
  display:grid;
  place-items:center;
  width:64px;
  height:64px;
  border-radius:18px;
  color:#ffd36f;
  background:linear-gradient(145deg,rgba(219,139,41,.20),rgba(127,79,188,.18));
  border:1px solid rgba(255,190,79,.24);
  font-size:28px;
  box-shadow:inset 0 0 26px rgba(255,190,79,.04);
}

.founder-discovery-banner-content{
  min-width:0;
}

.founder-discovery-banner-kicker{
  display:block;
  margin-bottom:5px;
  color:#86d4ff;
  font-size:10px;
  font-weight:900;
  letter-spacing:.14em;
}

.founder-discovery-banner h2{
  margin:0;
  color:#fff;
  font-size:clamp(20px,2.2vw,28px);
  line-height:1.15;
}

.founder-discovery-banner p{
  max-width:690px;
  margin:7px 0 13px;
  color:#a8b4c5;
  font-size:12px;
  line-height:1.55;
}

.founder-discovery-banner-status{
  display:inline-flex;
  align-items:center;
  gap:8px;
  padding:7px 10px;
  border:1px solid rgba(255,190,79,.18);
  border-radius:999px;
  background:rgba(177,103,29,.10);
}

.founder-discovery-banner-status strong{
  color:#ffd16b;
  font-size:12px;
}

.founder-discovery-banner-status span{
  color:#d3c7ae;
  font-size:10px;
}

.founder-discovery-banner-action{
  display:flex;
  align-items:center;
  justify-content:flex-end;
}

.founder-discovery-banner-action .btn{
  min-width:190px;
  min-height:48px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:0 20px;
  border-radius:13px;
  font-size:12px;
  font-weight:900;
  white-space:nowrap;
}

/* Preserve the popup from v0.36.1.8.5. */
.founder-discovery-overlay{
  position:fixed;
  inset:0;
  z-index:10000;
  display:grid;
  place-items:center;
  padding:20px;
  background:rgba(3,7,20,.70);
  backdrop-filter:blur(10px);
}

.founder-discovery-modal{
  position:relative;
  width:min(560px,100%);
  padding:30px;
  border:1px solid rgba(255,187,74,.30);
  border-radius:24px;
  background:
    radial-gradient(420px 220px at 100% 0%,rgba(238,116,72,.11),transparent 72%),
    radial-gradient(380px 210px at 0% 0%,rgba(122,82,255,.15),transparent 72%),
    linear-gradient(145deg,#17213f,#251845);
  box-shadow:0 30px 90px rgba(0,0,0,.42);
}

.founder-discovery-close{
  position:absolute;
  top:15px;
  right:15px;
  width:34px;
  height:34px;
  border:1px solid rgba(255,255,255,.10);
  border-radius:50%;
  color:#b8c2d1;
  background:rgba(255,255,255,.04);
  cursor:pointer;
  font-size:20px;
}

.founder-discovery-icon{
  display:grid;
  place-items:center;
  width:56px;
  height:56px;
  margin-bottom:16px;
  border-radius:17px;
  color:#ffd16b;
  background:rgba(211,134,37,.14);
  font-size:25px;
}

.founder-discovery-modal h2{
  margin:8px 0 10px;
  color:#fff;
  font-size:clamp(26px,4vw,36px);
  line-height:1.12;
}

.founder-discovery-modal>p{
  margin:0;
  color:#a3afc0;
  font-size:13px;
  line-height:1.65;
}

.founder-discovery-count{
  display:flex;
  align-items:end;
  gap:10px;
  margin:20px 0;
  padding:16px 17px;
  border:1px solid rgba(255,190,79,.18);
  border-radius:15px;
  background:rgba(123,78,37,.10);
}

.founder-discovery-count strong{
  color:#ffd16b;
  font-size:34px;
}

.founder-discovery-count span{
  color:#d7cbb3;
  font-size:11px;
}

.founder-discovery-benefits{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px 14px;
}

.founder-discovery-benefits span{
  color:#b8c3d1;
  font-size:11px;
}

.founder-discovery-actions{
  display:flex;
  gap:9px;
  flex-wrap:wrap;
  margin:22px 0 14px;
}

.founder-discovery-modal>small{
  display:block;
  color:#76869b;
  font-size:9px;
  line-height:1.55;
}

@media(max-width:760px){
  .founder-discovery-banner{
    width:min(100% - 24px,1120px);
    grid-template-columns:52px minmax(0,1fr);
    padding:19px;
    gap:14px;
  }

  .founder-discovery-banner-icon{
    width:52px;
    height:52px;
    border-radius:15px;
    font-size:22px;
  }

  .founder-discovery-banner-action{
    grid-column:1/-1;
  }

  .founder-discovery-banner-action .btn{
    width:100%;
  }
}

@media(max-width:520px){
  .founder-discovery-banner{
    grid-template-columns:1fr;
  }

  .founder-discovery-banner-icon{
    width:48px;
    height:48px;
  }

  .founder-discovery-benefits{
    grid-template-columns:1fr;
  }

  .founder-discovery-actions{
    display:grid;
  }

  .founder-discovery-actions .btn{
    width:100%;
  }
}

