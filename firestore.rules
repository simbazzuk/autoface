rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if signedInAs(uid);
    }

    // v0.4 profile foundation. Profiles remain owner-readable only until the
    // explicit matching/discovery permissions model is introduced.
    match /profiles/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','firstName','surname','preferredName','age','generalLocation','heightCm','occupation',
          'professionArea','employmentType','careerImportance',
          'education','educationLevel','educationField','educationInstitution',
          'caste','sikhAppearance','sikhPractice','diet','hobbies',
          'relationshipIntent','aboutMe','visibility','showAge',
          'showLocation','showOccupation','createdAt','updatedAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 50
        && request.resource.data.surname is string
        && request.resource.data.surname.size() > 0
        && request.resource.data.surname.size() <= 60
        && request.resource.data.preferredName is string
        && request.resource.data.preferredName.size() <= 50
        && request.resource.data.age is int
        && request.resource.data.age >= 18
        && request.resource.data.age <= 100
        && request.resource.data.generalLocation is string
        && request.resource.data.generalLocation.size() > 0
        && request.resource.data.generalLocation.size() <= 80
        && (request.resource.data.heightCm == null || (request.resource.data.heightCm is int && request.resource.data.heightCm >= 120 && request.resource.data.heightCm <= 230))
        && request.resource.data.occupation is string
        && request.resource.data.occupation.size() <= 100
        && request.resource.data.education is string
        && request.resource.data.education.size() <= 120
        && request.resource.data.professionArea in ['','healthcare','technology','finance','engineering','education','legal','business','public_sector','creative','skilled_trades','other']
        && request.resource.data.employmentType in ['','employed','self_employed','business_owner','student','other']
        && request.resource.data.careerImportance in ['','low','moderate','important','very_important']
        && request.resource.data.educationLevel in ['school_college','undergraduate','postgraduate','doctorate','professional_qualification','other']
        && request.resource.data.educationField is string
        && request.resource.data.educationField.size() <= 120
        && request.resource.data.educationInstitution is string
        && request.resource.data.educationInstitution.size() <= 160
        && request.resource.data.caste is string
        && request.resource.data.caste.size() <= 80
        && request.resource.data.sikhAppearance in ['prefer_not_to_say','turbaned','clean_shaven','not_applicable']
        && request.resource.data.sikhPractice in ['prefer_not_to_say','amritdhari','practising','moderate','cultural_not_religious']
        && request.resource.data.diet in ['prefer_not_to_say','vegetarian','non_vegetarian','vegan']
        && request.resource.data.hobbies is list
        && request.resource.data.hobbies.size() <= 20
        && request.resource.data.relationshipIntent in ['marriage','long_term_relationship','serious_relationship']
        && request.resource.data.aboutMe is string
        && request.resource.data.aboutMe.size() > 0
        && request.resource.data.aboutMe.size() <= 600
        && request.resource.data.visibility in ['private','future_matches']
        && request.resource.data.showAge is bool
        && request.resource.data.showLocation is bool
        && request.resource.data.showOccupation is bool;
      allow delete: if signedInAs(uid);
    }



    // v0.5 Atlas Relationship Profile. These answers are private and owner-only.
    // Matching/discovery is intentionally not enabled in this release.
    match /relationshipProfiles/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid','familyOrientation','communicationDirectness','socialEnergy',
          'careerPriority','routineVsAdventure','relocationFlexibility',
          'sharedInterestsImportance','independencePreference','relationshipPace',
          'idealWeekend','whatMattersMost','nonNegotiables',
          'weekendPreferences','relationshipPriorities','nonNegotiablePreferences','relationshipContext',
          'consentForCompatibility','consentForAiDiscovery','createdAt','updatedAt'
        ])
        && request.resource.data.familyOrientation is int
        && request.resource.data.familyOrientation >= 1 && request.resource.data.familyOrientation <= 5
        && request.resource.data.communicationDirectness is int
        && request.resource.data.communicationDirectness >= 1 && request.resource.data.communicationDirectness <= 5
        && request.resource.data.socialEnergy is int
        && request.resource.data.socialEnergy >= 1 && request.resource.data.socialEnergy <= 5
        && request.resource.data.careerPriority is int
        && request.resource.data.careerPriority >= 1 && request.resource.data.careerPriority <= 5
        && request.resource.data.routineVsAdventure is int
        && request.resource.data.routineVsAdventure >= 1 && request.resource.data.routineVsAdventure <= 5
        && request.resource.data.relocationFlexibility is int
        && request.resource.data.relocationFlexibility >= 1 && request.resource.data.relocationFlexibility <= 5
        && request.resource.data.sharedInterestsImportance is int
        && request.resource.data.sharedInterestsImportance >= 1 && request.resource.data.sharedInterestsImportance <= 5
        && request.resource.data.independencePreference is int
        && request.resource.data.independencePreference >= 1 && request.resource.data.independencePreference <= 5
        && request.resource.data.relationshipPace in ['slow','balanced','intentional']
        && request.resource.data.idealWeekend is string
        && request.resource.data.idealWeekend.size() > 0 && request.resource.data.idealWeekend.size() <= 400
        && request.resource.data.whatMattersMost is string
        && request.resource.data.whatMattersMost.size() > 0 && request.resource.data.whatMattersMost.size() <= 500
        && request.resource.data.nonNegotiables is string
        && request.resource.data.nonNegotiables.size() > 0 && request.resource.data.nonNegotiables.size() <= 400
        && request.resource.data.weekendPreferences is list
        && request.resource.data.weekendPreferences.size() >= 1 && request.resource.data.weekendPreferences.size() <= 4
        && request.resource.data.relationshipPriorities is list
        && request.resource.data.relationshipPriorities.size() >= 1 && request.resource.data.relationshipPriorities.size() <= 5
        && request.resource.data.nonNegotiablePreferences is list
        && request.resource.data.nonNegotiablePreferences.size() >= 1 && request.resource.data.nonNegotiablePreferences.size() <= 5
        && request.resource.data.relationshipContext is string
        && request.resource.data.relationshipContext.size() <= 350
        && request.resource.data.consentForCompatibility is bool
        && request.resource.data.consentForAiDiscovery is bool;
      allow delete: if signedInAs(uid);
    }

        // Verification evidence is readable by the account owner but can only be
    // written by trusted server-side code (Firebase Admin bypasses rules).
    match /identity/{uid} {
      allow read: if signedInAs(uid);
      allow write: if false;
    }

    match /authenticity/{uid} {
      allow read: if signedInAs(uid);
      allow write: if false;
    }

    match /verificationSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // v0.28 profile-photo metadata is server-owned. Photo bytes live in
    // Firebase Storage and are streamed through authenticated server APIs.
    match /profilePhotos/{uid} {
      allow read, write: if false;
    }

    // v0.9 photo-verification sessions remain server-owned. The account owner may
    // read only their own session state; trusted server code writes results.
    match /photoVerificationSessions/{sessionId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow write: if false;
    }


    // v0.7.1 demo harness markers are server-owned and are only exposed
    // through the safe Discovery API projection.
    match /demoProfiles/{uid} {
      allow read, write: if false;
    }

    // v0.7 discovery decisions and matches are server-owned. Clients use authenticated API routes.
    match /interests/{interestId} {
      allow read, write: if false;
    }

    match /matches/{matchId} {
      allow read, write: if false;
    }


    // v0.8 Safe Messaging. Conversations, messages, blocks and reports are
    // server-owned. Authenticated clients use API routes that enforce mutual-match
    // membership and block/unmatch state before any message is returned or written.
    match /conversations/{matchId} {
      allow read, write: if false;
      match /messages/{messageId} {
        allow read, write: if false;
      }
    }

    match /blocks/{blockId} {
      allow read, write: if false;
    }

    match /reports/{reportId} {
      allow read, write: if false;
    }

    // v0.10 connection journey is server-owned. Clients use authenticated API
    // routes so only mutual-match participants can read or update their own stage.
    match /connections/{matchId} {
      allow read, write: if false;
    }
    // v0.11 notifications are server-owned; authenticated clients use API routes.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    // v0.12 discovery preferences are server-owned through authenticated API routes.
    match /discoveryPreferences/{uid} {
      allow read, write: if false;
    }





    // v0.26 notification preferences are server-owned. Account holders manage
    // them through authenticated account APIs; clients cannot write them directly.
    match /notificationPreferences/{uid} {
      allow read, write: if false;
    }

    // v0.18 controlled-beta invitations and access records are server-owned.
    match /betaInvites/{code} {
      allow read, write: if false;
    }

    match /betaAccess/{uid} {
      allow read, write: if false;
    }

    // v0.17 Beta Operations reads server-owned aggregates through an admin API.
    // Feedback status changes and operational audit events are also server-owned.

    // v0.16 support assistant is stateless and does not create a chat-history collection.
    // Support requests use authenticated server APIs and curated product guidance.

    // v0.15 beta feedback is accepted only through authenticated server APIs.
    match /betaFeedback/{feedbackId} {
      allow read, write: if false;
    }

    // v0.14 moderation and operator audit records are server-owned.
    match /accountModeration/{uid} {
      allow read, write: if false;
    }

    match /adminAuditEvents/{eventId} {
      allow read, write: if false;
    }

    // v0.13 account privacy, export and deletion are handled by trusted server APIs.
    // No additional client-writeable collections are introduced.

  }
}
