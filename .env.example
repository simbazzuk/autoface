# Client-side Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# v0.3 server-side Firebase Admin configuration.
# Use credentials from a service account for your AutoFace development project.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# demo = safe local integration simulator. provider = production adapter (not yet configured).
AUTOFACE_VERIFICATION_MODE=demo

# v0.7.1 development test harness. Optional; defaults to AutoFaceDemo!731.
# Only used by `npm run seed:demo` and never by the web application.
AUTOFACE_DEMO_PASSWORD=

# Optional Atlas AI explanations (server-side only)
ATLAS_AI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional override. Default: https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_BASE_URL=


# v0.14 server-side safety operator allowlist (comma-separated)
AUTOFACE_ADMIN_EMAILS=

# v0.18 controlled beta: set true to require an admin-created invite code at registration
AUTOFACE_BETA_INVITE_REQUIRED=false

# v0.35.0 AWS Rekognition Face Verification
# Server-side credentials: use a least-privilege IAM identity. Never expose these as NEXT_PUBLIC_.
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Browser liveness stream only. Cognito Identity Pool does NOT replace Firebase Authentication.
NEXT_PUBLIC_AWS_REGION=eu-west-1
NEXT_PUBLIC_AWS_COGNITO_IDENTITY_POOL_ID=

# Tune only after testing genuine and deliberate mismatch cases.
AUTOFACE_FACE_LIVENESS_THRESHOLD=90
AUTOFACE_FACE_MATCH_THRESHOLD=90
